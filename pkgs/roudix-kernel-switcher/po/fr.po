#: roudix-kernel-switcher.py
msgid ""
"linux-zen — mainline nixpkgs kernel, cached on cache.nixos.org, independent "
"of the xddxdd overlay"
msgstr ""
"linux-zen — noyau nixpkgs mainline, en cache sur cache.nixos.org, "
"indépendant de l'overlay xddxdd"

#: roudix-kernel-switcher.py
msgid "linux LTS — nixpkgs default kernel, cached on cache.nixos.org"
msgstr "linux LTS — noyau par défaut de nixpkgs, en cache sur cache.nixos.org"

#: roudix-kernel-switcher.py
msgid "linux latest — newest mainline stable, cached on cache.nixos.org"
msgstr ""
"linux latest — dernière version stable mainline, en cache sur cache.nixos.org"

#: roudix-kernel-switcher.py
msgid "linux_testing — mainline RC/testing kernel, cached on cache.nixos.org"
msgstr "linux_testing — noyau mainline RC/test, en cache sur cache.nixos.org"

#: roudix-kernel-switcher.py
msgid "XanMod LTS — nixpkgs, performance governor + lazy preemption + BBRv3"
msgstr ""
"XanMod LTS — nixpkgs, gouverneur performance + préemption paresseuse + BBRv3"

#: roudix-kernel-switcher.py
msgid "XanMod main branch — nixpkgs, newest XanMod"
msgstr "Branche principale XanMod — nixpkgs, le XanMod le plus récent"

#: roudix-kernel-switcher.py
msgid "Standard latest"
msgstr "Standard, dernière version"

#: roudix-kernel-switcher.py
msgid "x86_64-v3  —  recommended for modern CPUs"
msgstr "x86_64-v3  —  recommandé pour les CPU récents"

