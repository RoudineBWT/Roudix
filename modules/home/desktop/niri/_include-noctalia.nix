## _include-noctalia.nix — appends `include optional=true "noctalia.kdl"`
## to the end of the config.kdl generated by niri-flake
## (programs.niri.settings), so the theme Noctalia regenerates live
## (matugen) applies on top. Technique from github.com/Ly-sec/nixos
## (desktops/niri/home/noctalia-include.nix): `finalConfigFile` is the
## store path of the rendered KDL (readonly; it replaced the old string
## `finalConfig` in epireyn/niri-flake to avoid IFD). We `cat` it with the
## include text at build time (no readFile = no IFD), then revalidate with
## `niri validate` before overwriting `xdg.configFile.niri-config`.
{ config, pkgs, lib, ... }:
let
  niriPkg = config.programs.niri.package;
  baseConfig = config.programs.niri.finalConfigFile;
  extra = ''

    include optional=true "noctalia.kdl"
  '';
in
{
  xdg.configFile.niri-config = lib.mkForce {
    target = "niri/config.kdl";
    force = true;
    source = pkgs.runCommand "config.kdl" {
      inherit extra;
      passAsFile = [ "extra" ];
      buildInputs = [ niriPkg ];
    } ''
      cat ${baseConfig} $extraPath > config.kdl
      niri validate -c config.kdl
      cp config.kdl $out
    '';
  };
}
