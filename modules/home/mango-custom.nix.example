{ lib, ... }:
{
  # ── Personal MangoWC overrides ──────────────────────────────────────────
  # Copy this file to mango-custom.nix (without .example) next to local.nix
  # — auto-imported (see `imports` in local.nix), gitignored like it.
  #
  # ⚠ Different from niri/umbriel: MangoWC has no mature typed Nix module
  # (even looking at real multi-compositor configs, nobody uses one in
  # practice — just raw text generated via xdg.configFile). So there's NO
  # key-by-key merging possible here: the only override point is the
  # `user.conf` file, sourced LAST in config.conf (see mangowc.nix) —
  # whatever you put here wins over everything else, in the order mango
  # reads the file top to bottom.
  #
  # Since this replaces the whole file, no need for partial lib.mkForce:
  # put all your personal content in one go.

  xdg.configFile."mango/user.conf".text = lib.mkForce ''
    # Your personal binds/rules, in MangoWC format (see the repo's
    # cfg/*.conf for syntax: bind=MOD,key,action,argument / windowrule=...).

    # Example: remap a bind
    # bind=SUPER,T,spawn,alacritty

    # Example: an extra window rule
    # windowrule=tags:3,appid:^mpv$
  '';
}
