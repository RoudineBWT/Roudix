#: roudix-scheduler.py
msgid "Auto"
msgstr "Auto"

#: roudix-scheduler.py
msgid "Gaming"
msgstr "Jogos"

#. TRANSLATORS: Profile name written as one word in scx_loader (shown in a dropdown);
#. translate it as a normal phrase, e.g. "Low latency".
#: roudix-scheduler.py
msgid "LowLatency"
msgstr "Baixa latência"

#. TRANSLATORS: Profile name written as one word in scx_loader (shown in a dropdown);
#. translate it as a normal phrase, e.g. "Power saving".
#: roudix-scheduler.py
msgid "PowerSave"
msgstr "Economia de energia"

#: roudix-scheduler.py
msgid "Server"
msgstr "Servidor"

#: roudix-scheduler.py
msgid "Default kernel scheduler — CFS/EEVDF"
msgstr "Escalonador padrão do kernel — CFS/EEVDF"

#: roudix-scheduler.py
msgid "None"
msgstr "Nenhum"

#: roudix-scheduler.py
msgid ""
"vruntime-based, interactive-first — best all-around (gaming, desktop, heavy "
"load); cache-topology aware"
msgstr ""
"Baseado em vruntime, prioridade ao interativo — o melhor para uso geral "
"(jogos, desktop, carga alta); ciente da topologia de cache"

#: roudix-scheduler.py
msgid ""
"Latency-Aware Virtual Deadline — gaming + interactive; core compaction at "
"low load; autopilot adjusts mode automatically"
msgstr ""
"Latency-Aware Virtual Deadline — jogos + interativo; compactação de núcleos "
"em carga baixa; o piloto automático ajusta o modo sozinho"

#: roudix-scheduler.py
msgid ""
"Fairness-focused, low-latency — good for mixed desktop + compile workloads"
msgstr ""
"Focado em equidade e baixa latência — bom para cargas mistas de desktop + "
"compilação"

#: roudix-scheduler.py
msgid ""
"Pick-2 load balancing, two-level queue — general purpose; good cache locality"
msgstr ""
"Balanceamento de carga Pick-2, fila de dois níveis — uso geral; boa "
"localidade de cache"

#: roudix-scheduler.py
msgid ""
"Multi-domain load balancer — scales well on large/NUMA systems; no per-mode "
"tuning"
msgstr ""
"Balanceador de carga multidomínio — escala bem em sistemas grandes/NUMA; sem "
"ajuste por modo"

#: roudix-scheduler.py
msgid "Userspace Rust scheduler (proof-of-concept) — no per-mode tuning"
msgstr ""
"Escalonador Rust no espaço do usuário (prova de conceito) — sem ajuste por "
"modo"

#: roudix-scheduler.py
msgid ""
"Lightweight locality-first — successor to bpfland, in active development"
msgstr ""
"Leve, prioriza a localidade — sucessor do bpfland, em desenvolvimento ativo"

#: roudix-scheduler.py
msgid "Experimental — in active development; no per-mode tuning"
msgstr "Experimental — em desenvolvimento ativo; sem ajuste por modo"

#: roudix-scheduler.py
msgid ""
"Server/HPC-oriented — reduces OS noise via tick suppression; requires "
"nohz_full kernel param; NOT for desktop/gaming"
msgstr ""
"Voltado a servidores/HPC — reduz o ruído do SO suprimindo o tick; exige o "
"parâmetro de kernel nohz_full; NÃO para desktop/jogos"

#: roudix-scheduler.py
msgid ""
"Layer-based — classify tasks into cgroups and apply a different policy per "
"layer; highly configurable via TOML"
msgstr ""
"Em camadas — classifica as tarefas em cgroups e aplica uma política "
"diferente por camada; altamente configurável via TOML"

#: roudix-scheduler.py
msgid ""
"Profile-driven — simple Gaming/Esports/Battery profiles; in active "
"development"
msgstr ""
"Orientado a perfis — perfis simples Gaming/Esports/Battery; em "
"desenvolvimento ativo"

#: roudix-scheduler.py
msgid ""
"Stress-test / debugging only — amplifies race conditions; NOT for production "
"use"
msgstr ""
"Somente para testes de estresse / depuração — amplifica condições de "
"corrida; NÃO para produção"

#: roudix-scheduler.py
msgid "Experimental cell-division scheduler — in active development"
msgstr "Escalonador experimental de divisão celular — em desenvolvimento ativo"

#: roudix-scheduler.py
msgid "Round-robin FIFO userspace scheduler — educational / proof-of-concept"
msgstr ""
"Escalonador FIFO round-robin no espaço do usuário — educacional / prova de "
"conceito"

#: roudix-scheduler.py
msgid "Experimental fork of rusty using BPF arenas — in active development"
msgstr ""
"Fork experimental do rusty usando arenas BPF — em desenvolvimento ativo"

#: roudix-scheduler.py
msgid ""
"Task-budget driven — every decision derived directly from budget, no Gaming/"
"PowerSave/etc. profiles"
msgstr ""
"Orientado a orçamento de tarefas — cada decisão deriva diretamente do "
"orçamento, sem perfis Gaming/PowerSave/etc."

#: roudix-scheduler.py
msgid ""
"AI-agent-oriented — tuned via scx_forge_agent and a spec.toml optimization "
"loop rather than manual profiles"
msgstr ""
"Voltado a agentes de IA — ajustado via scx_forge_agent e um ciclo de "
"otimização spec.toml em vez de perfis manuais"

#: roudix-scheduler.py
msgid "scx-switch not found in PATH (scx.nix module not loaded?)."
msgstr "scx-switch não encontrado no PATH (módulo scx.nix não carregado?)."

#: roudix-scheduler.py
msgid "SCX disabled — back to the default scheduler (CFS/EEVDF)."
msgstr "SCX desativado — de volta ao escalonador padrão (CFS/EEVDF)."

#: roudix-scheduler.py
#, python-brace-format
msgid "flags: {extra}"
msgstr "flags: {extra}"

#: roudix-scheduler.py
#, python-brace-format
msgid "scx_{scheduler} active ({profile}){extra_note}."
msgstr "scx_{scheduler} ativo ({profile}){extra_note}."

#: roudix-scheduler.py
#, python-brace-format
msgid "scx-switch failed (code {code})"
msgstr "O scx-switch falhou (código {code})"

#: roudix-scheduler.py
msgid "pkexec not found."
msgstr "pkexec não encontrado."

#: roudix-scheduler.py
msgid "Running scheduler"
msgstr "Escalonador em execução"

#: roudix-scheduler.py
msgid "Select scheduler"
msgstr "Escolha o escalonador"

#: roudix-scheduler.py
msgid "Select profile"
msgstr "Escolha o perfil"

#: roudix-scheduler.py
msgid "Extra scheduler flags"
msgstr "Flags extras do escalonador"

#: roudix-scheduler.py
msgid "Disable"
msgstr "Desativar"

#: roudix-scheduler.py
msgid "Apply"
msgstr "Aplicar"

#: roudix-scheduler.py
msgid "⚠ scx-switch not found — check that scx.nix is applied."
msgstr "⚠ scx-switch não encontrado — verifique se o scx.nix está aplicado."

#: roudix-scheduler.py
msgid "None — CFS/EEVDF"
msgstr "Nenhum — CFS/EEVDF"

#: roudix-scheduler.py
msgid "Disabled — your scheduler choice will persist after reboot"
msgstr "Desativado — sua escolha de escalonador será mantida após reiniciar"

#: roudix-scheduler.py
msgid "Running — will be stopped automatically when a scheduler is applied"
msgstr ""
"Em execução — será parado automaticamente quando um escalonador for aplicado"

#: roudix-scheduler.py
msgid "Stopped — will be restarted automatically when switching back to None"
msgstr "Parado — será reiniciado automaticamente ao voltar para Nenhum"

#: roudix-scheduler.py
msgid "Disabling..."
msgstr "Desativando…"

#: roudix-scheduler.py
msgid "Applying..."
msgstr "Aplicando…"
