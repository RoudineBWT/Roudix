#: roudix-welcome.py
msgid "Software Store"
msgstr "متجر البرامج"

#: roudix-welcome.py
msgid "Install nixpkgs and Flatpak apps"
msgstr "ثبّت تطبيقات nixpkgs وFlatpak"

#: roudix-welcome.py
msgid "Customizer"
msgstr "أداة التخصيص"

#: roudix-welcome.py
msgid "Desktop, shell, apps and system tweaks"
msgstr "سطح المكتب والواجهة والتطبيقات وتعديلات النظام"

#: roudix-welcome.py
msgid "Kernel Switcher"
msgstr "مبدّل النواة"

#: roudix-welcome.py
msgid "Pick your CachyOS kernel variant"
msgstr "اختر نسخة نواة CachyOS"

#: roudix-welcome.py
msgid "SCX Scheduler"
msgstr "مجدول SCX"

#: roudix-welcome.py
msgid "Choose and apply an SCX scheduler"
msgstr "اختر مجدول SCX وطبّقه"

#: roudix-welcome.py
msgid "Welcome to Roudix"
msgstr "مرحبًا بك في Roudix"

#: roudix-welcome.py
msgid "<span size='small'>Roudix is your personal NixOS distribution: Wayland compositors (Niri, Hyprland, MangoWC, Umbriel), GNOME and KDE, a CachyOS kernel, and a bunch of tweaks built for you — and for the family and friends you share it with. Use the shortcuts below to customize your system, switch kernel and scheduler, or install apps from the store.</span>"
msgstr "<span size='small'>Roudix هي توزيعة NixOS الشخصية الخاصة بك: مُركِّبات Wayland (Niri وHyprland وMangoWC وUmbriel)، وGNOME وKDE، ونواة CachyOS، ومجموعة من التعديلات المصمّمة من أجلك — ومن أجل العائلة والأصدقاء الذين تشاركها معهم. استخدم الاختصارات أدناه لتخصيص نظامك وتبديل النواة والمجدول أو تثبيت التطبيقات من المتجر.</span>"

#: roudix-welcome.py
msgid "Roudix Apps"
msgstr "تطبيقات Roudix"

#: roudix-welcome.py
msgid "Open"
msgstr "فتح"

#: roudix-welcome.py
msgid "Resources"
msgstr "الموارد"

#: roudix-welcome.py
msgid "Source code & documentation"
msgstr "الشيفرة المصدرية والتوثيق"

#: roudix-welcome.py
msgid "Show at startup"
msgstr "العرض عند بدء التشغيل"

#: roudix-welcome.py
msgid "Show this window again on every login"
msgstr "عرض هذه النافذة مجددًا عند كل تسجيل دخول"

#: roudix-welcome.py
msgid "Close"
msgstr "إغلاق"
