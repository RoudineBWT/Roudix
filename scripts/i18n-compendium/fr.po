msgstr "Scanners (SANE : réseau + HP)"

msgid "Office dictionaries"
msgstr "Dictionnaires de correction"

msgid "Don't install an office suite"
msgstr "Ne pas installer de suite bureautique"

msgid "GOverlay (GUI to configure MangoHud / vkBasalt)"
msgstr "GOverlay (interface pour configurer MangoHud / vkBasalt)"

msgid "Oversteer (racing wheel configuration)"
msgstr "Oversteer (configuration des volants de course)"

msgid "Create the sbctl keys at install time if missing (enrolling them stays manual)"
msgstr "Créer les clés sbctl à l’installation si elles manquent (leur enrôlement reste manuel)"

msgid "List “NixOS EAC” in the firmware boot menu (otherwise: sudo eac-reboot)"
msgstr "Lister « NixOS EAC » dans le menu de démarrage du firmware (sinon : sudo eac-reboot)"

msgid "Open kernel modules (RTX 20xx and newer — turn off for GTX 10xx/16xx)"
msgstr "Modules noyau ouverts (RTX 20xx et plus récent — à désactiver pour les GTX 10xx/16xx)"

msgid "Hide kernel / initrd messages during boot (turn off to debug a boot problem)"
msgstr "Masquer les messages du noyau / de l’initrd au démarrage (à désactiver pour diagnostiquer un problème de boot)"

msgid "Best battery life (default) — disables tuned, so game-performance does nothing"
msgstr "Meilleure autonomie (par défaut) — désactive tuned, donc game-performance ne fait rien"

msgid "Gaming laptop: keeps game-performance and the desktop power-mode selector"
msgstr "Portable de jeu : garde game-performance et le sélecteur de mode d’alimentation du bureau"

msgid "Printing (CUPS + network printers)"
msgstr "Impression (CUPS + imprimantes réseau)"

msgid "Monthly btrfs scrub"
msgstr "Scrub btrfs mensuel"

msgid "Kernel CVE mitigations (module blacklists)"
msgstr "Mitigations CVE du noyau (modules en liste noire)"

msgid "  ↳ Blacklist algif_aead (“Copy Fail”)"
msgstr "  ↳ Mettre algif_aead en liste noire (« Copy Fail »)"

msgid "  ↳ Blacklist esp4/esp6/rxrpc (“Dirty Frag”) — turn off ONLY with IPsec or AFS/Kerberos"
msgstr "  ↳ Mettre esp4/esp6/rxrpc en liste noire (« Dirty Frag ») — à désactiver UNIQUEMENT avec IPsec ou AFS/Kerberos"

msgid "Hibernation (needs swap, off by default)"
msgstr "Hibernation (nécessite un swap, désactivée par défaut)"

msgid "Laptop power backend"
msgstr "Gestion d’énergie du portable"

msgid "Boot splash (Plymouth) — off = plain text boot"
msgstr "Écran de démarrage (Plymouth) — désactivé = démarrage en texte brut"

msgid "Roudix — logo, gentle pulse (default)"
msgstr "Roudix — logo, pulsation douce (par défaut)"

msgid "Roudix Spin — logo turning slowly"
msgstr "Roudix Spin — logo qui tourne lentement"

msgid "Roudix Gradient — warm gradient, glow behind the logo"
msgstr "Roudix Gradient — dégradé chaud, halo derrière le logo"

msgid "Roudix Ember — rising embers, progress ring"
msgstr "Roudix Ember — braises qui montent, anneau de progression"

msgid "Pandoudix — the mascot"
msgstr "Pandoudix — la mascotte"

msgid "Open kernel modules"
msgstr "Modules noyau ouverts"

msgid "Boot splash"
msgstr "Écran de démarrage"

msgid "Common printer drivers and network printer discovery."
msgstr "Pilotes d’imprimante courants et détection des imprimantes réseau."

msgid "Word-style editors built around .docx / .xlsx / .pptx"
msgstr "Éditeurs de type Word pensés autour des formats .docx / .xlsx / .pptx"

msgid "ONLYOFFICE (Word-style editors, .docx / .xlsx / .pptx)"
msgstr "ONLYOFFICE (éditeurs de type Word, .docx / .xlsx / .pptx)"

msgid "Only letters, digits and . _ + - : , @ / are allowed here."
msgstr "Seuls les lettres, chiffres et . _ + - : , @ / sont autorisés ici."

msgid "Allowed: {codes}"
msgstr "Autorisés : {codes}"

msgid "Gaming extras"
msgstr "Extras gaming"

msgid "Features"
msgstr "Fonctionnalités"

msgid " or type to filter"
msgstr " ou tape pour filtrer"

msgid "Choice"
msgstr "Choix"

msgid "Choose one of the entries."
msgstr "Choisis l'une des entrées."

msgid "Out of range."
msgstr "Hors limites."

msgid "No match."
msgstr "Aucun résultat."

msgctxt "yes/no prompt, yes is the default"
msgid "[Y/n]"
msgstr "[O/n]"

msgctxt "yes/no prompt, no is the default"
msgid "[y/N]"
msgstr "[o/N]"

msgid "Answer yes or no."
msgstr "Réponds par oui ou non."

msgid "Toggle: numbers separated by spaces, a = all, n = none, Enter = continue"
msgstr "Bascule : numéros séparés par des espaces, a = tout, n = rien, Entrée = continuer"

msgid "Administrator rights are needed and sudo is not available: run the installer as root."
msgstr "Les droits administrateur sont nécessaires et sudo n'est pas disponible : lance l'installeur en root."

msgid "Administrator rights are needed: enter your password if asked."
msgstr "Les droits administrateur sont nécessaires : saisis ton mot de passe si on te le demande."

msgid "No disk found."
msgstr "Aucun disque trouvé."

msgid "File not found."
msgstr "Fichier introuvable."

msgid "Partition it yourself in another terminal (cfdisk, fdisk, parted…), then press Enter."
msgstr "Partitionne le disque toi-même dans un autre terminal (cfdisk, fdisk, parted…), puis appuie sur Entrée."

msgid "Other systems found in the EFI NVRAM — which ones do you want to add to Limine?"
msgstr "Autres systèmes trouvés dans la NVRAM EFI — lesquels veux-tu ajouter à Limine ?"

msgid "Edit the options"
msgstr "Modifier les options"

msgid "Quit"
msgstr "Quitter"

msgid "What now?"
msgstr "Et maintenant ?"

msgid "Start now?"
msgstr "Démarrer maintenant ?"

msgid "Interrupted — the installation may be incomplete."
msgstr "Interrompu — l'installation est peut-être incomplète."

msgid "Can't be empty."
msgstr "Ne peut pas être vide."

msgid "Content-creation tools"
msgstr "Outils de création de contenu"

msgid "OBS plugins"
msgstr "Plugins OBS"

msgid "Other systems"
msgstr "Autres systèmes"

msgid "Aborted — nothing was changed."
msgstr "Abandonné — rien n'a été modifié."

msgid "Found in the EFI NVRAM: switch on the ones to add to Limine's boot menu."
msgstr "Trouvés dans la NVRAM EFI : active ceux à ajouter au menu de démarrage de Limine."

# --- installer: temporary swap for nixos-install (swap.py / runner.py) ---
msgid "Low memory ({ram} GiB): adding {size} GiB of temporary swap on the target disk for the build…"
msgstr "Mémoire faible ({ram} Gio) : ajout de {size} Gio de swap temporaire sur le disque cible pour la compilation…"

msgid "Could not add temporary swap ({reason}) — the build may run out of memory."
msgstr "Impossible d'ajouter du swap temporaire ({reason}) — la compilation risque de manquer de mémoire."

msgid "not enough free space on the target disk"
msgstr "pas assez d'espace libre sur le disque cible"

# --- installer: zram during nixos-install ---
msgid "Compressed RAM swap (zram) enabled: {size} GiB."
msgstr "Swap compressé en RAM (zram) activé : {size} Gio."

msgid "Could not enable zram ({reason})."
msgstr "Impossible d'activer zram ({reason})."
