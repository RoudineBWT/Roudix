/*
 * Roudix Calamares Stylesheet
 * Noms de widgets confirmés depuis le source Calamares :
 *   sideBox       → objectName "sidebarApp"
 *   logoLabel     → objectName "logoApp"
 *   La liste des étapes est un QListWidget enfant de sidebarApp
 */

/* ── Sidebar container ──────────────────────────────────────────────────── */
#sidebarApp {
    background-color: #252839;
    border-right: 1px solid #45475A;
}

/* Logo en haut de la sidebar */
#logoApp {
    background-color: #252839;
    padding: 12px;
}

/* QListWidget de navigation (liste des étapes) */
#sidebarApp QListWidget {
    background-color: #252839;
    border: none;
    outline: none;
    padding: 8px 0;
}

/* Items normaux */
#sidebarApp QListWidget::item {
    background-color: #252839;
    color: #FFFFFF;
    padding: 10px 16px;
    border: none;
    border-radius: 0;
    font-size: 13px;
}

/* Item au survol */
#sidebarApp QListWidget::item:hover {
    background-color: #313244;
    color: #FFFFFF;
}

/* Item sélectionné / actif */
#sidebarApp QListWidget::item:selected {
    background-color: #313244;
    color: #E8956D;
    border-left: 3px solid #E8956D;
    padding-left: 13px;
    font-weight: bold;
}

/* ── Fenêtre principale ──────────────────────────────────────────────────── */
QDialog, QWidget {
    background-color: #1E2030;
    color: #CDD6F4;
}

/* ── Boutons ─────────────────────────────────────────────────────────────── */
QPushButton {
    background-color: #313244;
    color: #CDD6F4;
    border: 1px solid #45475A;
    border-radius: 6px;
    padding: 6px 18px;
    min-width: 80px;
}
QPushButton:hover {
    background-color: #3D3F54;
    border-color: #E8956D;
    color: #E8956D;
}
QPushButton:pressed {
    background-color: #E8956D;
    color: #1E2030;
    border: none;
}
QPushButton#nextButton,
QPushButton#commitButton {
    background-color: #E8956D;
    color: #1E2030;
    border: none;
    font-weight: bold;
}
QPushButton#nextButton:hover,
QPushButton#commitButton:hover {
    background-color: #F0A882;
}
QPushButton:disabled {
    background-color: #252839;
    color: #585B70;
    border-color: #313244;
}

/* ── Champs texte ────────────────────────────────────────────────────────── */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #252839;
    color: #CDD6F4;
    border: 1px solid #45475A;
    border-radius: 6px;
    padding: 5px 8px;
    selection-background-color: #E8956D;
    selection-color: #1E2030;
}
QLineEdit:focus, QTextEdit:focus { border-color: #E8956D; }

/* ── Listes (packagechooser) ─────────────────────────────────────────────── */
QListView, QTreeView {
    background-color: #252839;
    color: #CDD6F4;
    border: 1px solid #45475A;
    border-radius: 6px;
    outline: none;
}
QListView::item, QTreeView::item {
    padding: 8px;
    color: #CDD6F4;
}
QListView::item:selected, QTreeView::item:selected {
    background-color: #E8956D;
    color: #1E2030;
}
QListView::item:hover, QTreeView::item:hover {
    background-color: #313244;
}

/* ── ComboBox ─────────────────────────────────────────────────────────────── */
QComboBox {
    background-color: #252839;
    color: #CDD6F4;
    border: 1px solid #45475A;
    border-radius: 6px;
    padding: 5px 8px;
}
QComboBox:hover { border-color: #E8956D; }
QComboBox QAbstractItemView {
    background-color: #252839;
    color: #CDD6F4;
    selection-background-color: #E8956D;
    selection-color: #1E2030;
}

/* ── ProgressBar ──────────────────────────────────────────────────────────── */
QProgressBar {
    background-color: #252839;
    border: 1px solid #45475A;
    border-radius: 6px;
    height: 10px;
    color: transparent;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,
        stop:0 #D4849A, stop:1 #E8956D);
    border-radius: 6px;
}

/* ── Scrollbar ────────────────────────────────────────────────────────────── */
QScrollBar:vertical {
    background-color: #1E2030;
    width: 8px;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background-color: #45475A;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover { background-color: #E8956D; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

/* ── Log d'installation ───────────────────────────────────────────────────── */
QTextBrowser {
    background-color: #0D1117;
    color: #58A6FF;
    border: 1px solid #313244;
    border-radius: 6px;
    font-family: monospace;
    font-size: 12px;
}
