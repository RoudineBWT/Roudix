# Roudix Plymouth theme "roudix-panda" (script module)
#   - Pandoudix, the mascot: waving while booting, asleep on shutdown/reboot,
#     teary when Plymouth shows a message (fsck, warnings...), thin progress bar, LUKS/password prompt, message line.
# Colours come from the Limine menu: background #150b05, tan #eab676, cream #f6e2c4.

# ── Background ──────────────────────────────────────────────────────────────
Window.SetBackgroundTopColor(0.082, 0.043, 0.020);
Window.SetBackgroundBottomColor(0.082, 0.043, 0.020);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
cx = Window.GetX() + screen_w / 2;
cy = Window.GetY() + screen_h / 2;

# ── Mascot (3 poses, all 320x320 so they swap without moving) ───────────────
pose.wave = Image("panda-wave.png");
pose.sleep = Image("panda-sleep.png");
pose.tear = Image("panda-tear.png");

# Plymouth.GetMode() is "boot", "shutdown", "reboot", "updates"...
mode = Plymouth.GetMode();
asleep = 0;
if (mode == "shutdown" || mode == "reboot") asleep = 1;
if (asleep == 1) pose.main = pose.sleep;
else pose.main = pose.wave;

logo.image = pose.main;
logo.sprite = Sprite(logo.image);
logo.x = cx - logo.image.GetWidth() / 2;
logo.y = cy - logo.image.GetHeight() / 2 - 40;
logo.sprite.SetPosition(logo.x, logo.y, 10);

# ── Progress bar ────────────────────────────────────────────────────────────
track.image = Image("track.png");
track.sprite = Sprite(track.image);
track.x = cx - track.image.GetWidth() / 2;
track.y = logo.y + logo.image.GetHeight() + 40;
track.sprite.SetPosition(track.x, track.y, 10);

fill.image = Image("fill.png");
fill.sprite = Sprite();
fill.sprite.SetPosition(track.x, track.y, 11);

fun progress_callback(duration, progress) {
  if (progress > 0.01) {
    fill.sprite.SetImage(fill.image.Scale(fill.image.GetWidth() * progress, fill.image.GetHeight()));
  }
}
Plymouth.SetBootProgressFunction(progress_callback);

# ── Idle bob (called ~50 times per second) ─────────────────────────────────
# Awake: ±4 px every ~2.5 s. Asleep: slower and shallower, like breathing.
# After a message the teary pose stays ~5 s, then he goes back to normal.
frame = 0;
tear.until = 0;
fun refresh_callback() {
  frame++;
  if (asleep == 1) bob = 2.5 * Math.Sin(frame * 0.025);
  else bob = 4 * Math.Sin(frame * 0.05);
  logo.sprite.SetPosition(logo.x, logo.y + bob, 10);
  if (tear.until > 0 && frame > tear.until) {
    logo.sprite.SetImage(pose.main);
    tear.until = 0;
  }
}
Plymouth.SetRefreshFunction(refresh_callback);

# ── Password prompt (LUKS) ──────────────────────────────────────────────────
box.image = Image("box.png");
box.sprite = Sprite(box.image);
box.x = cx - box.image.GetWidth() / 2;
box.y = track.y + 40;
box.sprite.SetPosition(box.x, box.y, 20);
box.sprite.SetOpacity(0);

bullet.image = Image("bullet.png");
bullet.sprites = [];
bullet.max = 22;

prompt.sprite = Sprite();
prompt.sprite.SetPosition(box.x, box.y - 28, 20);

fun hide_prompt() {
  box.sprite.SetOpacity(0);
  prompt.sprite.SetOpacity(0);
  for (i = 0; i < bullet.max; i++) {
    if (bullet.sprites[i]) bullet.sprites[i].SetOpacity(0);
  }
}

fun display_password_callback(prompt_text, bullets) {
  box.sprite.SetOpacity(1);
  prompt.sprite.SetImage(Image.Text(prompt_text, 0.918, 0.714, 0.463));
  prompt.sprite.SetOpacity(1);

  for (i = 0; i < bullet.max; i++) {
    if (!bullet.sprites[i]) {
      bullet.sprites[i] = Sprite(bullet.image);
      bullet.sprites[i].SetPosition(box.x + 14 + i * 14, box.y + 14, 21);
    }
    if (i < bullets) bullet.sprites[i].SetOpacity(1);
    else bullet.sprites[i].SetOpacity(0);
  }
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
  hide_prompt();
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

# ── Status / error messages ─────────────────────────────────────────────────
message.sprite = Sprite();
message.sprite.SetPosition(cx - 150, track.y + 24, 20);

fun message_callback(text) {
  message.sprite.SetImage(Image.Text(text, 0.965, 0.886, 0.769));
  logo.sprite.SetImage(pose.tear);
  tear.until = frame + 250;
}
Plymouth.SetMessageFunction(message_callback);
