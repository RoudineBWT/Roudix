{ pkgs, lib, osConfig, roudixSwitch, dotfiles, ... }:
{
  # ── Optional per-compositor override files ──────────────────────────────
  # If you customize one compositor a lot (especially mango, whose override
  # is a large block of raw text rather than a few lines of Nix), create
  # the matching file next to local.nix and it will be imported
  # automatically if it exists — nothing to enable by hand. See
  # niri-custom.nix.example / umbriel-custom.nix.example /
  # mango-custom.nix.example for concrete copy-paste examples.
  imports =
    lib.optional (builtins.pathExists ./niri-custom.nix) ./niri-custom.nix
    ++ lib.optional (builtins.pathExists ./umbriel-custom.nix) ./umbriel-custom.nix
    ++ lib.optional (builtins.pathExists ./mango-custom.nix) ./mango-custom.nix;

  # ── Personal Home Manager overrides ─────────────────────────────────────
  # This file is gitignored and never touched by git pull.
  # Copy this file to home/local.nix and add your personal overrides here.

  # Examples:

  # Add personal packages
  # home.packages = with pkgs; [
  #   vlc
  #   telegram-desktop
  # ];

  # Override dotfiles source
  # xdg.configFile."hypr" = {
  #   source = "${dotfiles}/perso/hyprland";
  #   recursive = true;
  # };

  # Custom shell aliases
  # programs.fish.shellAliases = {
  #   myalias = "echo hello";
  # };

  # ── Niri / Umbriel / MangoWC overrides ──────────────────────────────────
  # For short overrides (2-3 lines), you can paste them directly here. For
  # a real per-compositor personal file, see niri-custom.nix.example /
  # umbriel-custom.nix.example / mango-custom.nix.example — they're
  # auto-imported (see `imports` above) as soon as you copy them without
  # the `.example` suffix.
  # ── Add personal packages ────────────────────────────────────────────────
  # home.packages = with pkgs; [
  #   vlc
  #   telegram-desktop
  # ];

  # ── Custom shell aliases ─────────────────────────────────────────────────
  # programs.fish.shellAliases = {
  #   myalias = "echo hello";
  # };

  # ── Fastfetch ────────────────────────────────────────────────────────────

  # roudix.fastfetch.useNix = false;  # false = your fastfetch config in ~/.config/fastfetch

  # Override logo with a custom image (kitty terminal required)
  # programs.fastfetch.settings.logo = {
  #   type = "kitty-direct";
  #   source = "/home/youruser/Pictures/roudix-logo-blue.png";
  #   padding = { top = 1; left = 3; };
  #   width = 38;
  # };

  # Override logo with a custom ASCII file
  # programs.fastfetch.settings.logo = {
  #   type = "file";
  #   source = "/home/youruser/.config/fastfetch/my-logo.txt";
  #   padding = { top = 1; left = 3; };
  #   width = 38;
  # };

  # Override display color (ANSI color code)
  # programs.fastfetch.settings.display.color = "35"; # purple

  # Override entire fastfetch config (overwrites everything)
  # programs.fastfetch.settings = lib.mkForce {
  #   "$schema" = "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json";
  #   logo = {
  #     type = "kitty-direct";
  #     source = "/home/youruser/Pictures/my-logo.png";
  #     padding = { top = 1; left = 3; };
  #     width = 38;
  #   };
  #   display = {
  #     separator = "  ";
  #     color = "33";
  #   };
  #   modules = [
  #     { type = "os"; key = "󱄅 OS"; keyColor = "33"; }
  #     { type = "kernel"; key = " Kernel"; keyColor = "33"; }
  #   ];
  # };

  # ── KDE overrides ────────────────────────────────────────────────────────
  # Roudix applies its KDE look once (first login), so you normally just
  # change things in System Settings. Everything below is only for pinning a
  # value declaratively: plasma-manager re-applies it on EVERY rebuild.

  # Override wallpaper (still defined by the repo -> mkForce)
  # programs.plasma.workspace.wallpaper = lib.mkForce "/home/youruser/Pictures/my-wallpaper.jpg";

  # Pin color scheme / icons / cursor (no mkForce: the repo doesn't set them)
  # programs.plasma.workspace.colorScheme = "BreezeDark";
  # programs.plasma.workspace.iconTheme = "Papirus-Dark";

  # Override the panel (still defined by the repo -> mkForce)
  # programs.plasma.panels = lib.mkForce [{ ... }];

  # ── GNOME overrides ──────────────────────────────────────────────────────
  # Roudix ships GNOME's look as dconf DEFAULTS: change it in Settings/Tweaks
  # and it sticks across rebuilds. Setting a key here instead PINS it: it is
  # re-applied on every rebuild and overrides the UI. (No mkForce needed.)

  # Pin light wallpaper
  # dconf.settings."org/gnome/desktop/background".picture-uri =
  #   "file:///home/youruser/Pictures/my-wallpaper.png";

  # Pin dark wallpaper
  # dconf.settings."org/gnome/desktop/background".picture-uri-dark =
  #   "file:///home/youruser/Pictures/my-wallpaper-dark.png";

  # Pin screensaver wallpaper
  # dconf.settings."org/gnome/desktop/screensaver".picture-uri =
  #   "file:///home/youruser/Pictures/my-wallpaper-dark.png";

  # Pin light/dark mode
  # dconf.settings."org/gnome/desktop/interface".color-scheme =
  #   "prefer-light"; # or "prefer-dark"

  # Pin GTK theme
  # dconf.settings."org/gnome/desktop/interface".gtk-theme = "adw-gtk3";

  # Pin icon theme
  # dconf.settings."org/gnome/desktop/interface".icon-theme = "Papirus";

  # Pin cursor theme
  # dconf.settings."org/gnome/desktop/interface".cursor-theme = "capitaine-cursors";
  # dconf.settings."org/gnome/desktop/interface".cursor-size = 32;

  # Pin system font
  # dconf.settings."org/gnome/desktop/interface".font-name = "Inter 11";
}
