#, python-brace-format
msgid "hosts/{hostname}/local.nix, username.nix, home/local.nix written."
msgstr "hosts/{hostname}/local.nix, username.nix и home/local.nix записаны."

#: src/roudix_installer/pages/progress.py
#, python-brace-format
msgid ""
"Warning: only {free} MiB free in /boot ({need} MiB recommended) — nixos-"
"rebuild may fail on a small EFI partition."
msgstr ""
"Внимание: в /boot свободно всего {free} МиБ (рекомендуется {need} МиБ) — "
"nixos-rebuild может завершиться ошибкой на маленьком EFI-разделе."

#: src/roudix_installer/pages/progress.py
#, python-brace-format
msgid ""
"Warning: only {free} GiB free for the Nix store ({need} GiB recommended)."
