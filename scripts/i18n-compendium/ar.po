# Shared translation memory for scripts/i18n.sh (msgmerge --compendium).
# `update` fills any still-untranslated message of every component from here,
# so a new string only needs its translation added once, in this file.
# Existing translations in po/*.po are never overwritten.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"

msgid "Vesktop (standalone Vencord)"
msgstr "Vesktop (Vencord مستقل)"

msgid "Standalone Vencord client, native Wayland"
msgstr "عميل Vencord مستقل، Wayland أصلي"

msgid "Roudix — logo, gentle pulse (default)"
msgstr "Roudix — الشعار بنبض هادئ (افتراضي)"

msgid "Roudix Spin — logo turning slowly"
msgstr "Roudix Spin — الشعار يدور ببطء"

msgid "Roudix Gradient — warm gradient, glow behind the logo"
msgstr "Roudix Gradient — تدرّج لوني دافئ مع توهّج خلف الشعار"

msgid "Roudix Ember — rising embers, progress ring"
msgstr "Roudix Ember — جمرات متصاعدة وحلقة تقدّم"

msgid "Pandoudix — the mascot"
msgstr "Pandoudix — التميمة"

msgid "No splash — plain text boot"
msgstr "بدون شاشة إقلاع — إقلاع نصي عادي"

msgid "LibreOffice (Writer, Calc, Impress)"
msgstr "LibreOffice (Writer وCalc وImpress)"

msgid "ONLYOFFICE (Word-style editors, .docx / .xlsx / .pptx)"
msgstr "ONLYOFFICE (محررات بنمط Word، بصيغ .docx / .xlsx / .pptx)"

msgid "Open kernel modules"
msgstr "وحدات النواة المفتوحة"

msgid "RTX 20xx and newer. Turn off for GTX 10xx / 16xx cards."
msgstr "لبطاقات RTX 20xx وما بعدها. عطّلها لبطاقات GTX 10xx / 16xx."

msgid "Boot splash"
msgstr "شاشة الإقلاع"

msgid "Office suite"
msgstr "حزمة المكتب"

msgid "Office dictionaries (comma-separated: en, fr, es, de, it, pt)"
msgstr "قواميس المكتب (مفصولة بفواصل: en, fr, es, de, it, pt)"

msgid "Printing (CUPS)"
msgstr "الطباعة (CUPS)"

msgid "Common printer drivers and network printer discovery."
msgstr "برامج تشغيل الطابعات الشائعة واكتشاف الطابعات الشبكية."

msgid "Scanners (SANE)"
msgstr "الماسحات الضوئية (SANE)"

msgid "OpenVPN (NetworkManager plugin)"
msgstr "OpenVPN (إضافة NetworkManager)"

msgid "GOverlay (GUI to configure MangoHud / vkBasalt)"
msgstr "GOverlay (واجهة رسومية لضبط MangoHud / vkBasalt)"

msgid "Oversteer (racing wheel configuration)"
msgstr "Oversteer (ضبط عجلات السباق)"

msgid "Writer, Calc, Impress"
msgstr "Writer وCalc وImpress"

msgid "Word-style editors built around .docx / .xlsx / .pptx"
msgstr "محررات بنمط Word مبنية حول صيغ .docx / .xlsx / .pptx"

msgid "Don't install an office suite"
msgstr "عدم تثبيت حزمة مكتب"

msgid "English"
msgstr "الإنجليزية"

msgid "French"
msgstr "الفرنسية"

msgid "Spanish"
msgstr "الإسبانية"

msgid "German"
msgstr "الألمانية"

msgid "Italian"
msgstr "الإيطالية"

msgid "Portuguese"
msgstr "البرتغالية"

msgid "Create the sbctl keys at install time if missing (enrolling them stays manual)"
msgstr "إنشاء مفاتيح sbctl أثناء التثبيت إن كانت مفقودة (يبقى تسجيلها يدويًا)"

msgid "List “NixOS EAC” in the firmware boot menu (otherwise: sudo eac-reboot)"
msgstr "إدراج «NixOS EAC» في قائمة إقلاع البرنامج الثابت (وإلا: sudo eac-reboot)"

msgid "Open kernel modules (RTX 20xx and newer — turn off for GTX 10xx/16xx)"
msgstr "وحدات النواة المفتوحة (RTX 20xx وما بعدها — عطّلها لبطاقات GTX 10xx/16xx)"

msgid "Boot splash (Plymouth) — off = plain text boot"
msgstr "شاشة الإقلاع (Plymouth) — معطّلة = إقلاع نصي عادي"

msgid "Hide kernel / initrd messages during boot (turn off to debug a boot problem)"
msgstr "إخفاء رسائل النواة / initrd أثناء الإقلاع (عطّلها لتشخيص مشكلة في الإقلاع)"

msgid "Best battery life (default) — disables tuned, so game-performance does nothing"
msgstr "أفضل عمر للبطارية (افتراضي) — يعطّل tuned، لذا لا يفعل game-performance شيئًا"

msgid "Gaming laptop: keeps game-performance and the desktop power-mode selector"
msgstr "حاسوب محمول للألعاب: يُبقي game-performance ومحدد وضع الطاقة في سطح المكتب"

msgid "Printing (CUPS + network printers)"
msgstr "الطباعة (CUPS + الطابعات الشبكية)"

msgid "Scanners (SANE: network + HP)"
msgstr "الماسحات الضوئية (SANE: الشبكة + HP)"

msgid "Monthly btrfs scrub"
msgstr "فحص btrfs الشهري (scrub)"

msgid "Kernel CVE mitigations (module blacklists)"
msgstr "تخفيف ثغرات CVE في النواة (قوائم حظر الوحدات)"

msgid "  ↳ Blacklist algif_aead (“Copy Fail”)"
msgstr "  ↳ حظر algif_aead («Copy Fail»)"

msgid "  ↳ Blacklist esp4/esp6/rxrpc (“Dirty Frag”) — turn off ONLY with IPsec or AFS/Kerberos"
msgstr "  ↳ حظر esp4/esp6/rxrpc («Dirty Frag») — عطّله فقط عند استخدام IPsec أو AFS/Kerberos"

msgid "Hibernation (needs swap, off by default)"
msgstr "السبات (يتطلب swap، معطّل افتراضيًا)"

msgid "Office dictionaries"
msgstr "قواميس المكتب"

msgid "Laptop power backend"
msgstr "نظام إدارة طاقة الحاسوب المحمول"

# --- installer terminal wizard (tui.py) ---
msgid "Other systems"
msgstr "أنظمة أخرى"

msgid "Found in the EFI NVRAM: switch on the ones to add to Limine's boot menu."
msgstr "وُجدت في EFI NVRAM: فعّل الأنظمة التي تريد إضافتها إلى قائمة إقلاع Limine."

msgid "Only letters, digits and . _ + - : , @ / are allowed here."
msgstr "يُسمح هنا فقط بالأحرف والأرقام و . _ + - : , @ /"

msgid "Allowed: {codes}"
msgstr "المسموح: {codes}"

msgid "Can't be empty."
msgstr "لا يمكن أن يكون فارغًا."

msgid "Gaming extras"
msgstr "إضافات الألعاب"

msgid "Features"
msgstr "الميزات"

msgid "Content-creation tools"
msgstr "أدوات إنشاء المحتوى"

msgid "OBS plugins"
msgstr "إضافات OBS"

msgid " or type to filter"
msgstr " أو اكتب للتصفية"

msgid "Choice"
msgstr "الاختيار"

msgid "Choose one of the entries."
msgstr "اختر أحد الخيارات."

msgid "Out of range."
msgstr "خارج النطاق."

msgid "No match."
msgstr "لا توجد نتائج مطابقة."

msgctxt "yes/no prompt, yes is the default"
msgid "[Y/n]"
msgstr "[Y/n]"

msgctxt "yes/no prompt, no is the default"
msgid "[y/N]"
msgstr "[y/N]"

msgid "Answer yes or no."
msgstr "أجب بنعم أو لا."

msgid "Toggle: numbers separated by spaces, a = all, n = none, Enter = continue"
msgstr "التبديل: أرقام مفصولة بمسافات، a = الكل، n = لا شيء، Enter = متابعة"

msgid "Administrator rights are needed and sudo is not available: run the installer as root."
msgstr "صلاحيات المسؤول مطلوبة و sudo غير متاح: شغّل المثبّت بصفة root."

msgid "Administrator rights are needed: enter your password if asked."
msgstr "صلاحيات المسؤول مطلوبة: أدخل كلمة المرور إن طُلب منك ذلك."

msgid "No disk found."
msgstr "لم يُعثر على أي قرص."

msgid "File not found."
msgstr "الملف غير موجود."

msgid "Partition it yourself in another terminal (cfdisk, fdisk, parted…), then press Enter."
msgstr "قسّم القرص بنفسك في طرفية أخرى (cfdisk وfdisk وparted…) ثم اضغط Enter."

msgid "Other systems found in the EFI NVRAM — which ones do you want to add to Limine?"
msgstr "أنظمة أخرى وُجدت في EFI NVRAM — أيها تريد إضافته إلى Limine؟"

msgid "Edit the options"
msgstr "تعديل الخيارات"

msgid "Quit"
msgstr "خروج"

msgid "What now?"
msgstr "ماذا الآن؟"

msgid "Start now?"
msgstr "هل تريد البدء الآن؟"

msgid "Interrupted — the installation may be incomplete."
msgstr "تمت المقاطعة — قد يكون التثبيت غير مكتمل."

msgid "Aborted — nothing was changed."
msgstr "أُلغي — لم يتم تغيير أي شيء."


# --- installer: temporary swap for nixos-install (swap.py / runner.py) ---
msgid "Low memory ({ram} GiB): adding {size} GiB of temporary swap on the target disk for the build…"
msgstr "الذاكرة منخفضة ({ram} GiB): جارٍ إضافة {size} GiB من مساحة التبديل المؤقتة على القرص الهدف أثناء البناء…"

msgid "Could not add temporary swap ({reason}) — the build may run out of memory."
msgstr "تعذّرت إضافة مساحة تبديل مؤقتة ({reason}) — قد تنفد الذاكرة أثناء البناء."

msgid "not enough free space on the target disk"
msgstr "لا توجد مساحة خالية كافية على القرص الهدف"

# --- installer: zram during nixos-install ---
msgid "Compressed RAM swap (zram) enabled: {size} GiB."
msgstr "تم تفعيل مساحة التبديل المضغوطة في الذاكرة (zram): ‏{size} GiB."

msgid "Could not enable zram ({reason})."
msgstr "تعذّر تفعيل zram ({reason})."

msgid "Noctalia's native Wayland file manager"
msgstr "مدير ملفات Noctalia الأصلي لـ Wayland"

msgid "Luciole — Noctalia, native Wayland"
msgstr "Luciole — Noctalia، Wayland أصلي"

msgid "Detected in your config"
msgstr "تم اكتشافه في إعداداتك"

msgid "All options"
msgstr "كل الخيارات"

msgid "Setting “{sid}” no longer exists in the compositor config: your value was removed."
msgstr "الإعداد «{sid}» لم يعد موجودًا في إعدادات المُركِّب: تمت إزالة قيمتك."

msgid "Setting “{title}” changed type in the compositor config: your old value was removed."
msgstr "الإعداد «{title}» تغيّر نوعه في إعدادات المُركِّب: تمت إزالة قيمتك القديمة."

msgid "Made for Roudix: orange glyphs on dark tiles, Roudix folders"
msgstr "مصمم لـ Roudix: رموز برتقالية على بلاطات داكنة، مجلدات Roudix"

msgid "Made for Roudix, on light tiles"
msgstr "مصمم لـ Roudix، على بلاطات فاتحة"
