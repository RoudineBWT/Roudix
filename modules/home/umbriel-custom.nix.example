{ lib, ... }:
{
  # ── Personal Umbriel overrides ──────────────────────────────────────────
  # Copy this file to umbriel-custom.nix (without .example) next to
  # local.nix — auto-imported (see `imports` in local.nix), gitignored.
  # Same rule as niri-custom.nix.example: new key = plain assignment;
  # key already defined by the repo = lib.mkForce.

  # -- Change your screens' resolution/position -------------------------
  # (run `umbriel outputs` in session for the real connector names)
  # programs.umbriel.settings.output."DP-1".mode = lib.mkForce "3840x2160@144";

  # -- Remap an existing bind -----------------------------------------------
  # programs.umbriel.settings.keybinds."Mod+C" = lib.mkForce "spawn some-command";

  # -- Add a bind that doesn't exist yet --------------------------------
  # programs.umbriel.settings.keybinds."Mod+Shift+V" = "spawn pavucontrol";

  # -- Add an extra window rule -----------------------------------------------
  # programs.umbriel.settings.window_rule = [
  #   { match.app_id = "^mpv$"; default_floating = true; }
  # ];

  # -- Window behaviour (umbriel 2026-10-25) --------------------------------
  # Roudix pins hover_raises = false (see
  # _input.nix); flip it back with lib.mkForce.
  # programs.umbriel.settings.input.focus.hover_raises = lib.mkForce true;
  # Edge/corner drop zones when dragging in a stacking workspace (umbriel
  # b95c1ae, replaces input.window_snapping; Roudix pins it to false):
  # programs.umbriel.settings.layout.stacking.drop_zones = lib.mkForce true;

  # -- Xwayland / NVIDIA (umbriel d1a09d4, c028006) ---------------------------
  # X11 primary monitor for games / Wine that read resolutions from it
  # (connector or monitor identity from `umbriel outputs`):
  # programs.umbriel.settings.general.xwayland_primary_output = "DP-1";
  # NVIDIA sync workaround is on upstream; disable if it stutters:
  # programs.umbriel.settings.general.nvidia_sync_workaround = false;

  # -- Wide scrolling columns (umbriel 5e241f5) -------------------------------
  # Column extents go up to 4.0 (above 1.0 spans several viewports), e.g.
  # a column across two monitors-worth of width:
  # programs.umbriel.settings.keybinds."Mod+Alt+W" = "window-set-primary-extent 2.0";
  # (extent_presets and default_extent_fraction accept the same range.)

  # -- Per-window shortcut inhibition (umbriel 155665c) -----------------------
  # Roudix already disables client shortcut grabs for virt-manager / virt-viewer.
  # Add other apps the same way:
  # programs.umbriel.settings.window_rule = [
  #   { match.app_id = "^my-vm-app$"; allow_shortcuts_inhibit = false; }
  # ];

  # -- Server-side title bar (umbriel e3534ac, off by default) ----------------
  # mode: "off" | "negotiated" | "on" | "forced". Colors live under
  # [colors.title_bar] (they are not provided by the Noctalia include).
  # programs.umbriel.settings.appearance.title_bar = {
  #   mode = "negotiated";
  #   height = 28;
  #   button_position = "right";
  #   buttons = [ "minimize" "maximize" "close" ];
  #   # When the X / square / underscore symbols show: "always", "hover"
  #   # (default) or "never" (umbriel b1c3efc4; replaces button_icons and
  #   # button_icons_on_hover). button_background = false keeps symbols only.
  #   button_glyph = "hover";
  # };
  # Hide the bar only while a window is maximized to edges:
  # programs.umbriel.settings.window_rule = [
  #   { match.is_maximized_to_edges = true; title_bar = "off"; }
  # ];

  # -- Hide a window from screenshots / recordings (umbriel 1ecefc2) ----------
  # Visible locally, absent from screencopy / image-copy and portal screen
  # shares (password manager, private chat...). Raw export-dmabuf is no
  # longer advertised, so use screencopy or image-copy clients.
  # programs.umbriel.settings.window_rule = [
  #   { match.app_id = "^org.keepassxc.KeePassXC$"; block_capture = true; }
  # ];

  # -- Screen effect only while an output is shared (umbriel e0da106) ---------
  # Needs an effect preset that is already included (see _animation.nix);
  # add effects.in_capture = true so the viewers see it too.
  # programs.umbriel.settings.effects.screen_cast = "vignette";
  # programs.umbriel.settings.output."DP-1".screen_cast_effect = "off";

  # -- Move a whole workspace to another output (umbriel 69a348c) -------------
  # workspace-move-to-output-* now moves the workspace itself (name, layout,
  # windows); it no longer just moves the windows.
  # programs.umbriel.settings.keybinds."Mod+Ctrl+Page_Down" = "workspace-move-to-output-next";
  # programs.umbriel.settings.keybinds."Mod+Ctrl+Page_Up" = "workspace-move-to-output-previous";
  # programs.umbriel.settings.keybinds."Mod+Ctrl+W" = "workspace-move-to-output current WEB --output DP-1";

  # -- Scratchpad size follows the monitor (umbriel ef1d1b8) ------------------
  # Only for named scratchpads ([[scratchpad]] entries):
  # programs.umbriel.settings.scratchpad = [
  #   { name = "terminal"; proportional_size = true; }
  # ];

  # -- Focus fade of window-rule opacity / blur (umbriel 2952bbc) -------------
  # On by default upstream (spring); tune or disable it:
  # programs.umbriel.settings.animation.windows_opacity = {
  #   enabled = false;
  #   # curve = "easeinoutcubic"; duration_ms = 200;
  # };

  # -- Replace the whole animation section -----------------------------------
  # programs.umbriel.settings.animation = lib.mkForce {
  #   enabled = false; # disable everything, e.g. on an old PC
  # };
}
