msgstr "Резервное копирование /etc/nixos…"

#: src/roudix_installer/pages/progress.py
#, python-brace-format
msgid "✓ backup done: {dest} (see RESTORE.txt in it)."
msgstr "✓ резервная копия создана: {dest} (см. RESTORE.txt внутри)."

