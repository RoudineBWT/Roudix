#: roudix-welcome.py
msgid "Software Store"
msgstr "Tienda de software"

#: roudix-welcome.py
msgid "Install nixpkgs and Flatpak apps"
msgstr "Instala aplicaciones de nixpkgs y Flatpak"

#: roudix-welcome.py
msgid "Customizer"
msgstr "Personalizador"

#: roudix-welcome.py
msgid "Desktop, shell, apps and system tweaks"
msgstr "Escritorio, shell, aplicaciones y ajustes del sistema"

#: roudix-welcome.py
msgid "Kernel Switcher"
msgstr "Selector de kernel"

#: roudix-welcome.py
msgid "Pick your CachyOS kernel variant"
msgstr "Elige tu variante del kernel CachyOS"

#: roudix-welcome.py
msgid "SCX Scheduler"
msgstr "Planificador SCX"

#: roudix-welcome.py
msgid "Choose and apply an SCX scheduler"
msgstr "Elige y aplica un planificador SCX"

#: roudix-welcome.py
msgid "Disks"
msgstr "Discos"

#: roudix-welcome.py
msgid "Mount, format and manage your extra disks"
msgstr "Monta, formatea y gestiona tus discos adicionales"

#: roudix-welcome.py
msgid "Firewall"
msgstr "Cortafuegos"

#: roudix-welcome.py
msgid "Open ports and trusted interfaces"
msgstr "Puertos abiertos e interfaces de confianza"

#: roudix-welcome.py
msgid "Hardware Sync"
msgstr "Sincronización de hardware"

#: roudix-welcome.py
msgid "Changed PC? Update your CPU/GPU settings"
msgstr "¿Cambiaste de PC? Actualiza tus ajustes de CPU/GPU"

#: roudix-welcome.py
msgid "Compositor Config"
msgstr "Configuración del compositor"

#: roudix-welcome.py
msgid "Window rules, screens and shortcuts"
msgstr "Reglas de ventanas, pantallas y atajos"

#: roudix-welcome.py
msgid "Documentation"
msgstr "Documentación"

#: roudix-welcome.py
msgid "Source code"
msgstr "Código fuente"

#: roudix-welcome.py
msgid "Release notes"
msgstr "Notas de la versión"

#: roudix-welcome.py
msgid "Report a bug"
msgstr "Informar de un error"

#: roudix-welcome.py
msgid "YouTube"
msgstr "YouTube"

#: roudix-welcome.py
msgid "Discord"
msgstr "Discord"

#: roudix-welcome.py
msgid "Check for updates"
msgstr "Buscar actualizaciones"

#: roudix-welcome.py
msgid "See if new commits are available (nothing is changed)"
msgstr "Comprueba si hay commits nuevos (no se modifica nada)"

#: roudix-welcome.py
msgid "Update system"
msgstr "Actualizar el sistema"

#: roudix-welcome.py
msgid "Pull, rebuild, switch and update Flatpaks (same as `update`)"
msgstr ""
"Descarga, recompila, cambia y actualiza los Flatpak (igual que `update`)"

#: roudix-welcome.py
msgid ""
"Open a terminal and run the update? You will be asked for your password."
msgstr ""
"¿Abrir una terminal y ejecutar la actualización? Se te pedirá la contraseña."

#: roudix-welcome.py
msgid "Apply configuration"
msgstr "Aplicar la configuración"

#: roudix-welcome.py
msgid "Rebuild and switch now (same as `rebuild`)"
msgstr "Recompila y cambia ahora (igual que `rebuild`)"

#: roudix-welcome.py
msgid "Rebuild the system now? This can take a while."
msgstr "¿Recompilar el sistema ahora? Puede tardar un rato."

#: roudix-welcome.py
msgid "Clean old generations"
msgstr "Limpiar generaciones antiguas"

#: roudix-welcome.py
msgid "Keep the last 3 generations, then garbage-collect (same as `cleanup`)"
msgstr ""
"Conserva las últimas 3 generaciones y luego libera espacio (igual que "
"`cleanup`)"

#: roudix-welcome.py
msgid ""
"Remove old system generations? You will not be able to roll back to them."
msgstr ""
"¿Eliminar las generaciones antiguas del sistema? No podrás volver a ellas."

#: roudix-welcome.py
msgid "Show last update log"
msgstr "Mostrar el último registro de actualización"

#: roudix-welcome.py
msgid "Output of the last run of `update`"
msgstr "Salida de la última ejecución de `update`"

#: roudix-welcome.py
msgid "Press Enter to close…"
msgstr "Pulsa Intro para cerrar…"

#: roudix-welcome.py
msgid "Close"
msgstr "Cerrar"

#: roudix-welcome.py
msgid "Running…"
msgstr "Ejecutando…"

#: roudix-welcome.py
#, python-brace-format
msgid "ERROR: '{cmd}' not found in PATH."
msgstr "ERROR: no se encontró '{cmd}' en PATH."

#: roudix-welcome.py
#, python-brace-format
msgid "ERROR: {error}"
msgstr "ERROR: {error}"

#: roudix-welcome.py
msgid "✓ Done"
msgstr "✓ Hecho"

#: roudix-welcome.py
#, python-brace-format
msgid "✗ Failed (exit code {rc})"
msgstr "✗ Falló (código de salida {rc})"

#: roudix-welcome.py
msgid "Welcome to Roudix"
msgstr "Te damos la bienvenida a Roudix"

#: roudix-welcome.py
msgid "Welcome"
msgstr "Bienvenida"

#: roudix-welcome.py
msgid "Tweaks"
msgstr "Ajustes"

#: roudix-welcome.py
msgid "Your NixOS, your way — shared with the people you care about."
msgstr "Tu NixOS, a tu manera, compartido con la gente que te importa."

#: roudix-welcome.py
msgid "System tools"
msgstr "Herramientas del sistema"

#: roudix-welcome.py
msgid "Resources"
msgstr "Recursos"

#: roudix-welcome.py
msgid "Show at startup"
msgstr "Mostrar al iniciar"

#: roudix-welcome.py
msgid "Show this window again on every login"
msgstr "Mostrar esta ventana de nuevo en cada inicio de sesión"

#: roudix-welcome.py
msgid "Maintenance"
msgstr "Mantenimiento"

#: roudix-welcome.py
msgid "Common system tasks, one click away."
msgstr "Tareas habituales del sistema, a un clic."

#: roudix-welcome.py
msgid "Run"
msgstr "Ejecutar"

#: roudix-welcome.py
msgid "Configuration"
msgstr "Configuración"

#: roudix-welcome.py
msgid "Open configuration folder"
msgstr "Abrir la carpeta de configuración"

#: roudix-welcome.py
msgid "Cancel"
msgstr "Cancelar"

#: roudix-welcome.py
msgid "No terminal found"
msgstr "No se encontró ninguna terminal"

#: roudix-welcome.py
msgid "Open a terminal yourself and run `update`."
msgstr "Abre una terminal tú mismo y ejecuta `update`."

