{ ... }:
{
  programs.git = {
    enable = true;
    settings = {
      user.name = "yourname";
      user.email = "your@email.com";
      init.defaultBranch = "main";
      # pull.rebase = false → `git pull` does a classic merge (creates a
      # merge commit on divergence) instead of replaying your local
      # commits on top (rebase). Simpler and less surprising for a
      # personal repo; set to `true` if you prefer a linear history.
      pull.rebase = false;
    };
  };
}
