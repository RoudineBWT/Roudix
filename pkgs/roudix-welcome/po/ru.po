#: roudix-welcome.py
msgid "Software Store"
msgstr "Магазин приложений"

#: roudix-welcome.py
msgid "Install nixpkgs and Flatpak apps"
msgstr "Установка приложений nixpkgs и Flatpak"

#: roudix-welcome.py
msgid "Customizer"
msgstr "Настройка"

#: roudix-welcome.py
msgid "Desktop, shell, apps and system tweaks"
msgstr "Рабочий стол, оболочка, приложения и системные параметры"

#: roudix-welcome.py
msgid "Kernel Switcher"
msgstr "Выбор ядра"

#: roudix-welcome.py
msgid "Pick your CachyOS kernel variant"
msgstr "Выберите вариант ядра CachyOS"

#: roudix-welcome.py
msgid "SCX Scheduler"
msgstr "Планировщик SCX"

#: roudix-welcome.py
msgid "Choose and apply an SCX scheduler"
msgstr "Выберите и примените планировщик SCX"

#: roudix-welcome.py
msgid "Disks"
msgstr "Диски"

#: roudix-welcome.py
msgid "Mount, format and manage your extra disks"
msgstr "Монтируйте, форматируйте и управляйте дополнительными дисками"

#: roudix-welcome.py
msgid "Firewall"
msgstr "Брандмауэр"

#: roudix-welcome.py
msgid "Open ports and trusted interfaces"
msgstr "Открытые порты и доверенные интерфейсы"

#: roudix-welcome.py
msgid "Hardware Sync"
msgstr "Синхронизация оборудования"

#: roudix-welcome.py
msgid "Changed PC? Update your CPU/GPU settings"
msgstr "Сменили ПК? Обновите настройки CPU/GPU"

#: roudix-welcome.py
msgid "Compositor Config"
msgstr "Настройка композитора"

#: roudix-welcome.py
msgid "Window rules, screens and shortcuts"
msgstr "Правила окон, экраны и сочетания клавиш"

#: roudix-welcome.py
msgid "Documentation"
msgstr "Документация"

#: roudix-welcome.py
msgid "Source code"
msgstr "Исходный код"

#: roudix-welcome.py
msgid "Release notes"
msgstr "Примечания к выпуску"

#: roudix-welcome.py
msgid "Report a bug"
msgstr "Сообщить об ошибке"

#: roudix-welcome.py
msgid "YouTube"
msgstr "YouTube"

#: roudix-welcome.py
msgid "Discord"
msgstr "Discord"

#: roudix-welcome.py
msgid "Check for updates"
msgstr "Проверить обновления"

#: roudix-welcome.py
msgid "See if new commits are available (nothing is changed)"
msgstr "Проверить, есть ли новые коммиты (ничего не изменяется)"

#: roudix-welcome.py
msgid "Update system"
msgstr "Обновить систему"

#: roudix-welcome.py
msgid "Pull, rebuild, switch and update Flatpaks (same as `update`)"
msgstr ""
"Загрузка, пересборка, переключение и обновление Flatpak (как `update`)"

#: roudix-welcome.py
msgid ""
"Open a terminal and run the update? You will be asked for your password."
msgstr "Открыть терминал и запустить обновление? Потребуется ввести пароль."

#: roudix-welcome.py
msgid "Apply configuration"
msgstr "Применить конфигурацию"

#: roudix-welcome.py
msgid "Rebuild and switch now (same as `rebuild`)"
msgstr "Пересобрать и переключиться сейчас (как `rebuild`)"

#: roudix-welcome.py
msgid "Rebuild the system now? This can take a while."
msgstr "Пересобрать систему сейчас? Это может занять некоторое время."

#: roudix-welcome.py
msgid "Clean old generations"
msgstr "Очистить старые поколения"

#: roudix-welcome.py
msgid "Keep the last 3 generations, then garbage-collect (same as `cleanup`)"
msgstr "Оставить последние 3 поколения, затем очистить мусор (как `cleanup`)"

#: roudix-welcome.py
msgid ""
"Remove old system generations? You will not be able to roll back to them."
msgstr "Удалить старые поколения системы? Откатиться к ним будет невозможно."

#: roudix-welcome.py
msgid "Show last update log"
msgstr "Показать последний журнал обновления"

#: roudix-welcome.py
msgid "Output of the last run of `update`"
msgstr "Вывод последнего запуска `update`"

#: roudix-welcome.py
msgid "Press Enter to close…"
msgstr "Нажмите Enter, чтобы закрыть…"

#: roudix-welcome.py
msgid "Close"
msgstr "Закрыть"

#: roudix-welcome.py
msgid "Running…"
msgstr "Выполняется…"

#: roudix-welcome.py
#, python-brace-format
msgid "ERROR: '{cmd}' not found in PATH."
msgstr "ОШИБКА: «{cmd}» не найден в PATH."

#: roudix-welcome.py
#, python-brace-format
msgid "ERROR: {error}"
msgstr "ОШИБКА: {error}"

#: roudix-welcome.py
msgid "✓ Done"
msgstr "✓ Готово"

#: roudix-welcome.py
#, python-brace-format
msgid "✗ Failed (exit code {rc})"
msgstr "✗ Сбой (код выхода {rc})"

#: roudix-welcome.py
msgid "Welcome to Roudix"
msgstr "Добро пожаловать в Roudix"

#: roudix-welcome.py
msgid "Welcome"
msgstr "Добро пожаловать"

#: roudix-welcome.py
msgid "Tweaks"
msgstr "Настройки"

#: roudix-welcome.py
msgid "Your NixOS, your way — shared with the people you care about."
msgstr "Ваша NixOS, по-вашему — вместе с теми, кто вам дорог."

#: roudix-welcome.py
msgid "System tools"
msgstr "Системные инструменты"

#: roudix-welcome.py
msgid "Resources"
msgstr "Ресурсы"

#: roudix-welcome.py
msgid "Show at startup"
msgstr "Показывать при запуске"

#: roudix-welcome.py
msgid "Show this window again on every login"
msgstr "Показывать это окно при каждом входе в систему"

#: roudix-welcome.py
msgid "Maintenance"
msgstr "Обслуживание"

#: roudix-welcome.py
msgid "Common system tasks, one click away."
msgstr "Типичные задачи системы — в один клик."

#: roudix-welcome.py
msgid "Run"
msgstr "Запустить"

#: roudix-welcome.py
msgid "Configuration"
msgstr "Конфигурация"

#: roudix-welcome.py
msgid "Open configuration folder"
msgstr "Открыть папку конфигурации"

#: roudix-welcome.py
msgid "Cancel"
msgstr "Отмена"

#: roudix-welcome.py
msgid "No terminal found"
msgstr "Терминал не найден"

#: roudix-welcome.py
msgid "Open a terminal yourself and run `update`."
msgstr "Откройте терминал самостоятельно и выполните `update`."

