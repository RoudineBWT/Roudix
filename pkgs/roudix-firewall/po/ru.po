#: roudix-firewall.py
msgid "Enter at least one port."
msgstr "Введите хотя бы один порт."

#: roudix-firewall.py
#, python-brace-format
msgid "Not a valid port or range: {token} (ports go from 1 to 65535)."
msgstr "Недопустимый порт или диапазон: {token} (порты — от 1 до 65535)."

#: roudix-firewall.py
msgid "Edit rule"
msgstr "Изменить правило"

#: roudix-firewall.py
msgid "New rule"
msgstr "Новое правило"

#: roudix-firewall.py
msgid "Name"
msgstr "Название"

#: roudix-firewall.py
msgid "Protocol"
msgstr "Протокол"

#: roudix-firewall.py
msgid "Ports (e.g. 80, 443, 8000-8010)"
msgstr "Порты (например, 80, 443, 8000-8010)"

#: roudix-firewall.py
msgid "Cancel"
msgstr "Отмена"

#: roudix-firewall.py
msgid "Save"
msgstr "Сохранить"

#: roudix-firewall.py
msgid "Give the rule a name."
msgstr "Дайте правилу название."

#: roudix-firewall.py
msgid "Another rule already uses this protocol and these ports."
msgstr "Другое правило уже использует этот протокол и эти порты."

#: roudix-firewall.py
msgid "Presets"
msgstr "Шаблоны"

#: roudix-firewall.py
msgid "Added"
msgstr "Добавлено"

#: roudix-firewall.py
msgid "Add"
msgstr "Добавить"

#: roudix-firewall.py
msgid "Applying the firewall"
msgstr "Применение брандмауэра"

#: roudix-firewall.py
msgid "Rebuilding… this can take a few minutes."
msgstr "Пересборка… это может занять несколько минут."

#: roudix-firewall.py
msgid "Close"
msgstr "Закрыть"

#: roudix-firewall.py
msgid "ERROR: 'nh' not found in PATH."
msgstr "ОШИБКА: 'nh' не найден в PATH."

#: roudix-firewall.py
#, python-brace-format
msgid "ERROR: {error}"
msgstr "ОШИБКА: {error}"

#: roudix-firewall.py
msgid "✓ Firewall applied."
msgstr "✓ Брандмауэр применён."

#: roudix-firewall.py
msgid "✓ Rebuild completed successfully."
msgstr "✓ Пересборка успешно завершена."

#: roudix-firewall.py
#, python-brace-format
msgid ""
"✗ The rebuild failed (exit {rc}). Your previous firewall file was restored."
msgstr "✗ Пересборка не удалась (код выхода {rc}). Ваш предыдущий файл брандмауэра восстановлен."

#: roudix-firewall.py
#, python-brace-format
msgid "✗ Rebuild failed (exit code {rc})."
msgstr "✗ Пересборка не удалась (код выхода {rc})."

#: roudix-firewall.py
msgid "Roudix Firewall"
msgstr "Брандмауэр Roudix"

#: roudix-firewall.py
#, python-brace-format
msgid ""
"Host directory not found: {path}. Set ROUDIX_HOST to the name of your hosts/ "
"directory."
msgstr "Каталог хоста не найден: {path}. Задайте в ROUDIX_HOST имя вашего каталога hosts/."

#: roudix-firewall.py
msgid ""
"This host's configuration.nix does not import firewall.local.nix yet: "
"nothing saved here will apply. Update Roudix first."
msgstr "configuration.nix этого хоста ещё не импортирует firewall.local.nix: ничего из сохранённого здесь не будет применено. Сначала обновите Roudix."

#: roudix-firewall.py
msgid ""
"This file was edited by hand and has been read back from its Nix. Saving "
"will regenerate it."
msgstr "Этот файл был изменён вручную и заново прочитан из его Nix. При сохранении он будет создан заново."

#: roudix-firewall.py
#, python-brace-format
msgid ""
"Saved in {path}, which git ignores: git pull and the auto-update never "
"overwrite it."
msgstr "Сохранено в {path}, который игнорируется git: git pull и автообновление никогда его не перезаписывают."

#: roudix-firewall.py
msgid "Firewall"
msgstr "Брандмауэр"

#: roudix-firewall.py
msgid "Block incoming connections that are not allowed below"
msgstr "Блокировать входящие соединения, не разрешённые ниже"

#: roudix-firewall.py
msgid "Allowed ports"
msgstr "Разрешённые порты"

#: roudix-firewall.py
msgid "Incoming connections on these ports are allowed."
msgstr "Входящие соединения на эти порты разрешены."

#: roudix-firewall.py
msgid "Add rule"
msgstr "Добавить правило"

#: roudix-firewall.py
msgid "Trusted interfaces"
msgstr "Доверенные интерфейсы"

#: roudix-firewall.py
msgid ""
"All traffic coming in on these interfaces is allowed (containers, VMs, VPN…)."
msgstr "Весь входящий трафик через эти интерфейсы разрешён (контейнеры, ВМ, VPN…)."

#: roudix-firewall.py
msgid "Add an interface (e.g. docker0)"
msgstr "Добавьте интерфейс (например, docker0)"

#: roudix-firewall.py
msgid "Suggestions"
msgstr "Предложения"

#: roudix-firewall.py
msgid "Save & apply"
msgstr "Сохранить и применить"

#: roudix-firewall.py
#, python-brace-format
msgid ""
"local.nix also sets networking.firewall options ({n} line(s)). They keep "
"working and add up to the ones below, but cannot be edited here."
msgstr "local.nix также задаёт параметры networking.firewall (строк: {n}). Они продолжают работать и суммируются с параметрами ниже, но здесь их изменить нельзя."

#: roudix-firewall.py
msgid "Unsaved changes"
msgstr "Несохранённые изменения"

#: roudix-firewall.py
msgid "Add a rule or pick a preset."
msgstr "Добавьте правило или выберите шаблон."

#: roudix-firewall.py
msgid "No rules yet"
msgstr "Правил пока нет"

#: roudix-firewall.py
msgid "disabled"
msgstr "отключено"

#: roudix-firewall.py
msgid "Enable or disable this rule"
msgstr "Включить или отключить это правило"

#: roudix-firewall.py
msgid "Edit"
msgstr "Изменить"

#: roudix-firewall.py
msgid "Delete"
msgstr "Удалить"

#: roudix-firewall.py
msgid "Remove"
msgstr "Убрать"

#: roudix-firewall.py
#, python-brace-format
msgid "Invalid interface name: {name}"
msgstr "Недопустимое имя интерфейса: {name}"

#: roudix-firewall.py
msgid "Turn the firewall off?"
msgstr "Выключить брандмауэр?"

#: roudix-firewall.py
msgid ""
"With the firewall off, every port of this machine is reachable from the "
"network."
msgstr "При выключенном брандмауэре любой порт этого компьютера доступен из сети."

#: roudix-firewall.py
msgid "Turn off"
msgstr "Выключить"

#: roudix-firewall.py
#, python-brace-format
msgid "Could not save: {error}"
msgstr "Не удалось сохранить: {error}"

#: roudix-firewall.py
msgid "Saved. It takes effect at the next rebuild (or use Save & apply)."
msgstr "Сохранено. Изменения вступят в силу при следующей пересборке (или нажмите «Сохранить и применить»)."

#: roudix-firewall.py
#, python-brace-format
msgid "Could not restore the previous file: {error}"
msgstr "Не удалось восстановить предыдущий файл: {error}"

#: roudix-firewall.py
msgid "Discard unsaved changes?"
msgstr "Отменить несохранённые изменения?"

#: roudix-firewall.py
msgid "Your changes have not been saved."
msgstr "Ваши изменения не сохранены."

#: roudix-firewall.py
msgid "Discard"
msgstr "Отменить"

