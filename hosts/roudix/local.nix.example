# ── local.nix ───────────────────────────────────────────────────────────────
# Personal overrides — this file is gitignored and never overwritten by git pull.
# Copy this file: cp hosts/roudix/local.nix.example hosts/roudix/local.nix
# Then edit to match your hardware and preferences.
# Use lib.mkForce for options that conflict with configuration.nix defaults.
# ────────────────────────────────────────────────────────────────────────────
{ lib, pkgs, ... }:
{
  # ── Desktop ───────────────────────────────────────────────────────────────
  roudix.desktop.type = "niri";               # "niri", "gnome", "kde" or "hyprland"

  # ── Desktop shell ─────────────────────────────────────────────────────────
  # Only used when roudix.desktop.type = "niri" or "hyprland"
  # Controls which shell/bar stack is enabled for the chosen compositor.
  #   "noctalia"  — Noctalia shell   (github:noctalia-dev/noctalia-shell)
  #   "dms"       — DankMaterialShell (github:AvengeMedia/DankMaterialShell)
  #   "caelestia" — Caelestia shell  (github:caelestia-dots/shell)
  roudix.desktop.shell = "noctalia";

  # ── Umbriel : scratchpads ────────────────────────────────────────────────
  # Only used when roudix.desktop.type = "umbriel"
  # true  — Discord/Telegram/Spotify live in named scratchpads (show/hide/
  #         send-back with a shortcut: Mod+Alt+D/M, Mod+Alt+Shift+D/M)
  # false — pinned to a fixed output/workspace/position (default)
  roudix.umbriel.scratchpadApps = false;

  # ── Browser ───────────────────────────────────────────────────────────────
  roudix.browsers = ["helium" "brave-origin-beta" ];               # "brave", "helium", "vivaldi", "firefox", "librewolf", "chromium" or []
  roudix.zen.enable           = true;        # install Zen Browser (from zen-browser flake input)
  roudix.zen.variant     = "twilight"; # "twilight" (default), "beta" or "twilight-official"
  roudix.zen.sine.enable = true;       # true sur la machine où tu veux Sine
  roudix.zen.mods        = [];
  roudix.zen.sine.mods   = [ "Arc-2.0" "unloaded-tabs" "context-menu-icons" "floating-statusbar" ];   # ← utilise celle-là à la place

  # ── Hardware ──────────────────────────────────────────────────────────────
  roudix.rgb        = "openlinkhub";           # "openlinkhub" (full Corsair), "openrgb" (mixed/other brands) or "none"
  roudix.memory.enable  = true;          # true pour activer le RGB RAM
  roudix.memory.type    = "ddr5";         # "ddr4" ou "ddr5"
  roudix.memory.smBus   = "i2c-9";        # trouvé via: i2cdetect -l
  roudix.memory.sku    = "CMH64GX5M2B5200C40"; # trouvé via: sudo dmidecode -t memory | grep 'Part Number'
  hardware.myGpu    = "amd";                  # "amd", "nvidia" or "intel"
  hardware.nvidiaLaptop = false;              # enable this only for Laptops with nvidia Dgpu
  hardware.myCpu    = "intel";               # "intel" or "amd"
  hardware.myKernel = "cachyos-latest-v3"; # see README for all variants — used when hardware.myGpu != "nvidia"
  # hardware.myKernelChaotic = "cachyos"; # Chaotic-Nyx variant (cachyos, cachyos-lts, cachyos-server, cachyos-hardened) — used when hardware.myGpu == "nvidia", ships nvidia_cachyos precompiled
  # ↑ Only one of the two should be active (uncommented) at a time — comment
  #   out hardware.myKernel and uncomment hardware.myKernelChaotic if you're
  #   on nvidia, and vice versa. The installer does this toggle for you.

  # ── Optional modules ──────────────────────────────────────────────────────
  roudix.boot.bootloader = "limine";  # "limine" or "systemd-boot"
  roudix.terminal = "ghostty"; # "ghostty", "kitty", "alacritty", "foot" or "wezterm"
  roudix.fileManager = "nautilus"; # dolphin, thunar, nautilus, nemo
  roudix.gaming.enable        = true;         # disable to skip Steam, Wine, etc.
  # Débraye individuellement les apps du groupe gaming (toutes à true par défaut) :
  # roudix.gaming.apps.lutris.enable       = false;
  # roudix.gaming.apps.heroic.enable       = false;
  # roudix.gaming.apps.faugus.enable       = false;
  # roudix.gaming.apps.prismlauncher.enable = false;
  # roudix.gaming.apps.vintagestory.enable = false;
  # roudix.gaming.apps.mangohud.enable     = false;
  roudix.undervolt.only-amd.enable        = true;         # enable undervolting just for amd gpu.
  roudix.contentCreation.enable = true; # disable to skip OBS, video editor, virtual cam, etc.
  # roudix.contentCreation.obs.enable = false;
  # Plugins OBS activés/désactivés individuellement (vkcapture + pipewireAudioCapture par défaut) :
  # roudix.contentCreation.obs.plugins.vkcapture.enable             = false;
  # roudix.contentCreation.obs.plugins.pipewireAudioCapture.enable  = false;
  # roudix.contentCreation.obs.plugins.backgroundRemoval.enable     = true;
  # roudix.contentCreation.obs.plugins.moveTransition.enable        = true;
  # roudix.contentCreation.obs.plugins.aitumMultistream.enable      = true;  # multistreaming — successeur d'obs-multi-rtmp
  # roudix.contentCreation.obs.plugins.gstreamer.enable              = true;
  # roudix.contentCreation.obs.plugins.compositeBlur.enable          = true;
  # roudix.contentCreation.obs.plugins.advancedSceneSwitcher.enable = true;
  # roudix.contentCreation.obs.plugins.inputOverlay.enable           = true;
  # roudix.contentCreation.obs.plugins.waveform.enable               = true;
  roudix.contentCreation.videoEditor = "kdenlive"; # "kdenlive", "davinci-resolve", "davinci-resolve-studio", "shotcut" or "none"
  # roudix.contentCreation.virtualCamera.enable = false; # v4l2loopback, utilisé par la webcam virtuelle OBS/DaVinci
  # roudix.contentCreation.streaming.chatterino.enable = true; # client de chat Twitch tiers
  roudix.gaming.ananicy.enable = false;
  roudix.editor = "zed"; # "vscode", "zed", "neovim" ou "none"
  # Sur niri/hyprland/mangowc/umbriel (compositeurs sans DE complet) : quel
  # keyring + xdg-desktop-portal utiliser. Sans effet sur gnome/kde.
  roudix.desktopIntegration = "gnome"; # "gnome" ou "kde"
  roudix.flatpak.enable       = true;        # enable Flatpak support
  roudix.virtualization.enable = true;       # enable libvirt / virt-manager
  roudix.vmGuest.enable       = true;        # enable only inside a VM
  roudix.autoupdate.enable    = false;         # automatic NixOS updates
  roudix.autoupdate.interval  = "1h";         # check interval (e.g. 1h, 6h, 24h)
  roudix.mesa.useGit = false;  # false = mesa stable
  roudix.waydroid.enable = false;
  roudix.matrixClient = "element"; # "element", "cinny" ou "none"
  roudix.discord = "vencord"; # "vencord", "vanilla" ou "none"
  # ── Misc ──────────────────────────────────────────────────────────────────
  roudix.hosts.gtaFix.enable  = true;      # fix GTA Online to play with your friends but they need to block battleye telemetry in /etc/hosts and if they are on windows in C:\Windows\System32\drivers\etc\hosts
  # roudix.autoupdate.branch   = "main";

  # ── Locale / Timezone ─────────────────────────────────────────────────────
  time.timeZone                        = "Europe/Brussels";
  environment.sessionVariables.TZ      = "Europe/Brussels";
  i18n.defaultLocale                   = "en_US.UTF-8";
  console.keyMap                       = "us-accentos";
  # ── Clavier graphique (Wayland — niri/hyprland/mangowc/umbriel) ──────────
  # Indépendant de console.keyMap ci-dessus (celui-là ne sert qu'au TTY,
  # avant le lancement de la session graphique). Sans effet sur GNOME/KDE,
  # qui gèrent leur disposition via leur propre daemon de settings.
  roudix.keyboardLayout                = "us";     # "us", "be", "fr", "de", "ch", "nl", "es", "it", "pt", "pl", "ru", "gb", "jp"...
  roudix.keyboardVariant                = "intl";  # "intl", "nodeadkeys", "bepo", "dvorak", "colemak", "" (aucune)

  # ── Shell ─────────────────────────────────────────────────────────────────
  roudix.shell                         = "fish";        # "fish" or "bash"

  # ── GNOME extensions ──────────────────────────────────────────────────────
  # Only used when roudix.desktop.type = "gnome"
  #
  # Add extensions on top of the defaults — pass the nixpkgs package:
  # roudix.gnome.extraExtensions = with pkgs.gnomeExtensions; [
  #   pop-shell   # <-- the package name from pkgs.gnomeExtensions.*
  # ];
  #
  # Disable a default extension — pass its UUID (the string identifier):
  # roudix.gnome.disabledExtensions = [
  #   "arcmenu@arcmenu.com"   # <-- UUID, not the package name
  # ];
  #
  # You can combine both — e.g. swap ArcMenu for another launcher:
  # roudix.gnome.extraExtensions = with pkgs.gnomeExtensions; [ pop-shell ];
  # roudix.gnome.disabledExtensions = [ "arcmenu@arcmenu.com" ];

  # ── KDE Login Screen wallpaper ────────────────────────────────────────────
  # Only used when roudix.desktop.type = "kde"
  #
  # The Plasma Login Manager copies the wallpaper into /var/lib/plasmalogin/wallpapers/
  # and references it via /etc/plasmalogin.conf.
  # Both the conf and the copy must point to the same wallpaper name.
  #
  # To use a custom wallpaper on the login screen:
  #
  # 1. Override the conf to point to your wallpaper folder name:
  # environment.etc."plasmalogin.conf".text = lib.mkForce ''
  #   [Greeter][Wallpaper][org.kde.image][General]
  #   Image=file:///var/lib/plasmalogin/wallpapers/MyWallpaper
  # '';
  #
  # 2. Override the activation script to copy your wallpaper files:
  # system.activationScripts.plasmaLoginWallpaper = lib.mkForce {
  #   text = ''
  #     install -d -o plasmalogin -g plasmalogin /var/lib/plasmalogin/wallpapers/MyWallpaper/contents/images
  #     cp /path/to/your/wallpaper.png /var/lib/plasmalogin/wallpapers/MyWallpaper/contents/images/wallpaper.png
  #     cp /path/to/your/metadata.json /var/lib/plasmalogin/wallpapers/MyWallpaper/metadata.json
  #     chown -R plasmalogin:plasmalogin /var/lib/plasmalogin/wallpapers/
  #   '';
  # };

  # ── Disk (replace with your own UUID) ─────────────────────────────────────
  # Run: lsblk -f
  # fileSystems."/mnt/gaming" = lib.mkForce {
  #   device = "/dev/disk/by-uuid/YOUR-UUID-HERE";
  #   fsType = "btrfs";
  #   options = [ "defaults" "nofail" ];
  # };
}
