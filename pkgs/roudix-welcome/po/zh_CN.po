#: roudix-welcome.py
msgid "Software Store"
msgstr "软件商店"

#: roudix-welcome.py
msgid "Install nixpkgs and Flatpak apps"
msgstr "安装 nixpkgs 和 Flatpak 应用"

#: roudix-welcome.py
msgid "Customizer"
msgstr "定制器"

#: roudix-welcome.py
msgid "Desktop, shell, apps and system tweaks"
msgstr "桌面、shell、应用和系统调整"

#: roudix-welcome.py
msgid "Kernel Switcher"
msgstr "内核切换器"

#: roudix-welcome.py
msgid "Pick your CachyOS kernel variant"
msgstr "选择你的 CachyOS 内核变体"

#: roudix-welcome.py
msgid "SCX Scheduler"
msgstr "SCX 调度器"

#: roudix-welcome.py
msgid "Choose and apply an SCX scheduler"
msgstr "选择并应用 SCX 调度器"

#: roudix-welcome.py
msgid "Disks"
msgstr "磁盘"

#: roudix-welcome.py
msgid "Mount, format and manage your extra disks"
msgstr "挂载、格式化并管理额外的磁盘"

#: roudix-welcome.py
msgid "Firewall"
msgstr "防火墙"

#: roudix-welcome.py
msgid "Open ports and trusted interfaces"
msgstr "开放端口和受信任的接口"

#: roudix-welcome.py
msgid "Hardware Sync"
msgstr "硬件同步"

#: roudix-welcome.py
msgid "Changed PC? Update your CPU/GPU settings"
msgstr "换了电脑？更新你的 CPU/GPU 设置"

#: roudix-welcome.py
msgid "Compositor Config"
msgstr "合成器配置"

#: roudix-welcome.py
msgid "Window rules, screens and shortcuts"
msgstr "窗口规则、屏幕和快捷键"

#: roudix-welcome.py
msgid "Documentation"
msgstr "文档"

#: roudix-welcome.py
msgid "Source code"
msgstr "源代码"

#: roudix-welcome.py
msgid "Release notes"
msgstr "发行说明"

#: roudix-welcome.py
msgid "Report a bug"
msgstr "报告错误"

#: roudix-welcome.py
msgid "YouTube"
msgstr "YouTube"

#: roudix-welcome.py
msgid "Discord"
msgstr "Discord"

#: roudix-welcome.py
msgid "Check for updates"
msgstr "检查更新"

#: roudix-welcome.py
msgid "See if new commits are available (nothing is changed)"
msgstr "查看是否有新的提交（不会更改任何内容）"

#: roudix-welcome.py
msgid "Update system"
msgstr "更新系统"

#: roudix-welcome.py
msgid "Pull, rebuild, switch and update Flatpaks (same as `update`)"
msgstr "拉取、重新构建、切换并更新 Flatpak（与 `update` 相同）"

#: roudix-welcome.py
msgid ""
"Open a terminal and run the update? You will be asked for your password."
msgstr "打开终端并运行更新？系统会要求你输入密码。"

#: roudix-welcome.py
msgid "Apply configuration"
msgstr "应用配置"

#: roudix-welcome.py
msgid "Rebuild and switch now (same as `rebuild`)"
msgstr "立即重新构建并切换（与 `rebuild` 相同）"

#: roudix-welcome.py
msgid "Rebuild the system now? This can take a while."
msgstr "现在重新构建系统？这可能需要一些时间。"

#: roudix-welcome.py
msgid "Clean old generations"
msgstr "清理旧世代"

#: roudix-welcome.py
msgid "Keep the last 3 generations, then garbage-collect (same as `cleanup`)"
msgstr "保留最近 3 个世代，然后进行垃圾回收（与 `cleanup` 相同）"

#: roudix-welcome.py
msgid ""
"Remove old system generations? You will not be able to roll back to them."
msgstr "删除旧的系统世代？之后将无法回滚到这些世代。"

#: roudix-welcome.py
msgid "Show last update log"
msgstr "显示上次更新日志"

#: roudix-welcome.py
msgid "Output of the last run of `update`"
msgstr "上次运行 `update` 的输出"

#: roudix-welcome.py
msgid "Press Enter to close…"
msgstr "按回车键关闭…"

#: roudix-welcome.py
msgid "Close"
msgstr "关闭"

#: roudix-welcome.py
msgid "Running…"
msgstr "正在运行…"

#: roudix-welcome.py
#, python-brace-format
msgid "ERROR: '{cmd}' not found in PATH."
msgstr "错误：在 PATH 中找不到“{cmd}”。"

#: roudix-welcome.py
#, python-brace-format
msgid "ERROR: {error}"
msgstr "错误：{error}"

#: roudix-welcome.py
msgid "✓ Done"
msgstr "✓ 完成"

#: roudix-welcome.py
#, python-brace-format
msgid "✗ Failed (exit code {rc})"
msgstr "✗ 失败（退出码 {rc}）"

#: roudix-welcome.py
msgid "Welcome to Roudix"
msgstr "欢迎使用 Roudix"

#: roudix-welcome.py
msgid "Welcome"
msgstr "欢迎"

#: roudix-welcome.py
msgid "Tweaks"
msgstr "调整"

#: roudix-welcome.py
msgid "Your NixOS, your way — shared with the people you care about."
msgstr "你的 NixOS，你做主——与你在乎的人一起分享。"

#: roudix-welcome.py
msgid "System tools"
msgstr "系统工具"

#: roudix-welcome.py
msgid "Resources"
msgstr "资源"

#: roudix-welcome.py
msgid "Show at startup"
msgstr "启动时显示"

#: roudix-welcome.py
msgid "Show this window again on every login"
msgstr "每次登录时再次显示此窗口"

#: roudix-welcome.py
msgid "Maintenance"
msgstr "维护"

#: roudix-welcome.py
msgid "Common system tasks, one click away."
msgstr "常用系统任务，一键完成。"

#: roudix-welcome.py
msgid "Run"
msgstr "运行"

#: roudix-welcome.py
msgid "Configuration"
msgstr "配置"

#: roudix-welcome.py
msgid "Open configuration folder"
msgstr "打开配置文件夹"

#: roudix-welcome.py
msgid "Cancel"
msgstr "取消"

#: roudix-welcome.py
msgid "No terminal found"
msgstr "未找到终端"

#: roudix-welcome.py
msgid "Open a terminal yourself and run `update`."
msgstr "请自行打开终端并运行 `update`。"

#~ msgid ""
#~ "<span size='small'>Roudix is your personal NixOS distribution: Wayland "
#~ "compositors (Niri, Hyprland, MangoWC, Umbriel), GNOME and KDE, a CachyOS "
#~ "kernel, and a bunch of tweaks built for you — and for the family and friends"
#~ " you share it with. Use the shortcuts below to customize your system, switch"
#~ " kernel and scheduler, or install apps from the store.</span>"
#~ msgstr ""
#~ "<span size='small'>Roudix 是你的个人 NixOS 发行版：Wayland "
#~ "合成器（Niri、Hyprland、MangoWC、Umbriel）、GNOME 和 KDE、CachyOS "
#~ "内核，以及一系列为你——也为与你分享它的家人和朋友——打造的调整。使用下方的快捷入口来定制系统、切换内核和调度器，或从商店安装应用。</span>"

#~ msgid "Roudix Apps"
#~ msgstr "Roudix 应用"

#~ msgid "Open"
#~ msgstr "打开"
