#: roudix-kernel-switcher.py
msgid ""
"linux-zen — mainline nixpkgs kernel, cached on cache.nixos.org, independent "
"of the xddxdd overlay"
msgstr ""
"linux-zen — kernel mainline de nixpkgs, en caché en cache.nixos.org, "
"independiente del overlay xddxdd"

#: roudix-kernel-switcher.py
msgid "linux LTS — nixpkgs default kernel, cached on cache.nixos.org"
msgstr ""
"linux LTS — kernel predeterminado de nixpkgs, en caché en cache.nixos.org"

#: roudix-kernel-switcher.py
msgid "linux latest — newest mainline stable, cached on cache.nixos.org"
msgstr ""
"linux latest — la última versión estable mainline, en caché en "
"cache.nixos.org"

#: roudix-kernel-switcher.py
msgid "linux_testing — mainline RC/testing kernel, cached on cache.nixos.org"
msgstr ""
"linux_testing — kernel mainline RC/de pruebas, en caché en cache.nixos.org"

#: roudix-kernel-switcher.py
msgid "XanMod LTS — nixpkgs, performance governor + lazy preemption + BBRv3"
msgstr ""
"XanMod LTS — nixpkgs, gobernador performance + preempción perezosa + BBRv3"

#: roudix-kernel-switcher.py
msgid "XanMod main branch — nixpkgs, newest XanMod"
msgstr "Rama principal de XanMod — nixpkgs, el XanMod más reciente"

#: roudix-kernel-switcher.py
msgid "Standard latest"
msgstr "Estándar, la más reciente"

#: roudix-kernel-switcher.py
msgid "x86_64-v3  —  recommended for modern CPUs"
msgstr "x86_64-v3  —  recomendado para CPU modernas"

#: roudix-kernel-switcher.py
msgid "AMD Zen 4 optimised"
msgstr "Optimizado para AMD Zen 4"

#: roudix-kernel-switcher.py
msgid "LTO + v3  —  best perf on modern CPUs"
msgstr "LTO + v3  —  mejor rendimiento en CPU modernas"

#: roudix-kernel-switcher.py
msgid "Long-term support"
msgstr "Soporte a largo plazo"

#: roudix-kernel-switcher.py
msgid "LTS + LTO + v3  —  stable + performance"
msgstr "LTS + LTO + v3  —  estabilidad + rendimiento"

#: roudix-kernel-switcher.py
msgid "BORE scheduler"
msgstr "Planificador BORE"

#: roudix-kernel-switcher.py
msgid "BMQ scheduler"
msgstr "Planificador BMQ"

#: roudix-kernel-switcher.py
msgid "EEVDF scheduler"
msgstr "Planificador EEVDF"

#: roudix-kernel-switcher.py
msgid "Security hardened"
msgstr "Seguridad reforzada"

#: roudix-kernel-switcher.py
msgid "Hardened + LTO"
msgstr "Reforzado + LTO"

#: roudix-kernel-switcher.py
msgid "Real-time + BORE"
msgstr "Tiempo real + BORE"

#: roudix-kernel-switcher.py
msgid "Real-time + BORE + LTO"
msgstr "Tiempo real + BORE + LTO"

#: roudix-kernel-switcher.py
msgid "Steam Deck optimised"
msgstr "Optimizado para Steam Deck"

#: roudix-kernel-switcher.py
msgid "Server optimised"
msgstr "Optimizado para servidores"

#: roudix-kernel-switcher.py
msgid "Server + LTO"
msgstr "Servidor + LTO"

#: roudix-kernel-switcher.py
msgid "Release candidate  —  unstable"
msgstr "Versión candidata  —  inestable"

#: roudix-kernel-switcher.py
msgid ""
"linux-zen — nvidia module cached only with the open driver; closed driver "
"compiles locally on every bump"
msgstr ""
"linux-zen — módulo nvidia en caché solo con el controlador abierto; el "
"controlador propietario se compila localmente en cada actualización"

#: roudix-kernel-switcher.py
msgid "linux LTS — same nvidia module caveat as zen"
msgstr "linux LTS — misma advertencia del módulo nvidia que zen"

#: roudix-kernel-switcher.py
msgid "linux latest — same nvidia module caveat as zen"
msgstr "linux latest — misma advertencia del módulo nvidia que zen"

#: roudix-kernel-switcher.py
msgid ""
"linux_testing — mainline RC/testing kernel, same nvidia module caveat as zen"
msgstr ""
"linux_testing — kernel mainline RC/de pruebas, misma advertencia del módulo "
"nvidia que zen"

#: roudix-kernel-switcher.py
msgid "XanMod LTS — same nvidia module caveat as zen"
msgstr "XanMod LTS — misma advertencia del módulo nvidia que zen"

#: roudix-kernel-switcher.py
msgid "XanMod main branch — same nvidia module caveat as zen"
msgstr "Rama principal de XanMod — misma advertencia del módulo nvidia que zen"

#: roudix-kernel-switcher.py
msgid "Default  —  LTO + BORE, ships nvidia_cachyos"
msgstr "Predeterminado  —  LTO + BORE, incluye nvidia_cachyos"

#: roudix-kernel-switcher.py
msgid "Server optimised  —  no desktop tuning"
msgstr "Optimizado para servidores  —  sin ajustes de escritorio"

#: roudix-kernel-switcher.py
msgid "Latest"
msgstr "Últimos"

#: roudix-kernel-switcher.py
msgid "Variants"
msgstr "Variantes"

#: roudix-kernel-switcher.py
msgid "Chaotic-Nyx (GPU: nvidia)"
msgstr "Chaotic-Nyx (GPU: nvidia)"

#: roudix-kernel-switcher.py
#, python-brace-format
msgid "Kernel source: {source}"
msgstr "Origen del kernel: {source}"

#: roudix-kernel-switcher.py
msgid ""
"Nvidia GPU detected — only Chaotic-Nyx variants are shown, so nvidia_cachyos "
"(precompiled driver) stays matched to your kernel."
msgstr ""
"GPU Nvidia detectada — solo se muestran las variantes de Chaotic-Nyx, para "
"que nvidia_cachyos (controlador precompilado) siga siendo compatible con tu "
"kernel."

#: roudix-kernel-switcher.py
msgid "Active kernel"
msgstr "Kernel activo"

#: roudix-kernel-switcher.py
msgid "Select a kernel variant above."
msgstr "Elige una variante de kernel arriba."

#: roudix-kernel-switcher.py
msgid "Apply & Rebuild"
msgstr "Aplicar y reconstruir"

#: roudix-kernel-switcher.py
#, python-brace-format
msgid "Will switch to: {variant}"
msgstr "Se cambiará a: {variant}"

#: roudix-kernel-switcher.py
msgid "Already the active kernel."
msgstr "Ya es el kernel activo."

#: roudix-kernel-switcher.py
msgid "Apply changes?"
msgstr "¿Aplicar los cambios?"

#: roudix-kernel-switcher.py
#, python-brace-format
msgid "Kernel: <b>{current}</b> → <b>{selected}</b>"
msgstr "Kernel: <b>{current}</b> → <b>{selected}</b>"

#: roudix-kernel-switcher.py
msgid "Your NixOS configuration will be rebuilt. This may take a few minutes."
msgstr ""
"Se reconstruirá tu configuración de NixOS. Esto puede tardar unos minutos."

#: roudix-kernel-switcher.py
msgid "Cancel"
msgstr "Cancelar"

#: roudix-kernel-switcher.py
#, python-brace-format
msgid "✗ Error writing config: {error}"
msgstr "✗ Error al escribir la configuración: {error}"

#: roudix-kernel-switcher.py
msgid "Building…"
msgstr "Construyendo…"

#: roudix-kernel-switcher.py
msgid "Important Notices:"
msgstr "Avisos importantes:"

#: roudix-kernel-switcher.py
msgid "No issues currently reported."
msgstr "Actualmente no hay problemas reportados."

#: roudix-kernel-switcher.py
#, python-brace-format
msgid "Running: {cmd}"
msgstr "Ejecutando: {cmd}"

#: roudix-kernel-switcher.py
msgid "Checking repositories..."
msgstr "Comprobando repositorios..."

#: roudix-kernel-switcher.py
msgid "ERROR: 'nh' not found in PATH."
msgstr "ERROR: no se encontró «nh» en el PATH."

#: roudix-kernel-switcher.py
#, python-brace-format
msgid "ERROR: {error}"
msgstr "ERROR: {error}"

#: roudix-kernel-switcher.py
#, python-brace-format
msgid "✓ Done — reboot to apply {kernel}."
msgstr "✓ Listo — reinicia para aplicar {kernel}."

#: roudix-kernel-switcher.py
msgid "✓ Rebuild completed successfully. Reboot to apply changes."
msgstr ""
"✓ Reconstrucción completada con éxito. Reinicia para aplicar los cambios."

#: roudix-kernel-switcher.py
#, python-brace-format
msgid "✗ Build failed (exit {rc}). See log."
msgstr "✗ Falló la construcción (código {rc}). Consulta el registro."

#: roudix-kernel-switcher.py
#, python-brace-format
msgid "✗ Rebuild failed (exit code {rc})."
msgstr "✗ Falló la reconstrucción (código de salida {rc})."
