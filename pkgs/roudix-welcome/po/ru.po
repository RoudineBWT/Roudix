#: roudix-welcome.py
msgid "Software Store"
msgstr "Магазин приложений"

#: roudix-welcome.py
msgid "Install nixpkgs and Flatpak apps"
msgstr "Установка приложений nixpkgs и Flatpak"

#: roudix-welcome.py
msgid "Customizer"
msgstr "Настройка"

#: roudix-welcome.py
msgid "Desktop, shell, apps and system tweaks"
msgstr "Рабочий стол, оболочка, приложения и системные параметры"

#: roudix-welcome.py
msgid "Kernel Switcher"
msgstr "Выбор ядра"

#: roudix-welcome.py
msgid "Pick your CachyOS kernel variant"
msgstr "Выберите вариант ядра CachyOS"

#: roudix-welcome.py
msgid "SCX Scheduler"
msgstr "Планировщик SCX"

#: roudix-welcome.py
msgid "Choose and apply an SCX scheduler"
msgstr "Выберите и примените планировщик SCX"

#: roudix-welcome.py
msgid "Welcome to Roudix"
msgstr "Добро пожаловать в Roudix"

#: roudix-welcome.py
msgid "<span size='small'>Roudix is your personal NixOS distribution: Wayland compositors (Niri, Hyprland, MangoWC, Umbriel), GNOME and KDE, a CachyOS kernel, and a bunch of tweaks built for you — and for the family and friends you share it with. Use the shortcuts below to customize your system, switch kernel and scheduler, or install apps from the store.</span>"
msgstr "<span size='small'>Roudix — ваш личный дистрибутив NixOS: Wayland-композиторы (Niri, Hyprland, MangoWC, Umbriel), GNOME и KDE, ядро CachyOS и множество настроек, созданных для вас — и для семьи и друзей, с которыми вы им делитесь. Используйте ярлыки ниже, чтобы настроить систему, сменить ядро и планировщик или установить приложения из магазина.</span>"

#: roudix-welcome.py
msgid "Roudix Apps"
msgstr "Приложения Roudix"

#: roudix-welcome.py
msgid "Open"
msgstr "Открыть"

#: roudix-welcome.py
msgid "Resources"
msgstr "Ресурсы"

#: roudix-welcome.py
msgid "Source code & documentation"
msgstr "Исходный код и документация"

#: roudix-welcome.py
msgid "Show at startup"
msgstr "Показывать при запуске"

#: roudix-welcome.py
msgid "Show this window again on every login"
msgstr "Показывать это окно при каждом входе в систему"

#: roudix-welcome.py
msgid "Close"
msgstr "Закрыть"
