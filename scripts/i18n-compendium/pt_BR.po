# Shared translation memory for scripts/i18n.sh (msgmerge --compendium).
# `update` fills any still-untranslated message of every component from here,
# so a new string only needs its translation added once, in this file.
# Existing translations in po/*.po are never overwritten.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"

msgid "Vesktop (standalone Vencord)"
msgstr "Vesktop (Vencord independente)"

msgid "Standalone Vencord client, native Wayland"
msgstr "Cliente Vencord independente, Wayland nativo"

msgid "Roudix — logo, gentle pulse (default)"
msgstr "Roudix — logo com pulsação suave (padrão)"

msgid "Roudix Spin — logo turning slowly"
msgstr "Roudix Spin — logo girando lentamente"

msgid "Roudix Gradient — warm gradient, glow behind the logo"
msgstr "Roudix Gradient — gradiente quente com brilho atrás do logo"

msgid "Roudix Ember — rising embers, progress ring"
msgstr "Roudix Ember — brasas subindo, anel de progresso"

msgid "Pandoudix — the mascot"
msgstr "Pandoudix — o mascote"

msgid "No splash — plain text boot"
msgstr "Sem tela de boot — boot em texto simples"

msgid "LibreOffice (Writer, Calc, Impress)"
msgstr "LibreOffice (Writer, Calc, Impress)"

msgid "ONLYOFFICE (Word-style editors, .docx / .xlsx / .pptx)"
msgstr "ONLYOFFICE (editores no estilo Word, .docx / .xlsx / .pptx)"

msgid "Open kernel modules"
msgstr "Módulos de kernel abertos"

msgid "RTX 20xx and newer. Turn off for GTX 10xx / 16xx cards."
msgstr "RTX 20xx e mais recentes. Desative para placas GTX 10xx / 16xx."

msgid "Boot splash"
msgstr "Tela de boot"

msgid "Office suite"
msgstr "Suíte de escritório"

msgid "Office dictionaries (comma-separated: en, fr, es, de, it, pt)"
msgstr "Dicionários da suíte de escritório (separados por vírgulas: en, fr, es, de, it, pt)"

msgid "Printing (CUPS)"
msgstr "Impressão (CUPS)"

msgid "Common printer drivers and network printer discovery."
msgstr "Drivers de impressora comuns e descoberta de impressoras de rede."

msgid "Scanners (SANE)"
msgstr "Scanners (SANE)"

msgid "OpenVPN (NetworkManager plugin)"
msgstr "OpenVPN (plugin do NetworkManager)"

msgid "GOverlay (GUI to configure MangoHud / vkBasalt)"
msgstr "GOverlay (interface para configurar MangoHud / vkBasalt)"

msgid "Oversteer (racing wheel configuration)"
msgstr "Oversteer (configuração de volantes de corrida)"

msgid "Writer, Calc, Impress"
msgstr "Writer, Calc, Impress"

msgid "Word-style editors built around .docx / .xlsx / .pptx"
msgstr "Editores no estilo Word, criados em torno de .docx / .xlsx / .pptx"

msgid "Don't install an office suite"
msgstr "Não instalar uma suíte de escritório"

msgid "English"
msgstr "Inglês"

msgid "French"
msgstr "Francês"

msgid "Spanish"
msgstr "Espanhol"

msgid "German"
msgstr "Alemão"

msgid "Italian"
msgstr "Italiano"

msgid "Portuguese"
msgstr "Português"

msgid "Create the sbctl keys at install time if missing (enrolling them stays manual)"
msgstr "Criar as chaves do sbctl na instalação, se faltarem (registrá-las continua manual)"

msgid "List “NixOS EAC” in the firmware boot menu (otherwise: sudo eac-reboot)"
msgstr "Listar “NixOS EAC” no menu de boot do firmware (caso contrário: sudo eac-reboot)"

msgid "Open kernel modules (RTX 20xx and newer — turn off for GTX 10xx/16xx)"
msgstr "Módulos de kernel abertos (RTX 20xx e mais recentes — desative para GTX 10xx/16xx)"

msgid "Boot splash (Plymouth) — off = plain text boot"
msgstr "Tela de boot (Plymouth) — desativada = boot em texto simples"

msgid "Hide kernel / initrd messages during boot (turn off to debug a boot problem)"
msgstr "Ocultar as mensagens do kernel / initrd durante o boot (desative para depurar um problema de boot)"

msgid "Best battery life (default) — disables tuned, so game-performance does nothing"
msgstr "Maior autonomia (padrão) — desativa o tuned, então o game-performance não faz nada"

msgid "Gaming laptop: keeps game-performance and the desktop power-mode selector"
msgstr "Notebook gamer: mantém o game-performance e o seletor de modo de energia da área de trabalho"

msgid "Printing (CUPS + network printers)"
msgstr "Impressão (CUPS + impressoras de rede)"

msgid "Scanners (SANE: network + HP)"
msgstr "Scanners (SANE: rede + HP)"

msgid "Monthly btrfs scrub"
msgstr "Scrub mensal do btrfs"

msgid "Kernel CVE mitigations (module blacklists)"
msgstr "Mitigações de CVE do kernel (listas de bloqueio de módulos)"

msgid "  ↳ Blacklist algif_aead (“Copy Fail”)"
msgstr "  ↳ Bloquear o algif_aead (“Copy Fail”)"

msgid "  ↳ Blacklist esp4/esp6/rxrpc (“Dirty Frag”) — turn off ONLY with IPsec or AFS/Kerberos"
msgstr "  ↳ Bloquear esp4/esp6/rxrpc (“Dirty Frag”) — desative SOMENTE com IPsec ou AFS/Kerberos"

msgid "Hibernation (needs swap, off by default)"
msgstr "Hibernação (requer swap, desativada por padrão)"

msgid "Office dictionaries"
msgstr "Dicionários da suíte de escritório"

msgid "Laptop power backend"
msgstr "Back-end de energia do notebook"

# --- installer terminal wizard (tui.py) ---
msgid "Other systems"
msgstr "Outros sistemas"

msgid "Found in the EFI NVRAM: switch on the ones to add to Limine's boot menu."
msgstr "Encontrados na NVRAM EFI: ative os que deseja adicionar ao menu de boot do Limine."

msgid "Only letters, digits and . _ + - : , @ / are allowed here."
msgstr "Aqui só são permitidos letras, dígitos e . _ + - : , @ /"

msgid "Allowed: {codes}"
msgstr "Permitido: {codes}"

msgid "Can't be empty."
msgstr "Não pode ficar vazio."

msgid "Gaming extras"
msgstr "Extras para jogos"

msgid "Features"
msgstr "Recursos"

msgid "Content-creation tools"
msgstr "Ferramentas de criação de conteúdo"

msgid "OBS plugins"
msgstr "Plugins do OBS"

msgid " or type to filter"
msgstr " ou digite para filtrar"

msgid "Choice"
msgstr "Escolha"

msgid "Choose one of the entries."
msgstr "Escolha uma das entradas."

msgid "Out of range."
msgstr "Fora do intervalo."

msgid "No match."
msgstr "Nenhuma correspondência."

msgctxt "yes/no prompt, yes is the default"
msgid "[Y/n]"
msgstr "[S/n]"

msgctxt "yes/no prompt, no is the default"
msgid "[y/N]"
msgstr "[s/N]"

msgid "Answer yes or no."
msgstr "Responda sim ou não."

msgid "Toggle: numbers separated by spaces, a = all, n = none, Enter = continue"
msgstr "Alternar: números separados por espaços, a = tudo, n = nada, Enter = continuar"

msgid "Administrator rights are needed and sudo is not available: run the installer as root."
msgstr "São necessárias permissões de administrador e o sudo não está disponível: execute o instalador como root."

msgid "Administrator rights are needed: enter your password if asked."
msgstr "São necessárias permissões de administrador: digite sua senha se solicitado."

msgid "No disk found."
msgstr "Nenhum disco encontrado."

msgid "File not found."
msgstr "Arquivo não encontrado."

msgid "Partition it yourself in another terminal (cfdisk, fdisk, parted…), then press Enter."
msgstr "Particione você mesmo em outro terminal (cfdisk, fdisk, parted…) e pressione Enter."

msgid "Other systems found in the EFI NVRAM — which ones do you want to add to Limine?"
msgstr "Outros sistemas encontrados na NVRAM EFI — quais você quer adicionar ao Limine?"

msgid "Edit the options"
msgstr "Editar as opções"

msgid "Quit"
msgstr "Sair"

msgid "What now?"
msgstr "E agora?"

msgid "Start now?"
msgstr "Começar agora?"

msgid "Interrupted — the installation may be incomplete."
msgstr "Interrompido — a instalação pode estar incompleta."

msgid "Aborted — nothing was changed."
msgstr "Cancelado — nada foi alterado."


# --- installer: temporary swap for nixos-install (swap.py / runner.py) ---
msgid "Low memory ({ram} GiB): adding {size} GiB of temporary swap on the target disk for the build…"
msgstr "Pouca memória ({ram} GiB): adicionando {size} GiB de swap temporário no disco de destino para a compilação…"

msgid "Could not add temporary swap ({reason}) — the build may run out of memory."
msgstr "Não foi possível adicionar swap temporário ({reason}) — a compilação pode ficar sem memória."

msgid "not enough free space on the target disk"
msgstr "não há espaço livre suficiente no disco de destino"

# --- installer: zram during nixos-install ---
msgid "Compressed RAM swap (zram) enabled: {size} GiB."
msgstr "Swap comprimido na RAM (zram) ativado: {size} GiB."

msgid "Could not enable zram ({reason})."
msgstr "Não foi possível ativar o zram ({reason})."

msgid "Noctalia's native Wayland file manager"
msgstr "O gerenciador de arquivos Wayland nativo da Noctalia"

msgid "Luciole — Noctalia, native Wayland"
msgstr "Luciole — Noctalia, Wayland nativo"

msgid "Detected in your config"
msgstr "Detectado na sua configuração"

msgid "All options"
msgstr "Todas as opções"

msgid "Setting “{sid}” no longer exists in the compositor config: your value was removed."
msgstr "O ajuste “{sid}” não existe mais na configuração do compositor: seu valor foi removido."

msgid "Setting “{title}” changed type in the compositor config: your old value was removed."
msgstr "O ajuste “{title}” mudou de tipo na configuração do compositor: seu valor antigo foi removido."
