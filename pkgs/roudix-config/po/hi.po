#, python-brace-format
msgid "{k} reset — rebuild required."
msgstr "{k} रीसेट हुआ — rebuild आवश्यक है।"

#: roudix-config.py
#, python-brace-format
msgid "NOT saved — Nix error: {msg}"
msgstr "सहेजा नहीं गया — Nix त्रुटि: {msg}"

#: roudix-config.py
#, python-brace-format
msgid "{name} saved ({msg}). Previous version: {name}.bak — rebuild required."
msgstr ""
"{name} सहेजा गया ({msg})। पिछला संस्करण: {name}.bak — rebuild आवश्यक है।"

#: roudix-config.py
#, python-brace-format
msgid "{title} saved — rebuild required (F5)."
msgstr "{title} सहेजा गया — rebuild आवश्यक है (F5)।"

#: roudix-config.py
msgid "Rebuild done ✔"
msgstr "Rebuild पूरा हुआ ✔"

#: roudix-config.py
#, python-brace-format
msgid "Rebuild failed ✘ (code {rc})"
msgstr "Rebuild विफल ✘ (कोड {rc})"

#: roudix-config.py
msgid "Press Enter to return to roudix-config… "
msgstr "roudix-config पर लौटने के लिए Enter दबाएँ… "

#: roudix-config.py
#, python-brace-format
msgid "Can't rebuild from the TUI ({e}): run the `rebuild` alias."
msgstr "TUI से rebuild नहीं हो सकता ({e}): `rebuild` alias चलाएँ।"

#: roudix-config.py
msgid ""
"Rebuild finished (see the terminal) — reload the compositor config if "
"needed."
msgstr ""
"Rebuild समाप्त (टर्मिनल देखें) — ज़रूरत हो तो कंपोज़िटर कॉन्फ़िग रीलोड करें।"

#: roudix-config.py
msgid "Configure Umbriel, Niri or MangoWC without writing Nix."
msgstr "Nix लिखे बिना Umbriel, Niri या MangoWC कॉन्फ़िगर करें।"

#: roudix-config.py
msgid "print the managed rules and exit"
msgstr "प्रबंधित नियम दिखाता है और बाहर निकलता है"

#: roudix-config.py
msgid "only create the -custom.nix file, then exit"
msgstr "केवल -custom.nix फ़ाइल बनाता है, फिर बाहर निकलता है"

#: roudix-config.py
