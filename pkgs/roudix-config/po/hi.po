msgid "value"
msgstr "मान"

#: roudix-config.py
#, python-brace-format
msgid "{label}: deleting a default shortcut is done in the File tab."
msgstr "{label}: डिफ़ॉल्ट शॉर्टकट हटाना “फ़ाइल” टैब में होता है।"

#: roudix-config.py
#, python-brace-format
msgid "{k} deleted — rebuild required."
msgstr "{k} हटाया गया — rebuild आवश्यक है।"

#: roudix-config.py
msgid "Setting restored — rebuild required (F5)."
msgstr "सेटिंग बहाल की गई — rebuild आवश्यक है (F5)।"

