msgstr "  ↳ Mettre algif_aead en liste noire (« Copy Fail »)"

msgid "  ↳ Blacklist esp4/esp6/rxrpc (“Dirty Frag”) — turn off ONLY with IPsec or AFS/Kerberos"
msgstr "  ↳ Mettre esp4/esp6/rxrpc en liste noire (« Dirty Frag ») — à désactiver UNIQUEMENT avec IPsec ou AFS/Kerberos"

