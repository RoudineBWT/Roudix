## _include-noctalia.nix — loads ~/.config/mango/noctalia.conf, regenerated by
## Noctalia's matugen template.
##
## Plain `source=` (not `source_optional=`) on purpose: Noctalia's mango
## template runs an apply.sh post_hook that appends `source=…noctalia.conf` to
## config.conf unless a line matching `source(-optional)?=…noctalia.conf` is
## already there — its regex does not know mango's real `source_optional`
## spelling, so it would try to edit config.conf (Home Manager read-only
## symlink). A required `source` errors on a missing file, hence the empty
## placeholder created at activation (Noctalia overwrites it on first theme).
{ config, lib, ... }:
let
  noctaliaConf = "${config.home.homeDirectory}/.config/mango/noctalia.conf";
in
{
  wayland.windowManager.mango.extraConfig = ''
    source=${noctaliaConf}
  '';

  home.activation.mangoNoctaliaPlaceholder = lib.hm.dag.entryAfter [ "writeBoundary" ] ''
    if [ ! -e "${noctaliaConf}" ]; then
      $DRY_RUN_CMD mkdir -p "$(dirname "${noctaliaConf}")"
      $DRY_RUN_CMD touch "${noctaliaConf}"
    fi
  '';
}
