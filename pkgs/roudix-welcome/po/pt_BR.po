#: roudix-welcome.py
msgid "Software Store"
msgstr "Loja de software"

#: roudix-welcome.py
msgid "Install nixpkgs and Flatpak apps"
msgstr "Instale aplicativos do nixpkgs e Flatpak"

#: roudix-welcome.py
msgid "Customizer"
msgstr "Personalizador"

#: roudix-welcome.py
msgid "Desktop, shell, apps and system tweaks"
msgstr "Desktop, shell, aplicativos e ajustes do sistema"

#: roudix-welcome.py
msgid "Kernel Switcher"
msgstr "Seletor de kernel"

#: roudix-welcome.py
msgid "Pick your CachyOS kernel variant"
msgstr "Escolha sua variante do kernel CachyOS"

#: roudix-welcome.py
msgid "SCX Scheduler"
msgstr "Agendador SCX"

#: roudix-welcome.py
msgid "Choose and apply an SCX scheduler"
msgstr "Escolha e aplique um agendador SCX"

#: roudix-welcome.py
msgid "Disks"
msgstr "Discos"

#: roudix-welcome.py
msgid "Mount, format and manage your extra disks"
msgstr "Monte, formate e gerencie seus discos extras"

#: roudix-welcome.py
msgid "Firewall"
msgstr "Firewall"

#: roudix-welcome.py
msgid "Open ports and trusted interfaces"
msgstr "Portas abertas e interfaces confiáveis"

#: roudix-welcome.py
msgid "Hardware Sync"
msgstr "Sincronização de hardware"

#: roudix-welcome.py
msgid "Changed PC? Update your CPU/GPU settings"
msgstr "Trocou de PC? Atualize suas configurações de CPU/GPU"

#: roudix-welcome.py
msgid "Compositor Config"
msgstr "Configuração do compositor"

#: roudix-welcome.py
msgid "Window rules, screens and shortcuts"
msgstr "Regras de janelas, telas e atalhos"

#: roudix-welcome.py
msgid "Documentation"
msgstr "Documentação"

#: roudix-welcome.py
msgid "Source code"
msgstr "Código-fonte"

#: roudix-welcome.py
msgid "Release notes"
msgstr "Notas de versão"

#: roudix-welcome.py
msgid "Report a bug"
msgstr "Relatar um bug"

#: roudix-welcome.py
msgid "YouTube"
msgstr "YouTube"

#: roudix-welcome.py
msgid "Discord"
msgstr "Discord"

#: roudix-welcome.py
msgid "Check for updates"
msgstr "Verificar atualizações"

#: roudix-welcome.py
msgid "See if new commits are available (nothing is changed)"
msgstr "Veja se há novos commits disponíveis (nada é alterado)"

#: roudix-welcome.py
msgid "Update system"
msgstr "Atualizar o sistema"

#: roudix-welcome.py
msgid "Pull, rebuild, switch and update Flatpaks (same as `update`)"
msgstr "Baixa, recompila, troca e atualiza os Flatpaks (igual a `update`)"

#: roudix-welcome.py
msgid ""
"Open a terminal and run the update? You will be asked for your password."
msgstr ""
"Abrir um terminal e executar a atualização? Sua senha será solicitada."

#: roudix-welcome.py
msgid "Apply configuration"
msgstr "Aplicar configuração"

#: roudix-welcome.py
msgid "Rebuild and switch now (same as `rebuild`)"
msgstr "Recompilar e trocar agora (igual a `rebuild`)"

#: roudix-welcome.py
msgid "Rebuild the system now? This can take a while."
msgstr "Recompilar o sistema agora? Isso pode demorar um pouco."

#: roudix-welcome.py
msgid "Clean old generations"
msgstr "Limpar gerações antigas"

#: roudix-welcome.py
msgid "Keep the last 3 generations, then garbage-collect (same as `cleanup`)"
msgstr ""
"Mantém as últimas 3 gerações e depois libera espaço (igual a `cleanup`)"

#: roudix-welcome.py
msgid ""
"Remove old system generations? You will not be able to roll back to them."
msgstr ""
"Remover as gerações antigas do sistema? Você não poderá voltar a elas."

#: roudix-welcome.py
msgid "Show last update log"
msgstr "Mostrar o último log de atualização"

#: roudix-welcome.py
msgid "Output of the last run of `update`"
msgstr "Saída da última execução de `update`"

#: roudix-welcome.py
msgid "Press Enter to close…"
msgstr "Pressione Enter para fechar…"

#: roudix-welcome.py
msgid "Close"
msgstr "Fechar"

#: roudix-welcome.py
msgid "Running…"
msgstr "Executando…"

#: roudix-welcome.py
#, python-brace-format
msgid "ERROR: '{cmd}' not found in PATH."
msgstr "ERRO: '{cmd}' não encontrado no PATH."

#: roudix-welcome.py
#, python-brace-format
msgid "ERROR: {error}"
msgstr "ERRO: {error}"

#: roudix-welcome.py
msgid "✓ Done"
msgstr "✓ Concluído"

#: roudix-welcome.py
#, python-brace-format
msgid "✗ Failed (exit code {rc})"
msgstr "✗ Falhou (código de saída {rc})"

#: roudix-welcome.py
msgid "Welcome to Roudix"
msgstr "Bem-vindo ao Roudix"

#: roudix-welcome.py
msgid "Welcome"
msgstr "Boas-vindas"

#: roudix-welcome.py
msgid "Tweaks"
msgstr "Ajustes"

#: roudix-welcome.py
msgid "Your NixOS, your way — shared with the people you care about."
msgstr "Seu NixOS, do seu jeito — compartilhado com quem você ama."

#: roudix-welcome.py
msgid "System tools"
msgstr "Ferramentas do sistema"

#: roudix-welcome.py
msgid "Resources"
msgstr "Recursos"

#: roudix-welcome.py
msgid "Show at startup"
msgstr "Mostrar ao iniciar"

#: roudix-welcome.py
msgid "Show this window again on every login"
msgstr "Mostrar esta janela novamente a cada login"

#: roudix-welcome.py
msgid "Maintenance"
msgstr "Manutenção"

#: roudix-welcome.py
msgid "Common system tasks, one click away."
msgstr "Tarefas comuns do sistema, a um clique."

#: roudix-welcome.py
msgid "Run"
msgstr "Executar"

#: roudix-welcome.py
msgid "Configuration"
msgstr "Configuração"

#: roudix-welcome.py
msgid "Open configuration folder"
msgstr "Abrir a pasta de configuração"

#: roudix-welcome.py
msgid "Cancel"
msgstr "Cancelar"

#: roudix-welcome.py
msgid "No terminal found"
msgstr "Nenhum terminal encontrado"

#: roudix-welcome.py
msgid "Open a terminal yourself and run `update`."
msgstr "Abra um terminal você mesmo e execute `update`."

#~ msgid ""
#~ "<span size='small'>Roudix is your personal NixOS distribution: Wayland "
#~ "compositors (Niri, Hyprland, MangoWC, Umbriel), GNOME and KDE, a CachyOS "
#~ "kernel, and a bunch of tweaks built for you — and for the family and friends"
#~ " you share it with. Use the shortcuts below to customize your system, switch"
#~ " kernel and scheduler, or install apps from the store.</span>"
#~ msgstr ""
#~ "<span size='small'>O Roudix é a sua distribuição NixOS pessoal: compositores"
#~ " Wayland (Niri, Hyprland, MangoWC, Umbriel), GNOME e KDE, um kernel CachyOS "
#~ "e vários ajustes feitos para você — e para a família e os amigos com quem "
#~ "você a compartilha. Use os atalhos abaixo para personalizar o sistema, "
#~ "trocar de kernel e de agendador ou instalar aplicativos pela loja.</span>"

#~ msgid "Roudix Apps"
#~ msgstr "Aplicativos do Roudix"

#~ msgid "Open"
#~ msgstr "Abrir"
