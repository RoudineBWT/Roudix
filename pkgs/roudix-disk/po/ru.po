#: roudix-disk.py
msgid "Unbalanced braces in the configuration file."
msgstr "Несбалансированные скобки в файле конфигурации."

#: roudix-disk.py
msgid ""
"This file uses the `fileSystems = { … }` form, which roudix-disk does not "
"edit."
msgstr "Этот файл использует форму `fileSystems = { … }`, которую roudix-disk не редактирует."

#: roudix-disk.py
msgid "Two entries share the same mount point."
msgstr "Две записи используют одну и ту же точку монтирования."

#: roudix-disk.py
msgid "The configuration file does not end with a closing brace."
msgstr "Файл конфигурации не заканчивается закрывающей скобкой."

#: roudix-disk.py
msgid "Use an absolute path with letters, digits and . _ - @ + only."
msgstr "Используйте абсолютный путь только из букв, цифр и символов . _ - @ +"

#: roudix-disk.py
msgid "No trailing slash."
msgstr "Без косой черты в конце."

#: roudix-disk.py
msgid "Use a clean path (no //, . or ..)."
msgstr "Используйте чистый путь (без //, . и ..)."

#: roudix-disk.py
msgid "This mount point belongs to the system."
msgstr "Эта точка монтирования принадлежит системе."

#: roudix-disk.py
msgid "Mounting here could break the system."
msgstr "Монтирование сюда может нарушить работу системы."

#: roudix-disk.py
msgid "This mount point is already used."
msgstr "Эта точка монтирования уже используется."

#: roudix-disk.py
msgid "Generated file is not valid Nix:"
msgstr "Сгенерированный файл не является корректным Nix:"

#: roudix-disk.py
msgid "Close"
msgstr "Закрыть"

#: roudix-disk.py
msgid "Done."
msgstr "Готово."

#: roudix-disk.py
#, python-brace-format
msgid "Failed (exit code {rc})."
msgstr "Ошибка (код выхода {rc})."

#: roudix-disk.py
msgid "Roudix Disks"
msgstr "Диски Roudix"

#: roudix-disk.py
msgid "Rescan disks"
msgstr "Пересканировать диски"

#: roudix-disk.py
msgid "Apply…"
msgstr "Применить…"

#: roudix-disk.py
msgid "Changes not applied yet"
msgstr "Изменения ещё не применены"

#: roudix-disk.py
msgid "Remove"
msgstr "Убрать"

#: roudix-disk.py
msgid "Dismiss"
msgstr "Скрыть"

#: roudix-disk.py
msgid "Configuration not found"
msgstr "Конфигурация не найдена"

#: roudix-disk.py
#, python-brace-format
msgid ""
"Could not find {file}. Set ROUDIX_HOST or NH_FLAKE if your configuration "
"lives elsewhere."
msgstr "Не удалось найти {file}. Задайте ROUDIX_HOST или NH_FLAKE, если ваша конфигурация находится в другом месте."

#: roudix-disk.py
msgid "This configuration can't be edited here"
msgstr "Эту конфигурацию нельзя изменить здесь"

#: roudix-disk.py
#, python-brace-format
msgid "Could not list disks: {err}"
msgstr "Не удалось получить список дисков: {err}"

#: roudix-disk.py
#, python-brace-format
msgid "{n} configured disk is not connected"
msgid_plural "{n} configured disks are not connected"
msgstr[0] "{n} настроенный диск не подключён"
msgstr[1] "{n} настроенных диска не подключены"
msgstr[2] "{n} настроенных дисков не подключены"

#: roudix-disk.py
msgid "No disks found"
msgstr "Диски не найдены"

#: roudix-disk.py
msgid "removable"
msgstr "съёмный"

#: roudix-disk.py
msgid "Unknown disk"
msgstr "Неизвестный диск"

#: roudix-disk.py
msgid "Format…"
msgstr "Форматировать…"

#: roudix-disk.py
msgid "Mounted — unmount it first"
msgstr "Смонтирован — сначала отмонтируйте его"

#: roudix-disk.py
msgid "Empty disk"
msgstr "Пустой диск"

#: roudix-disk.py
msgid "No partition table or filesystem. Use Format… to prepare it."
msgstr "Нет ни таблицы разделов, ни файловой системы. Используйте «Форматировать…», чтобы подготовить его."

#: roudix-disk.py
msgid "unknown filesystem"
msgstr "неизвестная файловая система"

#: roudix-disk.py
#, python-brace-format
msgid "mounted at {mp}"
msgstr "смонтирован в {mp}"

#: roudix-disk.py
msgid "System"
msgstr "Система"

#: roudix-disk.py
msgid "Change mount point"
msgstr "Изменить точку монтирования"

#: roudix-disk.py
msgid "Remove mount point"
msgstr "Убрать точку монтирования"

#: roudix-disk.py
msgid "Mount…"
msgstr "Смонтировать…"

#: roudix-disk.py
msgid "Not supported"
msgstr "Не поддерживается"

#: roudix-disk.py
msgid "Mount point"
msgstr "Точка монтирования"

#: roudix-disk.py
#, python-brace-format
msgid "Where should {device} be mounted?"
msgstr "Куда смонтировать {device}?"

#: roudix-disk.py
msgid "Cancel"
msgstr "Отмена"

#: roudix-disk.py
msgid "Save"
msgstr "Сохранить"

#: roudix-disk.py
msgid "This disk is in use and can't be formatted."
msgstr "Этот диск используется и не может быть отформатирован."

#: roudix-disk.py
#, python-brace-format
msgid "Format {device}?"
msgstr "Форматировать {device}?"

#: roudix-disk.py
#, python-brace-format
msgid ""
"All data on {device} ({model}, {size}) will be permanently erased and "
"replaced by a single GPT partition."
msgstr "Все данные на {device} ({model}, {size}) будут безвозвратно удалены и заменены одним разделом GPT."

#: roudix-disk.py
msgid "Filesystem"
msgstr "Файловая система"

#: roudix-disk.py
msgid "Label"
msgstr "Метка"

#: roudix-disk.py
#, python-brace-format
msgid "Type {device} to confirm"
msgstr "Введите {device} для подтверждения"

#: roudix-disk.py
msgid "Erase and format"
msgstr "Стереть и форматировать"

#: roudix-disk.py
msgid "Label: 1–16 characters, letters, digits . _ - only."
msgstr "Метка: от 1 до 16 символов, только буквы, цифры и . _ -"

#: roudix-disk.py
msgid "Authentication cancelled."
msgstr "Аутентификация отменена."

#: roudix-disk.py
msgid "Formatting failed — see the log."
msgstr "Не удалось выполнить форматирование — см. журнал."

#: roudix-disk.py
#, python-brace-format
msgid "{device} formatted."
msgstr "{device} отформатирован."

#: roudix-disk.py
#, python-brace-format
msgid "Formatting {device}…"
msgstr "Форматирование {device}…"

#: roudix-disk.py
msgid "Apply changes?"
msgstr "Применить изменения?"

#: roudix-disk.py
#, python-brace-format
msgid ""
"{file} will be updated and Roudix rebuilt. The current file is backed up "
"first, and restored if the rebuild fails."
msgstr "{file} будет обновлён, а Roudix пересобран. Текущий файл сначала сохраняется в резервную копию и восстанавливается, если пересборка не удалась."

#: roudix-disk.py
msgid "At next boot"
msgstr "При следующей загрузке"

#: roudix-disk.py
msgid "Apply now"
msgstr "Применить сейчас"

#: roudix-disk.py
msgid "Changes applied."
msgstr "Изменения применены."

#: roudix-disk.py
#, python-brace-format
msgid "Rebuild failed and the backup could not be restored: {err}"
msgstr "Пересборка не удалась, и резервную копию восстановить не удалось: {err}"

#: roudix-disk.py
msgid "Authentication cancelled — nothing was changed."
msgstr "Аутентификация отменена — ничего не изменено."

#: roudix-disk.py
msgid ""
"Rebuild failed — the previous configuration was restored. Your edits are "
"still here."
msgstr "Пересборка не удалась — предыдущая конфигурация восстановлена. Ваши изменения по-прежнему здесь."

#: roudix-disk.py
msgid "Rebuilding Roudix…"
msgstr "Пересборка Roudix…"
