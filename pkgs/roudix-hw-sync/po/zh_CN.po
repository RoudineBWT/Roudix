msgstr ""
"Project-Id-Version: roudix-hw-sync\n"
"Report-Msgid-Bugs-To: \n"
"PO-Revision-Date: 2026-10-23 00:00+0000\n"
"Last-Translator: Claude\n"
"Language-Team: Simplified Chinese\n"
"Language: zh_CN\n"
"MIME-Version: 1.0\n"
