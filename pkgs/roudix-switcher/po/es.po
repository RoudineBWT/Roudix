msgstr "No hay incidencias reportadas actualmente."

#: roudix-switcher.py
msgid "Running"
msgstr "En ejecución"

#: roudix-switcher.py
msgid "Checking repositories..."
msgstr "Comprobando repositorios..."

#: roudix-switcher.py
#, python-brace-format
msgid "Switching to branch {new_branch}…"
msgstr "Cambiando a la rama {new_branch}…"

#: roudix-switcher.py
#, python-brace-format
msgid "✗ Could not switch to {new_branch}: {msg}"
msgstr "✗ No se pudo cambiar a {new_branch}: {msg}"

#: roudix-switcher.py
#, python-brace-format
msgid "<span color='red'>✗ Branch switch failed — nothing was changed. {markup_escape_text}</span>"
msgstr "<span color='red'>✗ Falló el cambio de rama — no se modificó nada. {markup_escape_text}</span>"

#: roudix-switcher.py
#, python-brace-format
msgid "✓ Repository on branch {new_branch}."
msgstr "✓ Repositorio en la rama {new_branch}."

#: roudix-switcher.py
#, python-brace-format
msgid "⚠ Branch not written to local.nix: {res}"
msgstr "⚠ Rama no escrita en local.nix: {res}"

#: roudix-switcher.py
msgid "✓ Rebuild completed and applied to your running session."
msgstr "✓ Reconstrucción completada y aplicada a tu sesión en ejecución."

#: roudix-switcher.py
msgid "<span color='green'>✓ Done! Applied now — some things (desktop/shell) may still need a logout to fully take effect.</span>"
msgstr "<span color='green'>✓ ¡Listo! Aplicado ahora — algunas cosas (escritorio/shell) pueden requerir cerrar la sesión para surtir efecto del todo.</span>"

#: roudix-switcher.py
msgid "✓ Rebuild completed successfully. Reboot to apply changes."
msgstr "✓ Reconstrucción completada correctamente. Reinicia para aplicar los cambios."

#: roudix-switcher.py
msgid "<span color='green'>✓ Done! Reboot to apply changes.</span>"
msgstr "<span color='green'>✓ ¡Listo! Reinicia para aplicar los cambios.</span>"

