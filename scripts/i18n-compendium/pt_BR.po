msgstr "GOverlay (interface para configurar MangoHud / vkBasalt)"

msgid "Oversteer (racing wheel configuration)"
msgstr "Oversteer (configuração de volantes de corrida)"

msgid "Writer, Calc, Impress"
msgstr "Writer, Calc, Impress"

msgid "Word-style editors built around .docx / .xlsx / .pptx"
msgstr "Editores no estilo Word, criados em torno de .docx / .xlsx / .pptx"

msgid "Don't install an office suite"
msgstr "Não instalar uma suíte de escritório"

