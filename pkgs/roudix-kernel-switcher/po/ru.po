#: roudix-kernel-switcher.py
msgid "linux-zen — mainline nixpkgs kernel, cached on cache.nixos.org, independent of the xddxdd overlay"
msgstr "linux-zen — mainline-ядро из nixpkgs, есть в кэше cache.nixos.org, не зависит от оверлея xddxdd"

#: roudix-kernel-switcher.py
msgid "linux LTS — nixpkgs default kernel, cached on cache.nixos.org"
msgstr "linux LTS — ядро nixpkgs по умолчанию, есть в кэше cache.nixos.org"

#: roudix-kernel-switcher.py
msgid "linux latest — newest mainline stable, cached on cache.nixos.org"
msgstr "linux latest — новейшая стабильная mainline-версия, есть в кэше cache.nixos.org"

#: roudix-kernel-switcher.py
msgid "linux_testing — mainline RC/testing kernel, cached on cache.nixos.org"
msgstr "linux_testing — тестовое mainline-ядро (RC), есть в кэше cache.nixos.org"

#: roudix-kernel-switcher.py
msgid "XanMod LTS — nixpkgs, performance governor + lazy preemption + BBRv3"
msgstr "XanMod LTS — nixpkgs, governor performance + lazy preemption + BBRv3"

#: roudix-kernel-switcher.py
msgid "XanMod main branch — nixpkgs, newest XanMod"
msgstr "Основная ветка XanMod — nixpkgs, самая новая версия XanMod"

#: roudix-kernel-switcher.py
msgid "Standard latest"
msgstr "Стандартное, последнее"

#: roudix-kernel-switcher.py
msgid "x86_64-v3  —  recommended for modern CPUs"
msgstr "x86_64-v3  —  рекомендуется для современных CPU"

#: roudix-kernel-switcher.py
msgid "AMD Zen 4 optimised"
msgstr "Оптимизировано для AMD Zen 4"

#: roudix-kernel-switcher.py
msgid "LTO + v3  —  best perf on modern CPUs"
msgstr "LTO + v3  —  лучшая производительность на современных CPU"

#: roudix-kernel-switcher.py
msgid "Long-term support"
msgstr "Долгосрочная поддержка"

#: roudix-kernel-switcher.py
msgid "LTS + LTO + v3  —  stable + performance"
msgstr "LTS + LTO + v3  —  стабильность + производительность"

#: roudix-kernel-switcher.py
msgid "BORE scheduler"
msgstr "Планировщик BORE"

#: roudix-kernel-switcher.py
msgid "BMQ scheduler"
msgstr "Планировщик BMQ"

#: roudix-kernel-switcher.py
msgid "EEVDF scheduler"
msgstr "Планировщик EEVDF"

#: roudix-kernel-switcher.py
msgid "Security hardened"
msgstr "Усиленная безопасность"

#: roudix-kernel-switcher.py
msgid "Hardened + LTO"
msgstr "Усиленная + LTO"

#: roudix-kernel-switcher.py
msgid "Real-time + BORE"
msgstr "Реальное время + BORE"

#: roudix-kernel-switcher.py
msgid "Real-time + BORE + LTO"
msgstr "Реальное время + BORE + LTO"

#: roudix-kernel-switcher.py
msgid "Steam Deck optimised"
msgstr "Оптимизировано для Steam Deck"

#: roudix-kernel-switcher.py
msgid "Server optimised"
msgstr "Оптимизировано для серверов"

#: roudix-kernel-switcher.py
msgid "Server + LTO"
msgstr "Сервер + LTO"

#: roudix-kernel-switcher.py
msgid "Release candidate  —  unstable"
msgstr "Релиз-кандидат  —  нестабильно"

#: roudix-kernel-switcher.py
msgid "linux-zen — nvidia module cached only with the open driver; closed driver compiles locally on every bump"
msgstr "linux-zen — модуль nvidia есть в кэше только для открытого драйвера; закрытый драйвер собирается локально при каждом обновлении"

#: roudix-kernel-switcher.py
msgid "linux LTS — same nvidia module caveat as zen"
msgstr "linux LTS — то же ограничение модуля nvidia, что и у zen"

#: roudix-kernel-switcher.py
msgid "linux latest — same nvidia module caveat as zen"
msgstr "linux latest — то же ограничение модуля nvidia, что и у zen"

#: roudix-kernel-switcher.py
msgid "linux_testing — mainline RC/testing kernel, same nvidia module caveat as zen"
msgstr "linux_testing — тестовое mainline-ядро (RC), то же ограничение модуля nvidia, что и у zen"

#: roudix-kernel-switcher.py
msgid "XanMod LTS — same nvidia module caveat as zen"
msgstr "XanMod LTS — то же ограничение модуля nvidia, что и у zen"

#: roudix-kernel-switcher.py
msgid "XanMod main branch — same nvidia module caveat as zen"
msgstr "Основная ветка XanMod — то же ограничение модуля nvidia, что и у zen"

#: roudix-kernel-switcher.py
msgid "Default  —  LTO + BORE, ships nvidia_cachyos"
msgstr "По умолчанию  —  LTO + BORE, включает nvidia_cachyos"

#: roudix-kernel-switcher.py
msgid "Server optimised  —  no desktop tuning"
msgstr "Оптимизировано для серверов  —  без настроек для рабочего стола"

#. TRANSLATORS: Heading above a list of kernels ("latest kernels").
#: roudix-kernel-switcher.py
msgid "Latest"
msgstr "Свежие"

#. TRANSLATORS: Heading above a list of kernel variants.
#: roudix-kernel-switcher.py
msgid "Variants"
msgstr "Варианты"

#: roudix-kernel-switcher.py
msgid "Chaotic-Nyx (GPU: nvidia)"
msgstr "Chaotic-Nyx (GPU: nvidia)"

#: roudix-kernel-switcher.py
#, python-brace-format
msgid "Kernel source: {source}"
msgstr "Источник ядра: {source}"

#: roudix-kernel-switcher.py
msgid "Nvidia GPU detected — only Chaotic-Nyx variants are shown, so nvidia_cachyos (precompiled driver) stays matched to your kernel."
msgstr "Обнаружена видеокарта Nvidia — показаны только варианты Chaotic-Nyx, чтобы nvidia_cachyos (предсобранный драйвер) оставался совместимым с вашим ядром."

#: roudix-kernel-switcher.py
msgid "Active kernel"
msgstr "Активное ядро"

#: roudix-kernel-switcher.py
msgid "Select a kernel variant above."
msgstr "Выберите вариант ядра выше."

#: roudix-kernel-switcher.py
msgid "Apply & Rebuild"
msgstr "Применить и пересобрать"

#: roudix-kernel-switcher.py
#, python-brace-format
msgid "Will switch to: {variant}"
msgstr "Будет выбрано: {variant}"

#: roudix-kernel-switcher.py
msgid "Already the active kernel."
msgstr "Это ядро уже активно."

#: roudix-kernel-switcher.py
msgid "Apply changes?"
msgstr "Применить изменения?"

#. TRANSLATORS: Pango markup: keep the <b> tags and the {placeholders}.
#: roudix-kernel-switcher.py
#, python-brace-format
msgid "Kernel: <b>{current}</b> → <b>{selected}</b>"
msgstr "Ядро: <b>{current}</b> → <b>{selected}</b>"

#: roudix-kernel-switcher.py
msgid "Your NixOS configuration will be rebuilt. This may take a few minutes."
msgstr "Конфигурация NixOS будет пересобрана. Это может занять несколько минут."

#: roudix-kernel-switcher.py
msgid "Cancel"
msgstr "Отмена"

#: roudix-kernel-switcher.py
#, python-brace-format
msgid "✗ Error writing config: {error}"
msgstr "✗ Ошибка записи конфигурации: {error}"

#: roudix-kernel-switcher.py
msgid "Building…"
msgstr "Сборка…"

#: roudix-kernel-switcher.py
msgid "Important Notices:"
msgstr "Важные уведомления:"

#: roudix-kernel-switcher.py
msgid "No issues currently reported."
msgstr "Сейчас о проблемах не сообщается."

#: roudix-kernel-switcher.py
#, python-brace-format
msgid "Running: {cmd}"
msgstr "Выполняется: {cmd}"

#: roudix-kernel-switcher.py
msgid "Checking repositories..."
msgstr "Проверка репозиториев..."

#: roudix-kernel-switcher.py
msgid "ERROR: 'nh' not found in PATH."
msgstr "ОШИБКА: «nh» не найден в PATH."

#: roudix-kernel-switcher.py
#, python-brace-format
msgid "ERROR: {error}"
msgstr "ОШИБКА: {error}"

#: roudix-kernel-switcher.py
#, python-brace-format
msgid "✓ Done — reboot to apply {kernel}."
msgstr "✓ Готово — перезагрузите компьютер, чтобы применить {kernel}."

#: roudix-kernel-switcher.py
msgid "✓ Rebuild completed successfully. Reboot to apply changes."
msgstr "✓ Пересборка успешно завершена. Перезагрузите компьютер, чтобы применить изменения."

#: roudix-kernel-switcher.py
#, python-brace-format
msgid "✗ Build failed (exit {rc}). See log."
msgstr "✗ Сборка не удалась (код {rc}). См. журнал."

#: roudix-kernel-switcher.py
#, python-brace-format
msgid "✗ Rebuild failed (exit code {rc})."
msgstr "✗ Пересборка не удалась (код завершения {rc})."

