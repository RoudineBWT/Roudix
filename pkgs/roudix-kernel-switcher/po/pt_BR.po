#: roudix-kernel-switcher.py
msgid "linux-zen — mainline nixpkgs kernel, cached on cache.nixos.org, independent of the xddxdd overlay"
msgstr "linux-zen — kernel mainline do nixpkgs, em cache no cache.nixos.org, independente do overlay xddxdd"

#: roudix-kernel-switcher.py
msgid "linux LTS — nixpkgs default kernel, cached on cache.nixos.org"
msgstr "linux LTS — kernel padrão do nixpkgs, em cache no cache.nixos.org"

#: roudix-kernel-switcher.py
msgid "linux latest — newest mainline stable, cached on cache.nixos.org"
msgstr "linux latest — a versão estável mainline mais recente, em cache no cache.nixos.org"

#: roudix-kernel-switcher.py
msgid "linux_testing — mainline RC/testing kernel, cached on cache.nixos.org"
msgstr "linux_testing — kernel mainline RC/de teste, em cache no cache.nixos.org"

#: roudix-kernel-switcher.py
msgid "XanMod LTS — nixpkgs, performance governor + lazy preemption + BBRv3"
msgstr "XanMod LTS — nixpkgs, governador performance + preempção preguiçosa + BBRv3"

#: roudix-kernel-switcher.py
msgid "XanMod main branch — nixpkgs, newest XanMod"
msgstr "Ramo principal do XanMod — nixpkgs, o XanMod mais recente"

#: roudix-kernel-switcher.py
msgid "Standard latest"
msgstr "Padrão, a mais recente"

#: roudix-kernel-switcher.py
msgid "x86_64-v3  —  recommended for modern CPUs"
msgstr "x86_64-v3  —  recomendado para CPUs modernas"

#: roudix-kernel-switcher.py
msgid "AMD Zen 4 optimised"
msgstr "Otimizado para AMD Zen 4"

#: roudix-kernel-switcher.py
