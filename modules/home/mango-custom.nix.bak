      "SUPER,9,view,9",
      "SUPER+CTRL,1,tag,1",
      "SUPER+CTRL,2,tag,2",
      "SUPER+CTRL,3,tag,3",
      "SUPER+CTRL,4,tag,4",
      "SUPER+CTRL,5,tag,5",
      "SUPER+CTRL,6,tag,6",
      "SUPER+CTRL,7,tag,7",
      "SUPER+CTRL,8,tag,8",
      "SUPER+CTRL,9,tag,9",
