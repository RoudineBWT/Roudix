#: roudix-welcome.py
msgid "Software Store"
msgstr "متجر البرامج"

#: roudix-welcome.py
msgid "Install nixpkgs and Flatpak apps"
msgstr "ثبّت تطبيقات nixpkgs وFlatpak"

#: roudix-welcome.py
msgid "Customizer"
msgstr "أداة التخصيص"

#: roudix-welcome.py
msgid "Desktop, shell, apps and system tweaks"
msgstr "سطح المكتب والواجهة والتطبيقات وتعديلات النظام"

#: roudix-welcome.py
msgid "Kernel Switcher"
msgstr "مبدّل النواة"

#: roudix-welcome.py
msgid "Pick your CachyOS kernel variant"
msgstr "اختر نسخة نواة CachyOS"

#: roudix-welcome.py
msgid "SCX Scheduler"
msgstr "مجدول SCX"

#: roudix-welcome.py
msgid "Choose and apply an SCX scheduler"
msgstr "اختر مجدول SCX وطبّقه"

#: roudix-welcome.py
msgid "Disks"
msgstr "الأقراص"

#: roudix-welcome.py
msgid "Mount, format and manage your extra disks"
msgstr "ركّب أقراصك الإضافية وهيّئها وأدرها"

#: roudix-welcome.py
msgid "Firewall"
msgstr "جدار الحماية"

#: roudix-welcome.py
msgid "Open ports and trusted interfaces"
msgstr "المنافذ المفتوحة والواجهات الموثوقة"

#: roudix-welcome.py
msgid "Hardware Sync"
msgstr "مزامنة العتاد"

#: roudix-welcome.py
msgid "Changed PC? Update your CPU/GPU settings"
msgstr "غيّرت جهازك؟ حدّث إعدادات المعالج/كرت الشاشة"

#: roudix-welcome.py
msgid "Compositor Config"
msgstr "إعدادات المُركِّب"

#: roudix-welcome.py
msgid "Window rules, screens and shortcuts"
msgstr "قواعد النوافذ والشاشات والاختصارات"

#: roudix-welcome.py
msgid "Documentation"
msgstr "التوثيق"

#: roudix-welcome.py
msgid "Source code"
msgstr "الشيفرة المصدرية"

#: roudix-welcome.py
msgid "Release notes"
msgstr "ملاحظات الإصدار"

#: roudix-welcome.py
msgid "Report a bug"
msgstr "الإبلاغ عن خطأ"

#: roudix-welcome.py
msgid "YouTube"
msgstr "YouTube"

#: roudix-welcome.py
msgid "Discord"
msgstr "Discord"

#: roudix-welcome.py
msgid "Check for updates"
msgstr "التحقق من التحديثات"

#: roudix-welcome.py
msgid "See if new commits are available (nothing is changed)"
msgstr "تحقّق من توفّر عمليات commit جديدة (لن يتغيّر أي شيء)"

#: roudix-welcome.py
msgid "Update system"
msgstr "تحديث النظام"

#: roudix-welcome.py
msgid "Pull, rebuild, switch and update Flatpaks (same as `update`)"
msgstr "اسحب وأعد البناء وبدّل وحدّث حزم Flatpak (مثل `update`)"

#: roudix-welcome.py
msgid ""
"Open a terminal and run the update? You will be asked for your password."
msgstr "فتح طرفية وتشغيل التحديث؟ ستُطلب منك كلمة المرور."

#: roudix-welcome.py
msgid "Apply configuration"
msgstr "تطبيق الإعدادات"

#: roudix-welcome.py
msgid "Rebuild and switch now (same as `rebuild`)"
msgstr "أعد البناء وبدّل الآن (مثل `rebuild`)"

#: roudix-welcome.py
msgid "Rebuild the system now? This can take a while."
msgstr "إعادة بناء النظام الآن؟ قد يستغرق ذلك بعض الوقت."

#: roudix-welcome.py
msgid "Clean old generations"
msgstr "تنظيف الأجيال القديمة"

#: roudix-welcome.py
msgid "Keep the last 3 generations, then garbage-collect (same as `cleanup`)"
msgstr "احتفظ بآخر 3 أجيال ثم نظّف الذاكرة (مثل `cleanup`)"

#: roudix-welcome.py
msgid ""
"Remove old system generations? You will not be able to roll back to them."
msgstr "إزالة أجيال النظام القديمة؟ لن تتمكن من الرجوع إليها."

#: roudix-welcome.py
msgid "Show last update log"
msgstr "عرض آخر سجل تحديث"

#: roudix-welcome.py
msgid "Output of the last run of `update`"
msgstr "ناتج آخر تشغيل لـ `update`"

#: roudix-welcome.py
msgid "Press Enter to close…"
msgstr "اضغط Enter للإغلاق…"

#: roudix-welcome.py
msgid "Close"
msgstr "إغلاق"

#: roudix-welcome.py
msgid "Running…"
msgstr "جارٍ التشغيل…"

#: roudix-welcome.py
#, python-brace-format
msgid "ERROR: '{cmd}' not found in PATH."
msgstr "خطأ: لم يتم العثور على '{cmd}' في PATH."

#: roudix-welcome.py
#, python-brace-format
msgid "ERROR: {error}"
msgstr "خطأ: {error}"

#: roudix-welcome.py
msgid "✓ Done"
msgstr "✓ تم"

#: roudix-welcome.py
#, python-brace-format
msgid "✗ Failed (exit code {rc})"
msgstr "✗ فشل (رمز الخروج {rc})"

#: roudix-welcome.py
msgid "Welcome to Roudix"
msgstr "مرحبًا بك في Roudix"

#: roudix-welcome.py
msgid "Welcome"
msgstr "مرحبًا"

#: roudix-welcome.py
msgid "Tweaks"
msgstr "تعديلات"

#: roudix-welcome.py
msgid "Your NixOS, your way — shared with the people you care about."
msgstr "نظام NixOS الخاص بك، بطريقتك — شاركه مع من تهتم لأمرهم."

#: roudix-welcome.py
msgid "System tools"
msgstr "أدوات النظام"

#: roudix-welcome.py
msgid "Resources"
msgstr "الموارد"

#: roudix-welcome.py
msgid "Show at startup"
msgstr "العرض عند بدء التشغيل"

#: roudix-welcome.py
msgid "Show this window again on every login"
msgstr "عرض هذه النافذة مجددًا عند كل تسجيل دخول"

#: roudix-welcome.py
msgid "Maintenance"
msgstr "الصيانة"

#: roudix-welcome.py
msgid "Common system tasks, one click away."
msgstr "مهام النظام الشائعة بنقرة واحدة."

#: roudix-welcome.py
msgid "Run"
msgstr "تشغيل"

#: roudix-welcome.py
msgid "Configuration"
msgstr "الإعدادات"

#: roudix-welcome.py
msgid "Open configuration folder"
msgstr "فتح مجلد الإعدادات"

#: roudix-welcome.py
msgid "Cancel"
msgstr "إلغاء"

#: roudix-welcome.py
msgid "No terminal found"
msgstr "لم يتم العثور على طرفية"

#: roudix-welcome.py
msgid "Open a terminal yourself and run `update`."
msgstr "افتح طرفية بنفسك وشغّل `update`."

#~ msgid ""
#~ "<span size='small'>Roudix is your personal NixOS distribution: Wayland "
#~ "compositors (Niri, Hyprland, MangoWC, Umbriel), GNOME and KDE, a CachyOS "
#~ "kernel, and a bunch of tweaks built for you — and for the family and friends"
#~ " you share it with. Use the shortcuts below to customize your system, switch"
#~ " kernel and scheduler, or install apps from the store.</span>"
#~ msgstr ""
#~ "<span size='small'>Roudix هي توزيعة NixOS الشخصية الخاصة بك: مُركِّبات "
#~ "Wayland (Niri وHyprland وMangoWC وUmbriel)، وGNOME وKDE، ونواة CachyOS، "
#~ "ومجموعة من التعديلات المصمّمة من أجلك — ومن أجل العائلة والأصدقاء الذين "
#~ "تشاركها معهم. استخدم الاختصارات أدناه لتخصيص نظامك وتبديل النواة والمجدول أو"
#~ " تثبيت التطبيقات من المتجر.</span>"

#~ msgid "Roudix Apps"
#~ msgstr "تطبيقات Roudix"

#~ msgid "Open"
#~ msgstr "فتح"
