#~ "compositors (Niri, Hyprland, MangoWC, Umbriel), GNOME and KDE, a CachyOS "
#~ "kernel, and a bunch of tweaks built for you — and for the family and friends"
#~ " you share it with. Use the shortcuts below to customize your system, switch"
#~ " kernel and scheduler, or install apps from the store.</span>"
#~ msgstr ""
#~ "<span size='small'>Roudix es tu distribución NixOS personal: compositores "
#~ "Wayland (Niri, Hyprland, MangoWC, Umbriel), GNOME y KDE, un kernel CachyOS y"
#~ " un montón de ajustes hechos para ti — y para la familia y los amigos con "
#~ "quienes la compartes. Usa los accesos de abajo para personalizar tu sistema,"
#~ " cambiar de kernel y de planificador, o instalar aplicaciones desde la "
#~ "tienda.</span>"

#~ msgid "Roudix Apps"
#~ msgstr "Aplicaciones de Roudix"

#~ msgid "Open"
#~ msgstr "Abrir"
