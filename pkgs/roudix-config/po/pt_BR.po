#, python-brace-format
msgid ""
"Your whole {custom_name} file. The “roudix-config” block is managed by the "
"app; the rest is yours. Saving makes a .bak copy and checks the syntax."
msgstr ""
"Todo o seu arquivo {custom_name}. O bloco “roudix-config” é gerenciado pelo "
"app; o resto é seu. Ao salvar, é criada uma cópia .bak e a sintaxe é "
"verificada."

