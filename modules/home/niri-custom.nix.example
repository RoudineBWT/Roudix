{ lib, ... }:
{
  # ── Personal niri overrides ─────────────────────────────────────────────
  # Copy this file to niri-custom.nix (without .example) next to local.nix —
  # it's auto-imported (see `imports` in local.nix) and gitignored like it.
  #
  # Simple rule:
  #  - New key (new output, new bind, one more rule)
  #    → plain assignment, it merges on its own with the repo.
  #  - Key ALREADY defined by the repo (same output, same key
  #    combination) → needs lib.mkForce, otherwise Nix complains
  #    ("conflicting definitions").
  #  - Replacing a whole section → lib.mkForce on the whole section.

  # -- Change your screens' resolution/position -------------------------
  # (run `niri msg outputs` in session to get the real names)
  # programs.niri.settings.outputs."Lenovo Group Limited Legion 27Q-10 UNA07260".mode =
  #   lib.mkForce { width = 3840; height = 2160; refresh = 144.0; };

  # -- Remap an existing bind ----------------------------------------------
  # programs.niri.settings.binds."Mod+T" = lib.mkForce {
  #   action.spawn = [ "alacritty" ];
  # };

  # -- Add a bind that doesn't exist yet (no mkForce needed) -------
  # programs.niri.settings.binds."Mod+Shift+V".action.spawn = [ "pavucontrol" ];

  # -- Add an extra window rule -----------------------------------------------
  # (lists merge by CONCATENATION in the Home Manager module system: your
  # rule gets appended after the repo's)
  # programs.niri.settings.window-rules = [
  #   { matches = [ { app-id = "mpv"; } ]; open-floating = true; }
  # ];

  # -- Replace the whole animations section ----------------------------------
  # programs.niri.settings.animations = lib.mkForce {
  #   window-open.duration-ms = 0; # disable everything, e.g. on an old PC
  # };
}
