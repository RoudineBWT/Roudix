msgstr "Particionando o disco…"

#: src/roudix_installer/pages/progress.py
msgid "Mounting partitions…"
msgstr "Montando as partições…"

#: src/roudix_installer/pages/progress.py
msgid "No partition assigned to / — cannot continue"
msgstr "Nenhuma partição atribuída a / — não é possível continuar"

#: src/roudix_installer/pages/progress.py
#, python-brace-format
msgid "Checking branch '{branch}'…"
msgstr "Verificando o branch '{branch}'…"

#: src/roudix_installer/pages/progress.py
#, python-brace-format
msgid "Branch '{branch}' not found on {repo_url} — falling back to 'main'."
msgstr "Branch '{branch}' não encontrado em {repo_url} — voltando para 'main'."

#: src/roudix_installer/pages/progress.py
#, python-brace-format
msgid ""
"Warning: hosts/{host}/local.nix.example not found on branch '{branch}' — "
"local.nix generation may fail."
msgstr ""
"Aviso: hosts/{host}/local.nix.example não encontrado no branch '{branch}' — "
"a geração do local.nix pode falhar."

#: src/roudix_installer/pages/progress.py
msgid "Copying the configuration…"
msgstr "Copiando a configuração…"

#: src/roudix_installer/pages/progress.py
#, python-brace-format
msgid ""
"Branch '{branch}' selected — cloning from GitHub (the ISO only embeds main)."
msgstr ""
"Branch '{branch}' selecionado — clonando do GitHub (a ISO só inclui o main)."

#: src/roudix_installer/pages/progress.py
msgid ""
"/iso-cfg not found (ISO not (yet) rebuilt with isoImage.contents, or testing "
"outside an ISO) — cloning straight from GitHub instead."
msgstr ""
"/iso-cfg não encontrado (ISO ainda não reconstruída com isoImage.contents, "
"ou teste fora de uma ISO) — clonando direto do GitHub."

#: src/roudix_installer/pages/progress.py
#, python-brace-format
msgid "btrfs detected — mount options auto-patched for: {patched}"
msgstr ""
"btrfs detectado — opções de montagem ajustadas automaticamente para: "
"{patched}"

#: src/roudix_installer/pages/progress.py
#, python-brace-format
msgid "hosts/{hostname}/local.nix, username.nix, home/local.nix written."
msgstr "hosts/{hostname}/local.nix, username.nix e home/local.nix gravados."

#: src/roudix_installer/pages/progress.py
#, python-brace-format
msgid ""
"Warning: only {free} MiB free in /boot ({need} MiB recommended) — nixos-"
"rebuild may fail on a small EFI partition."
msgstr ""
"Aviso: apenas {free} MiB livres em /boot ({need} MiB recomendados) — o nixos-"
"rebuild pode falhar em uma partição EFI pequena."

#: src/roudix_installer/pages/progress.py
#, python-brace-format
msgid ""
"Warning: only {free} GiB free for the Nix store ({need} GiB recommended)."
msgstr ""
"Aviso: apenas {free} GiB livres para o store do Nix ({need} GiB "
"recomendados)."

#: src/roudix_installer/pages/progress.py
#, python-brace-format
msgid ""
"Warning: your configuration uses system.stateVersion {old}, Roudix sets "
"{new}. Services that keep data (databases…) deserve a look before booting it."
msgstr ""
"Aviso: sua configuração usa system.stateVersion {old}, e o Roudix define "
"{new}. Serviços que guardam dados (bancos de dados…) merecem uma olhada "
"antes de iniciar."

#: src/roudix_installer/pages/progress.py
#, python-brace-format
msgid ""
"Note: Roudix will use the {new} bootloader (yours: {old}). If it ever fails "
"to start, RESTORE.txt in the backup explains how to put your old "
"configuration back."
msgstr ""
"Nota: o Roudix usará o bootloader {new} (o seu: {old}). Se ele não iniciar, "
"o RESTORE.txt no backup explica como restaurar sua configuração anterior."

#: src/roudix_installer/pages/progress.py
msgid ""
"Reusing /etc/nixos/hardware-configuration.nix (the one that boots this "
"machine)."
msgstr ""
"Reutilizando /etc/nixos/hardware-configuration.nix (o que inicia esta "
"máquina)."

#: src/roudix_installer/pages/progress.py
msgid "Checking this system…"
msgstr "Verificando este sistema…"

#: src/roudix_installer/pages/progress.py
#, python-brace-format
msgid "{cfg} already exists — moving it to {aside}."
msgstr "{cfg} já existe — movendo para {aside}."

#: src/roudix_installer/pages/progress.py
msgid "Backing up /etc/nixos…"
msgstr "Fazendo backup de /etc/nixos…"

#: src/roudix_installer/pages/progress.py
#, python-brace-format
msgid "✓ backup done: {dest} (see RESTORE.txt in it)."
msgstr "✓ backup concluído: {dest} (veja o RESTORE.txt dentro dele)."

#: src/roudix_installer/pages/progress.py
msgid "Building Roudix — this can take a while…"
msgstr "Construindo o Roudix — pode demorar um pouco…"

#: src/roudix_installer/pages/progress.py
msgid ""
"✓ Roudix is built. Reboot to start it; your previous system stays in the "
"boot menu."
msgstr ""
"✓ O Roudix foi construído. Reinicie para iniciá-lo; seu sistema anterior "
"continua no menu de boot."

#: src/roudix_installer/pages/progress.py
msgid "Installing the system…"
msgstr "Instalando o sistema…"

#: src/roudix_installer/pages/progress.py
msgid "Setting the password…"
msgstr "Definindo a senha…"

#: src/roudix_installer/pages/progress.py
msgid "Copying config for nh os switch…"
msgstr "Copiando a configuração para o nh os switch…"

