msgid "Server + LTO"
msgstr "Serveur + LTO"

#: roudix-kernel-switcher.py
msgid "Release candidate  —  unstable"
msgstr "Version candidate  —  instable"

#: roudix-kernel-switcher.py
msgid ""
"linux-zen — nvidia module cached only with the open driver; closed driver "
"compiles locally on every bump"
msgstr ""
"linux-zen — module nvidia en cache uniquement avec le pilote ouvert ; le "
"pilote propriétaire se compile localement à chaque mise à jour"

#: roudix-kernel-switcher.py
msgid "linux LTS — same nvidia module caveat as zen"
msgstr "linux LTS — même réserve sur le module nvidia que zen"

#: roudix-kernel-switcher.py
msgid "linux latest — same nvidia module caveat as zen"
msgstr "linux latest — même réserve sur le module nvidia que zen"

#: roudix-kernel-switcher.py
msgid ""
"linux_testing — mainline RC/testing kernel, same nvidia module caveat as zen"
msgstr ""
"linux_testing — noyau mainline RC/test, même réserve sur le module nvidia "
"que zen"

#: roudix-kernel-switcher.py
msgid "XanMod LTS — same nvidia module caveat as zen"
msgstr "XanMod LTS — même réserve sur le module nvidia que zen"

#: roudix-kernel-switcher.py
msgid "XanMod main branch — same nvidia module caveat as zen"
msgstr "Branche principale XanMod — même réserve sur le module nvidia que zen"

#: roudix-kernel-switcher.py
msgid "Default  —  LTO + BORE, ships nvidia_cachyos"
msgstr "Par défaut  —  LTO + BORE, fournit nvidia_cachyos"

#: roudix-kernel-switcher.py
msgid "Server optimised  —  no desktop tuning"
msgstr "Optimisé pour serveur  —  sans réglages bureau"

#: roudix-kernel-switcher.py
msgid "Latest"
msgstr "Derniers"

#: roudix-kernel-switcher.py
msgid "Variants"
msgstr "Variantes"

#: roudix-kernel-switcher.py
msgid "Chaotic-Nyx (GPU: nvidia)"
msgstr "Chaotic-Nyx (GPU : nvidia)"

#: roudix-kernel-switcher.py
#, python-brace-format
msgid "Kernel source: {source}"
msgstr "Source du noyau : {source}"

#: roudix-kernel-switcher.py
msgid ""
"Nvidia GPU detected — only Chaotic-Nyx variants are shown, so nvidia_cachyos "
"(precompiled driver) stays matched to your kernel."
msgstr ""
"GPU Nvidia détecté — seules les variantes Chaotic-Nyx sont affichées, pour "
"que nvidia_cachyos (pilote précompilé) reste adapté à ton noyau."

#: roudix-kernel-switcher.py
msgid "Active kernel"
msgstr "Noyau actif"

#: roudix-kernel-switcher.py
msgid "Select a kernel variant above."
msgstr "Choisis une variante de noyau ci-dessus."

#: roudix-kernel-switcher.py
msgid "Apply & Rebuild"
msgstr "Appliquer et reconstruire"

#: roudix-kernel-switcher.py
#, python-brace-format
msgid "Will switch to: {variant}"
msgstr "Bascule vers : {variant}"

#: roudix-kernel-switcher.py
msgid "Already the active kernel."
msgstr "C'est déjà le noyau actif."

#: roudix-kernel-switcher.py
msgid "Apply changes?"
msgstr "Appliquer les modifications ?"

#: roudix-kernel-switcher.py
#, python-brace-format
msgid "Kernel: <b>{current}</b> → <b>{selected}</b>"
msgstr "Noyau : <b>{current}</b> → <b>{selected}</b>"

#: roudix-kernel-switcher.py
msgid "Your NixOS configuration will be rebuilt. This may take a few minutes."
msgstr ""
"Ta configuration NixOS sera reconstruite. Cela peut prendre quelques minutes."

#: roudix-kernel-switcher.py
msgid "Cancel"
msgstr "Annuler"

#: roudix-kernel-switcher.py
#, python-brace-format
msgid "✗ Error writing config: {error}"
msgstr "✗ Erreur d'écriture de la configuration : {error}"

#: roudix-kernel-switcher.py
msgid "Building…"
msgstr "Construction…"

#: roudix-kernel-switcher.py
msgid "Important Notices:"
msgstr "Avis importants :"

#: roudix-kernel-switcher.py
msgid "No issues currently reported."
msgstr "Aucun problème signalé actuellement."

#: roudix-kernel-switcher.py
#, python-brace-format
msgid "Running: {cmd}"
msgstr "Exécution : {cmd}"

#: roudix-kernel-switcher.py
msgid "Checking repositories..."
msgstr "Vérification des dépôts..."

#: roudix-kernel-switcher.py
msgid "ERROR: 'nh' not found in PATH."
msgstr "ERREUR : « nh » introuvable dans le PATH."

#: roudix-kernel-switcher.py
#, python-brace-format
msgid "ERROR: {error}"
msgstr "ERREUR : {error}"

#: roudix-kernel-switcher.py
#, python-brace-format
msgid "✓ Done — reboot to apply {kernel}."
msgstr "✓ Terminé — redémarre pour appliquer {kernel}."

#: roudix-kernel-switcher.py
msgid "✓ Rebuild completed successfully. Reboot to apply changes."
msgstr ""
"✓ Reconstruction terminée avec succès. Redémarre pour appliquer les "
"changements."

#: roudix-kernel-switcher.py
#, python-brace-format
msgid "✗ Build failed (exit {rc}). See log."
msgstr "✗ Échec de la construction (code {rc}). Voir le journal."

