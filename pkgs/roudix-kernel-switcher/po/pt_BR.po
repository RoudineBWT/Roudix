msgstr "LTO + v3  —  melhor desempenho em CPUs modernas"

#: roudix-kernel-switcher.py
msgid "Long-term support"
msgstr "Suporte de longo prazo"

#: roudix-kernel-switcher.py
msgid "LTS + LTO + v3  —  stable + performance"
msgstr "LTS + LTO + v3  —  estabilidade + desempenho"

#: roudix-kernel-switcher.py
msgid "BORE scheduler"
msgstr "Escalonador BORE"

#: roudix-kernel-switcher.py
msgid "BMQ scheduler"
msgstr "Escalonador BMQ"

#: roudix-kernel-switcher.py
msgid "EEVDF scheduler"
msgstr "Escalonador EEVDF"

#: roudix-kernel-switcher.py
msgid "Security hardened"
msgstr "Segurança reforçada"

#: roudix-kernel-switcher.py
msgid "Hardened + LTO"
msgstr "Reforçado + LTO"

#: roudix-kernel-switcher.py
msgid "Real-time + BORE"
msgstr "Tempo real + BORE"

#: roudix-kernel-switcher.py
msgid "Real-time + BORE + LTO"
