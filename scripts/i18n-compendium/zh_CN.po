# Shared translation memory for scripts/i18n.sh (msgmerge --compendium).
# `update` fills any still-untranslated message of every component from here,
# so a new string only needs its translation added once, in this file.
# Existing translations in po/*.po are never overwritten.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"

msgid "Vesktop (standalone Vencord)"
msgstr "Vesktop（独立 Vencord）"

msgid "Standalone Vencord client, native Wayland"
msgstr "独立的 Vencord 客户端，原生 Wayland"

msgid "Roudix — logo, gentle pulse (default)"
msgstr "Roudix — 徽标，轻柔脉动（默认）"

msgid "Roudix Spin — logo turning slowly"
msgstr "Roudix Spin — 徽标缓缓旋转"

msgid "Roudix Gradient — warm gradient, glow behind the logo"
msgstr "Roudix Gradient — 暖色渐变，徽标后方泛光"

msgid "Roudix Ember — rising embers, progress ring"
msgstr "Roudix Ember — 升腾的火星，进度环"

msgid "Pandoudix — the mascot"
msgstr "Pandoudix — 吉祥物"

msgid "No splash — plain text boot"
msgstr "无启动画面 — 纯文本启动"

msgid "LibreOffice (Writer, Calc, Impress)"
msgstr "LibreOffice（Writer、Calc、Impress）"

msgid "ONLYOFFICE (Word-style editors, .docx / .xlsx / .pptx)"
msgstr "ONLYOFFICE（类 Word 编辑器，.docx / .xlsx / .pptx）"

msgid "Open kernel modules"
msgstr "开源内核模块"

msgid "RTX 20xx and newer. Turn off for GTX 10xx / 16xx cards."
msgstr "适用于 RTX 20xx 及更新的显卡。GTX 10xx / 16xx 显卡请关闭。"

msgid "Boot splash"
msgstr "启动画面"

msgid "Office suite"
msgstr "办公套件"

msgid "Office dictionaries (comma-separated: en, fr, es, de, it, pt)"
msgstr "办公套件词典（以逗号分隔：en, fr, es, de, it, pt）"

msgid "Printing (CUPS)"
msgstr "打印（CUPS）"

msgid "Common printer drivers and network printer discovery."
msgstr "常用打印机驱动及网络打印机发现。"

msgid "Scanners (SANE)"
msgstr "扫描仪（SANE）"

msgid "OpenVPN (NetworkManager plugin)"
msgstr "OpenVPN（NetworkManager 插件）"

msgid "GOverlay (GUI to configure MangoHud / vkBasalt)"
msgstr "GOverlay（用于配置 MangoHud / vkBasalt 的图形界面）"

msgid "Oversteer (racing wheel configuration)"
msgstr "Oversteer（赛车方向盘配置）"

msgid "Writer, Calc, Impress"
msgstr "Writer、Calc、Impress"

msgid "Word-style editors built around .docx / .xlsx / .pptx"
msgstr "围绕 .docx / .xlsx / .pptx 格式打造的类 Word 编辑器"

msgid "Don't install an office suite"
msgstr "不安装办公套件"

msgid "English"
msgstr "英语"

msgid "French"
msgstr "法语"

msgid "Spanish"
msgstr "西班牙语"

msgid "German"
msgstr "德语"

msgid "Italian"
msgstr "意大利语"

msgid "Portuguese"
msgstr "葡萄牙语"

msgid "Create the sbctl keys at install time if missing (enrolling them stays manual)"
msgstr "若缺少 sbctl 密钥，则在安装时创建（注册密钥仍需手动完成）"

msgid "List “NixOS EAC” in the firmware boot menu (otherwise: sudo eac-reboot)"
msgstr "在固件启动菜单中列出“NixOS EAC”（否则：sudo eac-reboot）"

msgid "Open kernel modules (RTX 20xx and newer — turn off for GTX 10xx/16xx)"
msgstr "开源内核模块（RTX 20xx 及更新——GTX 10xx/16xx 请关闭）"

msgid "Boot splash (Plymouth) — off = plain text boot"
msgstr "启动画面（Plymouth）——关闭 = 纯文本启动"

msgid "Hide kernel / initrd messages during boot (turn off to debug a boot problem)"
msgstr "启动时隐藏内核 / initrd 消息（排查启动问题时请关闭）"

msgid "Best battery life (default) — disables tuned, so game-performance does nothing"
msgstr "最长续航（默认）——停用 tuned，因此 game-performance 不起作用"

msgid "Gaming laptop: keeps game-performance and the desktop power-mode selector"
msgstr "游戏笔记本：保留 game-performance 和桌面的电源模式选择器"

msgid "Printing (CUPS + network printers)"
msgstr "打印（CUPS + 网络打印机）"

msgid "Scanners (SANE: network + HP)"
msgstr "扫描仪（SANE：网络 + HP）"

msgid "Monthly btrfs scrub"
msgstr "每月 btrfs scrub"

msgid "Kernel CVE mitigations (module blacklists)"
msgstr "内核 CVE 缓解措施（模块黑名单）"

msgid "  ↳ Blacklist algif_aead (“Copy Fail”)"
msgstr "  ↳ 将 algif_aead 加入黑名单（“Copy Fail”）"

msgid "  ↳ Blacklist esp4/esp6/rxrpc (“Dirty Frag”) — turn off ONLY with IPsec or AFS/Kerberos"
msgstr "  ↳ 将 esp4/esp6/rxrpc 加入黑名单（“Dirty Frag”）——仅在使用 IPsec 或 AFS/Kerberos 时才关闭"

msgid "Hibernation (needs swap, off by default)"
msgstr "休眠（需要 swap，默认关闭）"

msgid "Office dictionaries"
msgstr "办公套件词典"

msgid "Laptop power backend"
msgstr "笔记本电源管理后端"

# --- installer terminal wizard (tui.py) ---
msgid "Other systems"
msgstr "其他系统"

msgid "Found in the EFI NVRAM: switch on the ones to add to Limine's boot menu."
msgstr "在 EFI NVRAM 中找到：开启要添加到 Limine 启动菜单的项目。"

msgid "Only letters, digits and . _ + - : , @ / are allowed here."
msgstr "此处只允许字母、数字以及 . _ + - : , @ /"

msgid "Allowed: {codes}"
msgstr "允许：{codes}"

msgid "Can't be empty."
msgstr "不能为空。"

msgid "Gaming extras"
msgstr "游戏附加项"

msgid "Features"
msgstr "功能"

msgid "Content-creation tools"
msgstr "内容创作工具"

msgid "OBS plugins"
msgstr "OBS 插件"

msgid " or type to filter"
msgstr " 或输入以筛选"

msgid "Choice"
msgstr "选择"

msgid "Choose one of the entries."
msgstr "请选择其中一项。"

msgid "Out of range."
msgstr "超出范围。"

msgid "No match."
msgstr "没有匹配项。"

msgctxt "yes/no prompt, yes is the default"
msgid "[Y/n]"
msgstr "[Y/n]"

msgctxt "yes/no prompt, no is the default"
msgid "[y/N]"
msgstr "[y/N]"

msgid "Answer yes or no."
msgstr "请回答 yes 或 no。"

msgid "Toggle: numbers separated by spaces, a = all, n = none, Enter = continue"
msgstr "切换：用空格分隔的编号，a = 全选，n = 全不选，回车 = 继续"

msgid "Administrator rights are needed and sudo is not available: run the installer as root."
msgstr "需要管理员权限，但没有 sudo：请以 root 身份运行安装程序。"

msgid "Administrator rights are needed: enter your password if asked."
msgstr "需要管理员权限：如有提示，请输入密码。"

msgid "No disk found."
msgstr "未找到磁盘。"

msgid "File not found."
msgstr "未找到文件。"

msgid "Partition it yourself in another terminal (cfdisk, fdisk, parted…), then press Enter."
msgstr "请在另一个终端中自行分区（cfdisk、fdisk、parted…），然后按回车。"

msgid "Other systems found in the EFI NVRAM — which ones do you want to add to Limine?"
msgstr "在 EFI NVRAM 中找到其他系统 — 要将哪些添加到 Limine？"

msgid "Edit the options"
msgstr "编辑选项"

msgid "Quit"
msgstr "退出"

msgid "What now?"
msgstr "接下来做什么？"

msgid "Start now?"
msgstr "现在开始？"

msgid "Interrupted — the installation may be incomplete."
msgstr "已中断 — 安装可能不完整。"

msgid "Aborted — nothing was changed."
msgstr "已中止 — 未做任何更改。"


# --- installer: temporary swap for nixos-install (swap.py / runner.py) ---
msgid "Low memory ({ram} GiB): adding {size} GiB of temporary swap on the target disk for the build…"
msgstr "内存不足（{ram} GiB）：正在目标磁盘上为构建添加 {size} GiB 临时交换空间…"

msgid "Could not add temporary swap ({reason}) — the build may run out of memory."
msgstr "无法添加临时交换空间（{reason}）——构建可能会内存不足。"

msgid "not enough free space on the target disk"
msgstr "目标磁盘可用空间不足"

# --- installer: zram during nixos-install ---
msgid "Compressed RAM swap (zram) enabled: {size} GiB."
msgstr "已启用内存压缩交换（zram）：{size} GiB。"

msgid "Could not enable zram ({reason})."
msgstr "无法启用 zram（{reason}）。"

msgid "Noctalia's native Wayland file manager"
msgstr "Noctalia 的原生 Wayland 文件管理器"

msgid "Luciole — Noctalia, native Wayland"
msgstr "Luciole — Noctalia，原生 Wayland"

msgid "Detected in your config"
msgstr "在你的配置中检测到"

msgid "All options"
msgstr "所有选项"

msgid "Setting “{sid}” no longer exists in the compositor config: your value was removed."
msgstr "设置“{sid}”在合成器配置中已不存在：你的值已被移除。"

msgid "Setting “{title}” changed type in the compositor config: your old value was removed."
msgstr "设置“{title}”在合成器配置中的类型已更改：你之前的值已被移除。"
