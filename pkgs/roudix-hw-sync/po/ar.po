#: roudix-hw-sync-gui.py
msgid "AMD — modern (RDNA / GCN 3+, RX 400 and newer)"
msgstr "AMD — حديثة (RDNA / GCN 3+، RX 400 وما بعدها)"

#: roudix-hw-sync-gui.py
msgid "AMD — integrated (Ryzen APU)"
msgstr "AMD — مدمجة (معالج Ryzen APU)"

#: roudix-hw-sync-gui.py
msgid "AMD — legacy (GCN 1.x / 2.x, HD 7xxx, R9 2xx)"
msgstr "AMD — قديمة (GCN 1.x / 2.x وHD 7xxx وR9 2xx)"

#: roudix-hw-sync-gui.py
msgid "Intel (integrated or Arc)"
msgstr "Intel (مدمجة أو Arc)"

#: roudix-hw-sync-gui.py
msgid "Detection failed."
msgstr "فشل الكشف."

#: roudix-hw-sync-gui.py
msgid "New PC, new graphics card or new processor? Roudix looks at your hardware and updates your configuration to match. Nothing is changed until you press a button below."
msgstr "حاسوب جديد أو بطاقة رسوميات جديدة أو معالج جديد؟ يفحص Roudix العتاد لديك ويحدّث إعداداتك لتتوافق معه. لن يتغيّر أي شيء حتى تضغط على أحد الأزرار أدناه."

#: roudix-hw-sync-gui.py
msgid "Your hardware"
msgstr "العتاد لديك"

#: roudix-hw-sync-gui.py
msgid "Processor (CPU)"
msgstr "المعالج (CPU)"

#: roudix-hw-sync-gui.py
msgid "Graphics card (GPU)"
msgstr "بطاقة الرسوميات (GPU)"

#: roudix-hw-sync-gui.py
msgid "Laptop with an NVIDIA graphics card"
msgstr "حاسوب محمول ببطاقة رسوميات NVIDIA"

#: roudix-hw-sync-gui.py
msgid "Hybrid graphics (Optimus): Intel/AMD chip + NVIDIA card"
msgstr "رسوميات هجينة (Optimus): شريحة Intel/AMD + بطاقة NVIDIA"

#: roudix-hw-sync-gui.py
msgid "Checking…"
msgstr "جارٍ الفحص…"

#: roudix-hw-sync-gui.py
msgid "Preview of the changes"
msgstr "معاينة التغييرات"

#: roudix-hw-sync-gui.py
msgid "Re-detect"
msgstr "إعادة الكشف"

#: roudix-hw-sync-gui.py
msgid "Apply"
msgstr "تطبيق"

#: roudix-hw-sync-gui.py
msgid "Only update local.nix, no rebuild"
msgstr "تحديث local.nix فقط، دون إعادة بناء"

#: roudix-hw-sync-gui.py
msgid "Apply & Rebuild"
msgstr "تطبيق وإعادة البناء"

#: roudix-hw-sync-gui.py
msgid "Could not detect your hardware"
msgstr "تعذّر الكشف عن العتاد لديك"

#: roudix-hw-sync-gui.py
msgid "Something went wrong"
msgstr "حدث خطأ ما"

#: roudix-hw-sync-gui.py
msgid "Your configuration already matches this hardware"
msgstr "إعداداتك تتوافق بالفعل مع هذا العتاد"

#: roudix-hw-sync-gui.py
#, c-format
msgid "%d line will be updated in local.nix"
msgid_plural "%d lines will be updated in local.nix"
msgstr[0] "سيتم تحديث %d سطر في local.nix"
msgstr[1] "سيتم تحديث سطر واحد (%d) في local.nix"
msgstr[2] "سيتم تحديث سطرين (%d) في local.nix"
msgstr[3] "سيتم تحديث %d أسطر في local.nix"
msgstr[4] "سيتم تحديث %d سطرًا في local.nix"
msgstr[5] "سيتم تحديث %d سطر في local.nix"

#: roudix-hw-sync-gui.py
msgid "Apply changes?"
msgstr "هل تريد تطبيق التغييرات؟"

#. TRANSLATORS: Shown in a dialog that uses Pango markup: keep the <b> tags and the {placeholder}.
#: roudix-hw-sync-gui.py
#, python-brace-format
msgid "CPU: <b>{cpu}</b>"
msgstr "المعالج: <b>{cpu}</b>"

#. TRANSLATORS: Shown in a dialog that uses Pango markup: keep the <b> tags and the {placeholder}.
#: roudix-hw-sync-gui.py
#, python-brace-format
msgid "GPU: <b>{gpu}</b>"
msgstr "بطاقة الرسوميات: <b>{gpu}</b>"

#. TRANSLATORS: {answer} is replaced by the words "yes" / "no" below.
#: roudix-hw-sync-gui.py
#, python-brace-format
msgid "Hybrid laptop: <b>{answer}</b>"
msgstr "حاسوب محمول هجين: <b>{answer}</b>"

#: roudix-hw-sync-gui.py
msgid "yes"
msgstr "نعم"

#: roudix-hw-sync-gui.py
msgid "no"
msgstr "لا"

#. TRANSLATORS: Pango markup: keep the <tt> tags.
#: roudix-hw-sync-gui.py
msgid "A backup of your settings is kept as <tt>local.nix.bak</tt>."
msgstr "تُحفظ نسخة احتياطية من إعداداتك باسم <tt>local.nix.bak</tt>."

#: roudix-hw-sync-gui.py
msgid "Your system will then be rebuilt, this can take a few minutes."
msgstr "ستتم بعد ذلك إعادة بناء نظامك، وقد يستغرق ذلك بضع دقائق."

#: roudix-hw-sync-gui.py
msgid "Cancel"
msgstr "إلغاء"

#: roudix-hw-sync-gui.py
msgid "✗ Could not write local.nix"
msgstr "✗ تعذّرت كتابة local.nix"

#: roudix-hw-sync-gui.py
msgid "✓ local.nix updated — rebuild to apply"
msgstr "✓ تم تحديث local.nix — أعد البناء للتطبيق"

#: roudix-hw-sync-gui.py
msgid "Backup saved as local.nix.bak"
msgstr "تم حفظ النسخة الاحتياطية باسم local.nix.bak"

#: roudix-hw-sync-gui.py
msgid "Rebuilding…"
msgstr "جارٍ إعادة البناء…"

#: roudix-hw-sync-gui.py
#, python-brace-format
msgid "Running: {cmd}"
msgstr "التنفيذ: {cmd}"

#: roudix-hw-sync-gui.py
msgid "ERROR: 'nh' not found in PATH."
msgstr "خطأ: لم يتم العثور على 'nh' في PATH."

#: roudix-hw-sync-gui.py
#, python-brace-format
msgid "ERROR: {error}"
msgstr "خطأ: {error}"

#: roudix-hw-sync-gui.py
msgid "✓ Done — reboot to use your new hardware settings"
msgstr "✓ تم — أعد التشغيل لاستخدام إعدادات العتاد الجديدة"

#: roudix-hw-sync-gui.py
msgid "✓ Rebuild completed. Reboot to apply the changes."
msgstr "✓ اكتملت إعادة البناء. أعد التشغيل لتطبيق التغييرات."

#: roudix-hw-sync-gui.py
#, python-brace-format
msgid "✗ Rebuild failed (exit {rc})"
msgstr "✗ فشلت إعادة البناء (رمز الخروج {rc})"

#: roudix-hw-sync-gui.py
msgid "See the log below. Your local.nix was already updated."
msgstr "راجع السجل أدناه. تم تحديث local.nix لديك بالفعل."

#: roudix-hw-sync-gui.py
#, python-brace-format
msgid "✗ Rebuild failed (exit code {rc})."
msgstr "✗ فشلت إعادة البناء (رمز الخروج {rc})."

#: roudix-hw-sync
#, c-format
msgid "Unknown option: %s"
msgstr "خيار غير معروف: %s"

#: roudix-hw-sync
#, c-format
msgid "Invalid --gpu: %s"
msgstr "قيمة --gpu غير صالحة: %s"

#: roudix-hw-sync
#, c-format
msgid "Invalid --cpu: %s"
msgstr "قيمة --cpu غير صالحة: %s"

#: roudix-hw-sync
#, c-format
msgid "Invalid --laptop: %s"
msgstr "قيمة --laptop غير صالحة: %s"

#: roudix-hw-sync
#, c-format
msgid "local.nix not found: %s"
msgstr "لم يتم العثور على local.nix: %s"

#: roudix-hw-sync
msgid "CPU vendor not detected, use --cpu amd|intel"
msgstr "لم يتم الكشف عن مُصنّع المعالج، استخدم --cpu amd|intel"

#: roudix-hw-sync
msgid "GPU not detected, use --gpu ..."
msgstr "لم يتم الكشف عن بطاقة الرسوميات، استخدم --gpu ..."

#. TRANSLATORS: Keep CPU=, GPU= and nvidiaLaptop= as they are (option names), and the three %s in this order.
#: roudix-hw-sync
#, c-format
msgid "Detected: CPU=%s  GPU=%s  nvidiaLaptop=%s"
msgstr "تم الكشف: CPU=%s  GPU=%s  nvidiaLaptop=%s"

#: roudix-hw-sync
msgid "warning: no hardware.myKernelChaotic line in local.nix (nvidia uses it), module default applies"
msgstr "تحذير: لا يوجد سطر hardware.myKernelChaotic في local.nix (يستخدمه nvidia)، سيُطبَّق الإعداد الافتراضي للوحدة"

#: roudix-hw-sync
msgid "Nothing to change."
msgstr "لا شيء لتغييره."

#. TRANSLATORS: Must start with an ASCII "(": the GUI uses that to tell this note apart from the diff.
#: roudix-hw-sync
msgid "(dry-run: file left untouched)"
msgstr "(تشغيل تجريبي: لم يتم تعديل الملف)"

#: roudix-hw-sync
#, c-format
msgid "Done. Backup: %s"
msgstr "تم. النسخة الاحتياطية: %s"

#. TRANSLATORS: Keep the command and $NH_FLAKE exactly as they are.
#: roudix-hw-sync
msgid "Now rebuild: rebuild   (or: nh os boot --accept-flake-config path:$NH_FLAKE)"
msgstr "أعد البناء الآن: rebuild   (أو: nh os boot --accept-flake-config path:$NH_FLAKE)"

