msgstr "Bloq Num activado al iniciar"

#: roudix_config_backends.py
msgid "Key repeat rate (per second)"
msgstr "Repetición de teclas (por segundo)"

#: roudix_config_backends.py
msgid "Key repeat delay (ms)"
msgstr "Retardo de repetición (ms)"

#: roudix_config_backends.py
msgid "Animation slowdown (×)"
msgstr "Ralentizar las animaciones (×)"

#: roudix_config_backends.py
msgid "Hot corner (overview)"
msgstr "Esquina activa (overview)"

#: roudix_config_backends.py
msgid "Hide the shortcut overlay at startup"
msgstr "Ocultar la superposición de atajos al iniciar"

#: roudix_config_backends.py
msgid "e.g. Mod+Q, Mod+Shift+Return, XF86AudioMute"
msgstr "p. ej. Mod+Q, Mod+Shift+Return, XF86AudioMute"

#: roudix_config_backends.py
msgid "shortcut and action required"
msgstr "se requieren atajo y acción"

#: roudix_config_backends.py
msgid "generated by Roudix Config — edit it through the app"
msgstr "generado por Roudix Config — edítalo desde la app"

#: roudix_config_backends.py
msgid ""
"e.g. SUPER,Q · SUPER+SHIFT,Return · NONE,XF86AudioMute  (modifiers, key)"
msgstr ""
"p. ej. SUPER,Q · SUPER+SHIFT,Return · NONE,XF86AudioMute  (modificadores, "
"tecla)"

#: roudix_config_backends.py
msgid "Mango shortcut: “MODS,KEY” (e.g. SUPER,Q)"
msgstr "Atajo de Mango: «MODS,KEY» (p. ej. SUPER,Q)"

#: roudix_config_backends.py
msgid "Action: unbalanced quotes"
msgstr "Acción: comillas sin cerrar"

#: roudix_config_backends.py
msgid "Empty action"
msgstr "Acción vacía"

#: roudix_config_backends.py
msgid "Invalid action name (e.g. spawn, close-window, focus-workspace)"
msgstr ""
"Nombre de acción no válido (p. ej. spawn, close-window, focus-workspace)"

#: roudix_config_backends.py
msgid "Niri: moving a shortcut isn't supported (use the File tab)."
msgstr "Niri: no se admite mover un atajo (usa la pestaña Archivo)."

#: roudix_config_core.py
#, python-brace-format
msgid ""
"Invalid JSON in the roudix-config block (line {line}, column {colno}): {msg}"
" — trailing comma before ] or }} ?"
msgstr ""
"JSON no válido en el bloque roudix-config (línea {line}, columna {colno}): "
"{msg} — ¿coma sobrante antes de ] o }} ?"

#: roudix_config_core.py
#, python-brace-format
msgid "module body not found in {name}"
msgstr "no se encontró el cuerpo del módulo en {name}"

#: roudix_config_core.py
#, python-brace-format
msgid "missing file: {example}"
msgstr "falta el archivo: {example}"

#: roudix_config_core.py
#, python-brace-format
msgid "{name} created from {name2}"
msgstr "{name} creado a partir de {name2}"

#: roudix_config_core.py
msgid "Removed the old umbriel-managed.nix import (obsolete)"
msgstr "Se quitó la antigua importación de umbriel-managed.nix (obsoleta)"

#: roudix_config_core.py
msgid ""
"NOTE: umbriel-custom.nix still mentions umbriel-managed.nix — remove it by "
"hand, that file is obsolete."
msgstr ""
"NOTA: umbriel-custom.nix aún menciona umbriel-managed.nix — quítalo a mano, "
"ese archivo está obsoleto."

#: roudix_config_core.py
#, python-brace-format
msgid "Rules and settings moved from {name} to {name2}"
msgstr "Reglas y ajustes movidos de {name} a {name2}"

#: roudix_config_core.py
msgid "(seen open before)"
msgstr "(vista abierta antes)"

#: roudix_config_core.py
msgid "(installed, app_id guessed)"
msgstr "(instalada, app_id supuesto)"

#: roudix_config_core.py
msgid "Floating"
msgstr "Flotante"

#: roudix_config_core.py
msgid "Maximized"
msgstr "Maximizada"

#: roudix_config_core.py
msgid "Fullscreen"
msgstr "Pantalla completa"

#: roudix_config_core.py
msgid "Off"
msgstr "Desactivado"

#: roudix_config_core.py
msgid "On"
msgstr "Activado"

#: roudix_config_core.py
msgid "app_id or title required"
msgstr "se requiere app_id o título"

#: roudix_config_core.py
msgid "opacity must be between 0 and 1"
msgstr "la opacidad debe estar entre 0 y 1"

#: roudix_config_core.py
msgid "choose at least one setting"
msgstr "elige al menos un ajuste"

#: roudix_config_core.py
#, python-brace-format
msgid ""
"Roudix Config isn't available on {t}: use its native settings (System "
"Settings)."
msgstr ""
"Roudix Config no está disponible en {t}: usa sus ajustes nativos "
"(Configuración del sistema)."

#: roudix_config_core.py
#, python-brace-format
msgid "Roudix Config doesn't support {t} yet (for now: {join})."
msgstr "Roudix Config aún no admite {t} (por ahora: {join})."

#: roudix_config_core.py
msgid ""
"Can't determine the desktop (roudix.desktop.type). Rebuild so that "
"~/.local/share/roudix/desktop-type gets created."
msgstr ""
"No se puede determinar el escritorio (roudix.desktop.type). Haz un rebuild "
"para que se cree ~/.local/share/roudix/desktop-type."

#: roudix_config_core.py
#, python-brace-format
msgid "unknown setting: {sid}"
msgstr "ajuste desconocido: {sid}"

#: roudix_config_core.py
msgid "`nh` not found: run the rebuild by hand (the `rebuild` alias)."
msgstr "No se encontró `nh`: ejecuta el rebuild a mano (el alias `rebuild`)."

#: roudix_config_core.py
msgid "Rebuild done ✔ — reload the compositor config if needed."
msgstr ""
"Rebuild terminado ✔ — recarga la configuración del compositor si hace falta."

#: roudix_config_core.py
msgid "Rebuild failed ✘ (code $rc) — read the messages above."
msgstr "Rebuild fallido ✘ (código $rc) — lee los mensajes de arriba."

#: roudix_config_core.py
msgid "Press Enter to close… "
msgstr "Pulsa Intro para cerrar… "

#: roudix_config_core.py
msgid "No terminal found: run the rebuild by hand (the `rebuild` alias)."
msgstr ""
"No se encontró ninguna terminal: ejecuta el rebuild a mano (el alias "
"`rebuild`)."

#: roudix_config_core.py
msgid "syntax not checked, nix-instantiate not found"
msgstr "sintaxis sin comprobar, no se encontró nix-instantiate"

#: roudix_config_core.py
msgid "valid Nix syntax"
msgstr "sintaxis de Nix válida"

#: roudix_config_core.py
msgid "syntax error"
msgstr "error de sintaxis"
