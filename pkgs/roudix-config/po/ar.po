#: roudix-config.py
#, python-brace-format
msgid ""
"a add · e change the action · r reset everything\n"
"{label}: moving or deleting a default shortcut is done in the File tab. ✎ = changed by you."
msgstr ""
"a إضافة · e تغيير الإجراء · r إعادة تعيين الكل\n"
"{label}: نقل اختصار افتراضي أو حذفه يتم من تبويب الملف. ✎ = غيّرتَه أنت."

#: roudix-config.py
msgid ""
"a add · e edit · d delete · r reset everything\n"
"Once changed, the table is frozen: new default shortcuts added to the repo won't reach you any more (r to go back)."
msgstr ""
"a إضافة · e تعديل · d حذف · r إعادة تعيين الكل\n"
"بعد التغيير يتجمّد الجدول: لن تصلك الاختصارات الافتراضية الجديدة المضافة إلى المستودع (r للعودة)."

#: roudix-config.py
msgid ""
"e edit · r restore this setting's default · F5 rebuild\n"
"✎ = changed by you; the others follow the repo's defaults."
msgstr ""
"e تعديل · r استعادة القيمة الافتراضية لهذا الإعداد · F5 rebuild\n"
"✎ = غيّرتَه أنت؛ والبقية تتبع قيم المستودع الافتراضية."

#: roudix-config.py
#, python-brace-format
