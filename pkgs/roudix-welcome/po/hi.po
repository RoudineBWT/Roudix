#: roudix-welcome.py
msgid "Software Store"
msgstr "सॉफ़्टवेयर स्टोर"

#: roudix-welcome.py
msgid "Install nixpkgs and Flatpak apps"
msgstr "nixpkgs और Flatpak ऐप इंस्टॉल करें"

#: roudix-welcome.py
msgid "Customizer"
msgstr "कस्टमाइज़र"

#: roudix-welcome.py
msgid "Desktop, shell, apps and system tweaks"
msgstr "डेस्कटॉप, शेल, ऐप और सिस्टम ट्वीक"

#: roudix-welcome.py
msgid "Kernel Switcher"
msgstr "कर्नेल स्विचर"

#: roudix-welcome.py
msgid "Pick your CachyOS kernel variant"
msgstr "अपना CachyOS कर्नेल वैरिएंट चुनें"

#: roudix-welcome.py
msgid "SCX Scheduler"
msgstr "SCX शेड्यूलर"

#: roudix-welcome.py
msgid "Choose and apply an SCX scheduler"
msgstr "SCX शेड्यूलर चुनें और लागू करें"

#: roudix-welcome.py
msgid "Disks"
msgstr "डिस्क"

#: roudix-welcome.py
msgid "Mount, format and manage your extra disks"
msgstr "अपनी अतिरिक्त डिस्क माउंट, फ़ॉर्मैट और प्रबंधित करें"

#: roudix-welcome.py
msgid "Firewall"
msgstr "फ़ायरवॉल"

#: roudix-welcome.py
msgid "Open ports and trusted interfaces"
msgstr "खुले पोर्ट और भरोसेमंद इंटरफ़ेस"

#: roudix-welcome.py
msgid "Hardware Sync"
msgstr "हार्डवेयर सिंक"

#: roudix-welcome.py
msgid "Changed PC? Update your CPU/GPU settings"
msgstr "पीसी बदला? अपनी CPU/GPU सेटिंग अपडेट करें"

#: roudix-welcome.py
msgid "Compositor Config"
msgstr "कंपोज़िटर कॉन्फ़िग"

#: roudix-welcome.py
msgid "Window rules, screens and shortcuts"
msgstr "विंडो नियम, स्क्रीन और शॉर्टकट"

#: roudix-welcome.py
msgid "Documentation"
msgstr "दस्तावेज़ीकरण"

#: roudix-welcome.py
msgid "Source code"
msgstr "सोर्स कोड"

#: roudix-welcome.py
msgid "Release notes"
msgstr "रिलीज़ नोट्स"

#: roudix-welcome.py
msgid "Report a bug"
msgstr "बग रिपोर्ट करें"

#: roudix-welcome.py
msgid "YouTube"
msgstr "YouTube"

#: roudix-welcome.py
msgid "Discord"
msgstr "Discord"

#: roudix-welcome.py
msgid "Check for updates"
msgstr "अपडेट जाँचें"

#: roudix-welcome.py
msgid "See if new commits are available (nothing is changed)"
msgstr "देखें कि नए कमिट उपलब्ध हैं या नहीं (कुछ भी नहीं बदला जाता)"

#: roudix-welcome.py
msgid "Update system"
msgstr "सिस्टम अपडेट करें"

#: roudix-welcome.py
msgid "Pull, rebuild, switch and update Flatpaks (same as `update`)"
msgstr "पुल, रीबिल्ड, स्विच और Flatpak अपडेट करें (`update` के समान)"

#: roudix-welcome.py
msgid ""
"Open a terminal and run the update? You will be asked for your password."
msgstr "टर्मिनल खोलकर अपडेट चलाएँ? आपसे पासवर्ड माँगा जाएगा।"

#: roudix-welcome.py
msgid "Apply configuration"
msgstr "कॉन्फ़िगरेशन लागू करें"

#: roudix-welcome.py
msgid "Rebuild and switch now (same as `rebuild`)"
msgstr "अभी रीबिल्ड और स्विच करें (`rebuild` के समान)"

#: roudix-welcome.py
msgid "Rebuild the system now? This can take a while."
msgstr "सिस्टम अभी रीबिल्ड करें? इसमें कुछ समय लग सकता है।"

#: roudix-welcome.py
msgid "Clean old generations"
msgstr "पुरानी जेनरेशन साफ़ करें"

#: roudix-welcome.py
msgid "Keep the last 3 generations, then garbage-collect (same as `cleanup`)"
msgstr "पिछली 3 जेनरेशन रखें, फिर गार्बेज-कलेक्ट करें (`cleanup` के समान)"

#: roudix-welcome.py
msgid ""
"Remove old system generations? You will not be able to roll back to them."
msgstr "पुरानी सिस्टम जेनरेशन हटाएँ? आप उन पर वापस नहीं लौट पाएँगे।"

#: roudix-welcome.py
msgid "Show last update log"
msgstr "पिछला अपडेट लॉग दिखाएँ"

#: roudix-welcome.py
msgid "Output of the last run of `update`"
msgstr "`update` के पिछले रन का आउटपुट"

#: roudix-welcome.py
msgid "Press Enter to close…"
msgstr "बंद करने के लिए Enter दबाएँ…"

#: roudix-welcome.py
msgid "Close"
msgstr "बंद करें"

#: roudix-welcome.py
msgid "Running…"
msgstr "चल रहा है…"

#: roudix-welcome.py
#, python-brace-format
msgid "ERROR: '{cmd}' not found in PATH."
msgstr "त्रुटि: PATH में '{cmd}' नहीं मिला।"

#: roudix-welcome.py
#, python-brace-format
msgid "ERROR: {error}"
msgstr "त्रुटि: {error}"

#: roudix-welcome.py
msgid "✓ Done"
msgstr "✓ हो गया"

#: roudix-welcome.py
#, python-brace-format
msgid "✗ Failed (exit code {rc})"
msgstr "✗ विफल (एग्ज़िट कोड {rc})"

#: roudix-welcome.py
msgid "Welcome to Roudix"
msgstr "Roudix में आपका स्वागत है"

#: roudix-welcome.py
msgid "Welcome"
msgstr "स्वागत"

#: roudix-welcome.py
msgid "Tweaks"
msgstr "ट्वीक्स"

#: roudix-welcome.py
msgid "Your NixOS, your way — shared with the people you care about."
msgstr ""
"आपका NixOS, आपके अंदाज़ में — उन लोगों के साथ साझा, जिनकी आपको परवाह है।"

#: roudix-welcome.py
msgid "System tools"
msgstr "सिस्टम टूल"

#: roudix-welcome.py
msgid "Resources"
msgstr "संसाधन"

#: roudix-welcome.py
msgid "Show at startup"
msgstr "स्टार्टअप पर दिखाएँ"

#: roudix-welcome.py
msgid "Show this window again on every login"
msgstr "हर लॉगिन पर यह विंडो फिर से दिखाएँ"

#: roudix-welcome.py
msgid "Maintenance"
msgstr "रखरखाव"

#: roudix-welcome.py
msgid "Common system tasks, one click away."
msgstr "सामान्य सिस्टम कार्य, बस एक क्लिक दूर।"

#: roudix-welcome.py
msgid "Run"
msgstr "चलाएँ"

#: roudix-welcome.py
msgid "Configuration"
msgstr "कॉन्फ़िगरेशन"

#: roudix-welcome.py
msgid "Open configuration folder"
msgstr "कॉन्फ़िगरेशन फ़ोल्डर खोलें"

#: roudix-welcome.py
msgid "Cancel"
msgstr "रद्द करें"

#: roudix-welcome.py
msgid "No terminal found"
msgstr "कोई टर्मिनल नहीं मिला"

#: roudix-welcome.py
msgid "Open a terminal yourself and run `update`."
msgstr "खुद टर्मिनल खोलें और `update` चलाएँ।"

