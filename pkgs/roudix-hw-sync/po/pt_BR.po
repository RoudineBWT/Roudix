msgid ""
msgstr ""
"Project-Id-Version: roudix-hw-sync\n"
"Report-Msgid-Bugs-To: \n"
"PO-Revision-Date: 2026-10-23 00:00+0000\n"
"Last-Translator: Claude\n"
"Language-Team: Brazilian Portuguese\n"
"Language: pt_BR\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

#: roudix-hw-sync-gui.py
msgid "AMD — modern (RDNA / GCN 3+, RX 400 and newer)"
msgstr "AMD — moderna (RDNA / GCN 3+, RX 400 e mais recentes)"

#: roudix-hw-sync-gui.py
msgid "AMD — integrated (Ryzen APU)"
msgstr "AMD — integrada (APU Ryzen)"

#: roudix-hw-sync-gui.py
msgid "AMD — legacy (GCN 1.x / 2.x, HD 7xxx, R9 2xx)"
msgstr "AMD — antiga (GCN 1.x / 2.x, HD 7xxx, R9 2xx)"

#: roudix-hw-sync-gui.py
msgid "Intel (integrated or Arc)"
msgstr "Intel (integrada ou Arc)"

#: roudix-hw-sync-gui.py
msgid "Detection failed."
msgstr "A detecção falhou."

#: roudix-hw-sync-gui.py
msgid ""
"New PC, new graphics card or new processor? Roudix looks at your hardware "
"and updates your configuration to match. Nothing is changed until you press "
"a button below."
msgstr ""
"PC novo, placa de vídeo nova ou processador novo? O Roudix analisa seu "
"hardware e atualiza sua configuração de acordo. Nada é alterado até você "
"pressionar um dos botões abaixo."

#: roudix-hw-sync-gui.py
msgid "Your hardware"
msgstr "Seu hardware"

#: roudix-hw-sync-gui.py
msgid "Processor (CPU)"
msgstr "Processador (CPU)"

#: roudix-hw-sync-gui.py
msgid "Graphics card (GPU)"
msgstr "Placa de vídeo (GPU)"

#: roudix-hw-sync-gui.py
msgid "Laptop with an NVIDIA graphics card"
msgstr "Notebook com placa de vídeo NVIDIA"

#: roudix-hw-sync-gui.py
msgid "Hybrid graphics (Optimus): Intel/AMD chip + NVIDIA card"
msgstr "Gráficos híbridos (Optimus): chip Intel/AMD + placa NVIDIA"

#: roudix-hw-sync-gui.py
msgid "Checking…"
msgstr "Verificando…"

#: roudix-hw-sync-gui.py
msgid "Preview of the changes"
msgstr "Pré-visualização das alterações"

#: roudix-hw-sync-gui.py
msgid "Re-detect"
msgstr "Detectar novamente"

#: roudix-hw-sync-gui.py
msgid "Apply"
msgstr "Aplicar"

#: roudix-hw-sync-gui.py
msgid "Only update local.nix, no rebuild"
msgstr "Apenas atualiza o local.nix, sem reconstruir"

#: roudix-hw-sync-gui.py
msgid "Apply & Rebuild"
msgstr "Aplicar e reconstruir"

#: roudix-hw-sync-gui.py
msgid "Could not detect your hardware"
msgstr "Não foi possível detectar seu hardware"

#: roudix-hw-sync-gui.py
msgid "Something went wrong"
msgstr "Algo deu errado"

#: roudix-hw-sync-gui.py
msgid "Your configuration already matches this hardware"
msgstr "Sua configuração já corresponde a este hardware"

#: roudix-hw-sync-gui.py
#, python-format
msgid "%d line will be updated in local.nix"
msgid_plural "%d lines will be updated in local.nix"
msgstr[0] "%d linha será atualizada no local.nix"
msgstr[1] "%d linhas serão atualizadas no local.nix"

#: roudix-hw-sync-gui.py
msgid "Apply changes?"
msgstr "Aplicar as alterações?"

#: roudix-hw-sync-gui.py
#, python-brace-format
msgid "CPU: <b>{cpu}</b>"
msgstr "CPU: <b>{cpu}</b>"

#: roudix-hw-sync-gui.py
#, python-brace-format
msgid "GPU: <b>{gpu}</b>"
msgstr "GPU: <b>{gpu}</b>"

#: roudix-hw-sync-gui.py
msgid "no"
msgstr "não"

#: roudix-hw-sync-gui.py
msgid "yes"
msgstr "sim"

#: roudix-hw-sync-gui.py
#, python-brace-format
msgid "Hybrid laptop: <b>{answer}</b>"
msgstr "Notebook híbrido: <b>{answer}</b>"

#: roudix-hw-sync-gui.py
msgid "A backup of your settings is kept as <tt>local.nix.bak</tt>."
msgstr ""
"Uma cópia de segurança das suas configurações é mantida como "
"<tt>local.nix.bak</tt>."

#: roudix-hw-sync-gui.py
msgid "Your system will then be rebuilt, this can take a few minutes."
msgstr ""
"Em seguida, seu sistema será reconstruído; isso pode levar alguns minutos."

#: roudix-hw-sync-gui.py
msgid "Cancel"
msgstr "Cancelar"

#: roudix-hw-sync-gui.py
msgid "✗ Could not write local.nix"
msgstr "✗ Não foi possível gravar o local.nix"

#: roudix-hw-sync-gui.py
msgid "✓ local.nix updated — rebuild to apply"
msgstr "✓ local.nix atualizado — reconstrua para aplicar"

#: roudix-hw-sync-gui.py
msgid "Backup saved as local.nix.bak"
msgstr "Cópia de segurança salva como local.nix.bak"

#: roudix-hw-sync-gui.py
msgid "Rebuilding…"
msgstr "Reconstruindo…"

#: roudix-hw-sync-gui.py
#, python-brace-format
msgid "Running: {cmd}"
msgstr "Executando: {cmd}"

#: roudix-hw-sync-gui.py
msgid "ERROR: 'nh' not found in PATH."
msgstr "ERRO: 'nh' não encontrado no PATH."

#: roudix-hw-sync-gui.py
#, python-brace-format
msgid "ERROR: {error}"
msgstr "ERRO: {error}"

#: roudix-hw-sync-gui.py
msgid "✓ Done — reboot to use your new hardware settings"
msgstr "✓ Pronto — reinicie para usar suas novas configurações de hardware"

#: roudix-hw-sync-gui.py
msgid "✓ Rebuild completed. Reboot to apply the changes."
msgstr "✓ Reconstrução concluída. Reinicie para aplicar as alterações."

#: roudix-hw-sync-gui.py
#, python-brace-format
msgid "✗ Rebuild failed (exit {rc})"
msgstr "✗ A reconstrução falhou (código {rc})"

#: roudix-hw-sync-gui.py
msgid "See the log below. Your local.nix was already updated."
msgstr "Veja o registro abaixo. Seu local.nix já foi atualizado."

#: roudix-hw-sync-gui.py
#, python-brace-format
msgid "✗ Rebuild failed (exit code {rc})."
msgstr "✗ A reconstrução falhou (código de saída {rc})."

#: roudix-hw-sync
#, sh-printf-format
msgid "Unknown option: %s"
msgstr "Opção desconhecida: %s"

#: roudix-hw-sync
#, sh-printf-format
msgid "Invalid --gpu: %s"
msgstr "Valor de --gpu inválido: %s"

#: roudix-hw-sync
#, sh-printf-format
msgid "Invalid --cpu: %s"
msgstr "Valor de --cpu inválido: %s"

#: roudix-hw-sync
#, sh-printf-format
msgid "Invalid --laptop: %s"
msgstr "Valor de --laptop inválido: %s"

#: roudix-hw-sync
#, sh-printf-format
msgid "local.nix not found: %s"
msgstr "local.nix não encontrado: %s"

#: roudix-hw-sync
msgid "CPU vendor not detected, use --cpu amd|intel"
msgstr "Fabricante da CPU não detectado, use --cpu amd|intel"

#: roudix-hw-sync
msgid "GPU not detected, use --gpu ..."
msgstr "GPU não detectada, use --gpu ..."

#: roudix-hw-sync
#, sh-printf-format
msgid "Detected: CPU=%s  GPU=%s  nvidiaLaptop=%s"
msgstr "Detectado: CPU=%s  GPU=%s  nvidiaLaptop=%s"

#: roudix-hw-sync
msgid ""
"warning: no hardware.myKernelChaotic line in local.nix (nvidia uses it), "
"module default applies"
msgstr ""
"aviso: não há linha hardware.myKernelChaotic no local.nix (nvidia a usa), o "
"padrão do módulo será aplicado"

#: roudix-hw-sync
msgid "Nothing to change."
msgstr "Nada a alterar."

#: roudix-hw-sync
msgid "(dry-run: file left untouched)"
msgstr "(simulação: arquivo não modificado)"

#: roudix-hw-sync
#, sh-printf-format
msgid "Done. Backup: %s"
msgstr "Pronto. Backup: %s"

#: roudix-hw-sync
#, sh-format
msgid ""
"Now rebuild: rebuild   (or: nh os boot --accept-flake-config path:$NH_FLAKE)"
msgstr ""
"Agora reconstrua: rebuild   (ou: nh os boot --accept-flake-config path:"
"$NH_FLAKE)"
