msgstr "Português"

msgid "Create the sbctl keys at install time if missing (enrolling them stays manual)"
msgstr "Criar as chaves do sbctl na instalação, se faltarem (registrá-las continua manual)"

msgid "List “NixOS EAC” in the firmware boot menu (otherwise: sudo eac-reboot)"
msgstr "Listar “NixOS EAC” no menu de boot do firmware (caso contrário: sudo eac-reboot)"

msgid "Open kernel modules (RTX 20xx and newer — turn off for GTX 10xx/16xx)"
msgstr "Módulos de kernel abertos (RTX 20xx e mais recentes — desative para GTX 10xx/16xx)"

msgid "Boot splash (Plymouth) — off = plain text boot"
msgstr "Tela de boot (Plymouth) — desativada = boot em texto simples"

msgid "Hide kernel / initrd messages during boot (turn off to debug a boot problem)"
msgstr "Ocultar as mensagens do kernel / initrd durante o boot (desative para depurar um problema de boot)"

msgid "Best battery life (default) — disables tuned, so game-performance does nothing"
msgstr "Maior autonomia (padrão) — desativa o tuned, então o game-performance não faz nada"

msgid "Gaming laptop: keeps game-performance and the desktop power-mode selector"
msgstr "Notebook gamer: mantém o game-performance e o seletor de modo de energia da área de trabalho"

msgid "Printing (CUPS + network printers)"
msgstr "Impressão (CUPS + impressoras de rede)"

msgid "Scanners (SANE: network + HP)"
msgstr "Scanners (SANE: rede + HP)"

msgid "Monthly btrfs scrub"
msgstr "Scrub mensal do btrfs"

msgid "Kernel CVE mitigations (module blacklists)"
msgstr "Mitigações de CVE do kernel (listas de bloqueio de módulos)"

msgid "  ↳ Blacklist algif_aead (“Copy Fail”)"
msgstr "  ↳ Bloquear o algif_aead (“Copy Fail”)"

msgid "  ↳ Blacklist esp4/esp6/rxrpc (“Dirty Frag”) — turn off ONLY with IPsec or AFS/Kerberos"
msgstr "  ↳ Bloquear esp4/esp6/rxrpc (“Dirty Frag”) — desative SOMENTE com IPsec ou AFS/Kerberos"

msgid "Hibernation (needs swap, off by default)"
msgstr "Hibernação (requer swap, desativada por padrão)"

msgid "Office dictionaries"
msgstr "Dicionários da suíte de escritório"

msgid "Laptop power backend"
msgstr "Back-end de energia do notebook"
