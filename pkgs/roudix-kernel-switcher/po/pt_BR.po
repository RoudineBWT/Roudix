#: roudix-kernel-switcher.py
msgid "Steam Deck optimised"
msgstr "Otimizado para Steam Deck"

#: roudix-kernel-switcher.py
msgid "Server optimised"
msgstr "Otimizado para servidores"

#: roudix-kernel-switcher.py
msgid "Server + LTO"
msgstr "Servidor + LTO"

#: roudix-kernel-switcher.py
msgid "Release candidate  —  unstable"
msgstr "Release candidate  —  instável"

#: roudix-kernel-switcher.py
msgid "linux-zen — nvidia module cached only with the open driver; closed driver compiles locally on every bump"
msgstr "linux-zen — módulo nvidia em cache apenas com o driver aberto; o driver proprietário é compilado localmente a cada atualização"

#: roudix-kernel-switcher.py
msgid "linux LTS — same nvidia module caveat as zen"
msgstr "linux LTS — mesma ressalva do módulo nvidia que o zen"

#: roudix-kernel-switcher.py
msgid "linux latest — same nvidia module caveat as zen"
msgstr "linux latest — mesma ressalva do módulo nvidia que o zen"

#: roudix-kernel-switcher.py
msgid "linux_testing — mainline RC/testing kernel, same nvidia module caveat as zen"
msgstr "linux_testing — kernel mainline RC/de teste, mesma ressalva do módulo nvidia que o zen"

#: roudix-kernel-switcher.py
msgid "XanMod LTS — same nvidia module caveat as zen"
msgstr "XanMod LTS — mesma ressalva do módulo nvidia que o zen"

#: roudix-kernel-switcher.py
msgid "XanMod main branch — same nvidia module caveat as zen"
msgstr "Ramo principal do XanMod — mesma ressalva do módulo nvidia que o zen"

#: roudix-kernel-switcher.py
msgid "Default  —  LTO + BORE, ships nvidia_cachyos"
msgstr "Padrão  —  LTO + BORE, inclui nvidia_cachyos"

#: roudix-kernel-switcher.py
msgid "Server optimised  —  no desktop tuning"
msgstr "Otimizado para servidores  —  sem ajustes para desktop"

#. TRANSLATORS: Heading above a list of kernels ("latest kernels").
#: roudix-kernel-switcher.py
msgid "Latest"
msgstr "Mais recentes"

#. TRANSLATORS: Heading above a list of kernel variants.
#: roudix-kernel-switcher.py
msgid "Variants"
msgstr "Variantes"

#: roudix-kernel-switcher.py
msgid "Chaotic-Nyx (GPU: nvidia)"
msgstr "Chaotic-Nyx (GPU: nvidia)"

#: roudix-kernel-switcher.py
#, python-brace-format
msgid "Kernel source: {source}"
msgstr "Origem do kernel: {source}"

#: roudix-kernel-switcher.py
msgid "Nvidia GPU detected — only Chaotic-Nyx variants are shown, so nvidia_cachyos (precompiled driver) stays matched to your kernel."
msgstr "GPU Nvidia detectada — apenas as variantes do Chaotic-Nyx são exibidas, para que o nvidia_cachyos (driver pré-compilado) continue compatível com seu kernel."

#: roudix-kernel-switcher.py
msgid "Active kernel"
msgstr "Kernel ativo"

#: roudix-kernel-switcher.py
msgid "Select a kernel variant above."
msgstr "Escolha uma variante do kernel acima."

#: roudix-kernel-switcher.py
msgid "Apply & Rebuild"
msgstr "Aplicar e reconstruir"

#: roudix-kernel-switcher.py
#, python-brace-format
msgid "Will switch to: {variant}"
msgstr "Vai mudar para: {variant}"

#: roudix-kernel-switcher.py
msgid "Already the active kernel."
msgstr "Já é o kernel ativo."

#: roudix-kernel-switcher.py
msgid "Apply changes?"
msgstr "Aplicar as alterações?"

#. TRANSLATORS: Pango markup: keep the <b> tags and the {placeholders}.
#: roudix-kernel-switcher.py
#, python-brace-format
msgid "Kernel: <b>{current}</b> → <b>{selected}</b>"
msgstr "Kernel: <b>{current}</b> → <b>{selected}</b>"

#: roudix-kernel-switcher.py
msgid "Your NixOS configuration will be rebuilt. This may take a few minutes."
msgstr "Sua configuração do NixOS será reconstruída. Isso pode levar alguns minutos."

#: roudix-kernel-switcher.py
msgid "Cancel"
msgstr "Cancelar"

#: roudix-kernel-switcher.py
#, python-brace-format
msgid "✗ Error writing config: {error}"
msgstr "✗ Erro ao gravar a configuração: {error}"

#: roudix-kernel-switcher.py
msgid "Building…"
msgstr "Construindo…"

#: roudix-kernel-switcher.py
msgid "Important Notices:"
msgstr "Avisos importantes:"

#: roudix-kernel-switcher.py
msgid "No issues currently reported."
msgstr "Nenhum problema relatado no momento."

#: roudix-kernel-switcher.py
#, python-brace-format
msgid "Running: {cmd}"
msgstr "Executando: {cmd}"

#: roudix-kernel-switcher.py
msgid "Checking repositories..."
msgstr "Verificando repositórios..."

#: roudix-kernel-switcher.py
msgid "ERROR: 'nh' not found in PATH."
msgstr "ERRO: 'nh' não encontrado no PATH."

#: roudix-kernel-switcher.py
#, python-brace-format
msgid "ERROR: {error}"
msgstr "ERRO: {error}"

#: roudix-kernel-switcher.py
#, python-brace-format
msgid "✓ Done — reboot to apply {kernel}."
msgstr "✓ Pronto — reinicie para aplicar {kernel}."

